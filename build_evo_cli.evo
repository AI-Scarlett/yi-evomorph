@evolang "3.0"

@xiangci {
    "CLI 构建脚本 — 将 evo_cli.evo 编译为命令行工具"
}

@locus build_evo_cli.assemble_cli {
    mut_rate   = 0.005
    cross_pool = "bootstrap"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x"]

    卦序: {
        ䷁ RECV R0, 255
        ䷂ ALLOC R0, 0x4000
        ䷾ SYNC
        ䷋ HALT
    }
}
