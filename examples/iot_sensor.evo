@evolang "3.0"

@xiangci {
    "物联网传感器数据采集与边缘计算，低功耗优先，适配鸿蒙与安卓"
}

@locus iot_sensor {
    mut_rate   = 0.03
    cross_pool = "iot"
    fitness    = min_energy + min_size + 0.5*min_latency
    env_target = ["harmony-5", "android-14"]
    max_generations = 150

    卦序: {
        ䷁ RECV R0, 0x0300
        ䷂ ALLOC R1, 0x40
        ䷐ FOLLOWING R2, R0
        ䷬ GATHER R3, R2
        ䷽ MICRO R4, R3
        ䷍ ABUNDANCE R5, R4
        ䷹ JOY R6, R5
        ䷝ ILLUMINATE R6
        ䷎ YIELD
        ䷾ SYNC
        ䷗ RETURN R6
    }
}
