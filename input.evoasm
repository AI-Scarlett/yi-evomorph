; Simple test program: print message and exit
SYS_PRINT EQU 40
SYS_EXIT EQU 255

START:
    ; Alloc buffer and write "Hello World!\n"
    ALLOC R0, 0
    FELLOWSHIP R4, R0
    FELLOWSHIP R5, R0

    ABOUND R1, 72      ; H
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2

    ABOUND R1, 101     ; e
    DISPERSE R5, R1
    INCREASE R5, R2

    ABOUND R1, 108     ; l
    DISPERSE R5, R1
    INCREASE R5, R2
    DISPERSE R5, R1
    INCREASE R5, R2

    ABOUND R1, 111     ; o
    DISPERSE R5, R1
    INCREASE R5, R2

    ABOUND R1, 32      ; space
    DISPERSE R5, R1
    INCREASE R5, R2

    ABOUND R1, 87      ; W
    DISPERSE R5, R1
    INCREASE R5, R2

    ABOUND R1, 111     ; o
    DISPERSE R5, R1
    INCREASE R5, R2

    ABOUND R1, 114     ; r
    DISPERSE R5, R1
    INCREASE R5, R2

    ABOUND R1, 108     ; l
    DISPERSE R5, R1
    INCREASE R5, R2

    ABOUND R1, 100     ; d
    DISPERSE R5, R1
    INCREASE R5, R2

    ABOUND R1, 33      ; !
    DISPERSE R5, R1
    INCREASE R5, R2

    ABOUND R1, 10      ; \n
    DISPERSE R5, R1

    ; Print
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R4
    RECV R0, 0

    ; Exit
    ABOUND R0, SYS_EXIT
    RECV R0, 0

HALT
