@evolang "3.0"

@xiangci {
    "DAP 适配器实现 — IChingVM 调试桥接, 支持 StackFrame/Scope/Variable 数据模型"
}

@locus dap.initialize {
    mut_rate   = 0.005
    cross_pool = "tools"
    fitness    = min_latency
    env_target = ["linux-6.x"]

    卦序: {
        ䷁ RECV R0, 64
        ䷾ SYNC
        ䷋ HALT
    }
}

@locus dap.set_breakpoint {
    mut_rate   = 0.01
    cross_pool = "tools"
    fitness    = min_latency
    env_target = ["linux-6.x"]

    卦序: {
        ䷁ RECV R0, 32
        ䷆ BRANCH R0, R1
        ䷾ SYNC
        ䷋ HALT
    }
}

@locus dap.step {
    mut_rate   = 0.01
    cross_pool = "tools"
    fitness    = max_throughput
    env_target = ["linux-6.x"]

    卦序: {
        ䷁ RECV R0, 8
        ䷀ CREA R0, R1
        ䷾ SYNC
        ䷋ HALT
    }
}

@locus dap.get_variables {
    mut_rate   = 0.01
    cross_pool = "tools"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x"]

    卦序: {
        ䷁ RECV R0, 64
        ䷓ CONTEMPLATE R0
        ䷾ SYNC
        ䷋ HALT
    }
}
