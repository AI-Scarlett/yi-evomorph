{
    "并行程序": {
        "prefix": "evomorph-parallel",
        "body": [
            "@evolang \"3.0\"",
            "",
            "@xiangci {",
            "\t\"${1:并行计算，适配多平台}\"",
            "}",
            "",
            "@locus ${2:parallel_task} {",
            "\tmut_rate   = ${3:0.02}",
            "\tcross_pool = \"${4:compute}\"",
            "\tfitness    = min_latency + 2.0*max_throughput - 0.5*min_energy",
            "\tenv_target = [${5:\"linux-6.x\"}]",
            "\tmax_generations = ${6:100}",
            "",
            "\t卦序: {",
            "\t\t䷁ RECV R0, ${7:0x0100}",
            "\t\t䷂ ALLOC R1, R0",
            "\t\t䷀ CREA R2, R3",
            "\t\t䷌ FELLOWSHIP R2, R3",
            "\t\t䷬ GATHER R4, R2",
            "\t\t䷍ ABUNDANCE R5, R4",
            "\t\t䷝ ILLUMINATE R5",
            "\t\t䷾ SYNC",
            "\t\t䷗ RETURN R5",
            "\t}",
            "}"
        ],
        "description": "并行计算程序模板"
    },
    "IO程序": {
        "prefix": "evomorph-io",
        "body": [
            "@evolang \"3.0\"",
            "",
            "@xiangci {",
            "\t\"${1:IO密集型数据处理}\"",
            "}",
            "",
            "@locus ${2:io_task} {",
            "\tmut_rate   = ${3:0.01}",
            "\tcross_pool = \"${4:io}\"",
            "\tfitness    = min_latency + min_energy",
            "\tenv_target = [${5:\"linux-6.x\"}]",
            "\tmax_generations = ${6:100}",
            "",
            "\t卦序: {",
            "\t\t䷁ RECV R0, ${7:0x0200}",
            "\t\t䷂ ALLOC R1, R0",
            "\t\t䷐ FOLLOWING R2, R0",
            "\t\t䷍ ABUNDANCE R3, R2",
            "\t\t䷝ ILLUMINATE R3",
            "\t\t䷾ SYNC",
            "\t\t䷗ RETURN R3",
            "\t}",
            "}"
        ],
        "description": "IO密集型程序模板"
    },
    "AI推理": {
        "prefix": "evomorph-ai",
        "body": [
            "@evolang \"3.0\"",
            "",
            "@xiangci {",
            "\t\"${1:AI推理服务，适配服务器与移动端}\"",
            "}",
            "",
            "@locus ${2:ai_inference} {",
            "\tmut_rate   = 0.01",
            "\tcross_pool = \"ai\"",
            "\tfitness    = max_throughput + min_size",
            "\tenv_target = [\"linux-6.x\", \"android-14\", \"ios-18\"]",
            "\tmax_generations = 200",
            "",
            "\t卦序: {",
            "\t\t䷁ RECV R0, 0x0200",
            "\t\t䷂ ALLOC R1, R0",
            "\t\t䷃ SPRT R2, 0x01",
            "\t\t䷀ CREA R3, R4",
            "\t\t䷌ FELLOWSHIP R3, R4",
            "\t\t䷏ SPECULATE R5, R0",
            "\t\t䷱ CAST R6, R5",
            "\t\t䷍ ABUNDANCE R7, R6",
            "\t\t䷝ ILLUMINATE R7",
            "\t\t䷾ SYNC",
            "\t\t䷗ RETURN R7",
            "\t}",
            "}",
            "",
            "@meta_locus ${2:ai_inference}_optimizer {",
            "\tmut_rate = 0.005",
            "\tfitness  = min_size + max_throughput",
            "",
            "\t卦序: {",
            "\t\t䷓ CONTEMPLATE R0",
            "\t\t䷑ MUT R0, 0x03",
            "\t\t䷫ MATE R0, R1",
            "\t\t䷾ SYNC",
            "\t}",
            "}"
        ],
        "description": "AI推理服务模板（含元基因座）"
    },
    "IoT低功耗": {
        "prefix": "evomorph-iot",
        "body": [
            "@evolang \"3.0\"",
            "",
            "@xiangci {",
            "\t\"${1:IoT传感器数据采集，低功耗优先}\"",
            "}",
            "",
            "@locus ${2:iot_sensor} {",
            "\tmut_rate   = 0.03",
            "\tcross_pool = \"iot\"",
            "\tfitness    = min_energy + min_size + 0.5*min_latency",
            "\tenv_target = [\"harmony-5\", \"android-14\"]",
            "\tmax_generations = 150",
            "",
            "\t卦序: {",
            "\t\t䷁ RECV R0, 0x0300",
            "\t\t䷂ ALLOC R1, 0x40",
            "\t\t䷐ FOLLOWING R2, R0",
            "\t\t䷬ GATHER R3, R2",
            "\t\t䷽ MICRO R4, R3",
            "\t\t䷍ ABUNDANCE R5, R4",
            "\t\t䷹ JOY R6, R5",
            "\t\t䷝ ILLUMINATE R6",
            "\t\t䷎ YIELD",
            "\t\t䷾ SYNC",
            "\t\t䷗ RETURN R6",
            "\t}",
            "}"
        ],
        "description": "IoT低功耗程序模板"
    },
    "基因座": {
        "prefix": "evomorph-locus",
        "body": [
            "@locus ${1:name} {",
            "\tmut_rate   = ${2:0.02}",
            "\tcross_pool = \"${3:default}\"",
            "\tfitness    = ${4:min_latency + 2.0*max_throughput}",
            "\tenv_target = [${5:\"linux-6.x\"}]",
            "\tmax_generations = ${6:100}",
            "",
            "\t卦序: {",
            "\t\t$0",
            "\t}",
            "}"
        ],
        "description": "基因座模板"
    },
    "元基因座": {
        "prefix": "evomorph-meta",
        "body": [
            "@meta_locus ${1:name} {",
            "\tmut_rate = ${2:0.01}",
            "\tfitness  = ${3:min_size + max_throughput}",
            "",
            "\t卦序: {",
            "\t\t$0",
            "\t}",
            "}"
        ],
        "description": "元基因座模板"
    },
    "象辞": {
        "prefix": "evomorph-xiangci",
        "body": [
            "@xiangci {",
            "\t\"${1:描述程序意图}\"",
            "}"
        ],
        "description": "象辞块模板"
    }
}
