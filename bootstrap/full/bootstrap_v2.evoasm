; ============================================================
; 易衍·Evomorph 自举编译器 - 版本 2
; 使用 ALLOC 动态分配内存，避免 8 位地址限制
; ============================================================

; ========== 常量定义 ==========
SYS_OPEN    EQU 0
SYS_READ    EQU 1
SYS_WRITE   EQU 2
SYS_CLOSE   EQU 3
SYS_EXIT    EQU 255
SYS_PRINT   EQU 40
SYS_MALLOC  EQU 10

MODE_READ   EQU 0
MODE_WRITE  EQU 1

; ========== 寄存器使用约定 ==========
; R0  = 临时 / 系统调用参数
; R1  = 临时 / 系统调用参数
; R2  = 临时 / 系统调用参数
; R3  = 移位量寄存器
; R4  = 输入文件名指针
; R5  = 输出文件名指针
; R6  = 输入缓冲区指针
; R7  = 输出缓冲区指针
; R8  = 输入文件描述符
; R9  = 输出文件描述符
; R10 = 读取的字节数
; R11 = 成功消息指针
; R12 = 循环计数器
; R13 = 临时值
; R14 = 临时值
; R15 = 链接寄存器

; ========== 宏定义：构建立即数 ==========
; 注意：立即数 < 16 会被当作寄存器！
; 使用这些宏来安全地加载立即数

%macro LOAD_IMM8 2
    ; 加载 8 位立即数到寄存器
    ; 如果立即数 < 16，需要特殊处理
    ABOUND R13, 16           ; R13 = 16 (作为临时基址)
    ABOUND R14, %2            ; R14 = 立即数 (如果 >= 16)
    ; 检查立即数是否 < 16
    ; 简化：假设 %2 >= 16
    ABOUND %1, %2
%endmacro

%macro LOAD_IMM32 2
    ; 构建 32 位立即数
    ; 分 4 个字节构建
    ; 先加载高字节，然后移位，再 OR 低字节
    
    ; 字节 3 (最高)
    ABOUND %1, ((%2 >> 24) & 0xFF)
    ABOUND R3, 8
    SHL %1, R3
    
    ; 字节 2
    ABOUND R13, ((%2 >> 16) & 0xFF)
    OR %1, R13
    ABOUND R3, 8
    SHL %1, R3
    
    ; 字节 1
    ABOUND R13, ((%2 >> 8) & 0xFF)
    OR %1, R13
    ABOUND R3, 8
    SHL %1, R3
    
    ; 字节 0 (最低)
    ABOUND R13, (%2 & 0xFF)
    OR %1, R13
%endmacro

; ========== 宏：将字符串存储到内存 ==========
%macro STORE_STRING 2
    ; %1 = 目标地址
    ; %2 = 字符串 (用字符序列表示)
    ; 简化版本：在实际运行时需要初始化
    ; 这里我们使用 ALLOC 分配后，在运行时用指令填充
%endmacro

; ========== 程序入口 ==========
; 首先，我们需要分配内存来存储数据

; 分配输入缓冲区 (4KB)
ALLOC R6, 64              ; R6 = 分配 64*16=1024 字节？
                          ; 实际上 ALLOC 的 size 参数是字节数

; 等等，让我检查 ALLOC 的实际行为...
; op_alloc: size = operands[1] > 0 ? operands[1] : 256
; 所以 ALLOC R6, 0 会分配 256 字节
; ALLOC R6, N 会分配 N 字节 (N 最大 255)

; 让我简化这个程序，先做一个最小可行的版本
; 目标：
; 1. 分配内存
; 2. 打开文件
; 3. 读取文件
; 4. 简单处理
; 5. 写入文件
; 6. 退出

; 但是有个问题：文件名也是字符串，需要存储在内存中
; 让我用另一种方法：使用程序计数器相对寻址
; 或者... 让我先检查一个更简单的问题

; 实际上，让我重新思考：
; 当前的问题是 8 位操作数限制
; 但系统调用的参数通过寄存器传递
; 所以如果我能把地址放到寄存器里，就没问题了

; 关键发现：ALLOC 返回的地址直接存入寄存器！
; 所以：
; ALLOC R6, 0  → R6 = 堆地址 (完整 32 位)

; 但是文件名怎么办？
; 我需要把 "input.asm" 这样的字符串放到内存里
; 然后让 R4 指向它

; 让我用一个巧妙的方法：
; 1. 先用 ALLOC 分配一块内存
; 2. 然后用一系列 ABOUND + DISPERSE 指令把字符放进去

; 让我试试看...
; 首先，分配 256 字节给文件名
ALLOC R4, 0               ; R4 = 分配 256 字节

; 现在 R4 指向一块内存
; 让我把 "input.asm" 放进去
; 'i' = 105, 'n' = 110, 'p' = 112, 'u' = 117, 't' = 116
; '.' = 46, 'a' = 97, 's' = 115, 'm' = 109, 0 = 0

; 注意：ABOUND R1, 105 是可以的，因为 105 >= 16
ABOUND R1, 105            ; 'i'
DISPERSE R4, R1
INCREASE R4, 1

ABOUND R1, 110            ; 'n'
DISPERSE R4, R1
INCREASE R4, 1

ABOUND R1, 112            ; 'p'
DISPERSE R4, R1
INCREASE R4, 1

ABOUND R1, 117            ; 'u'
DISPERSE R4, R1
INCREASE R4, 1

ABOUND R1, 116            ; 't'
DISPERSE R4, R1
INCREASE R4, 1

ABOUND R1, 46             ; '.'
DISPERSE R4, R1
INCREASE R4, 1

ABOUND R1, 97             ; 'a'
DISPERSE R4, R1
INCREASE R4, 1

ABOUND R1, 115            ; 's'
DISPERSE R4, R1
INCREASE R4, 1

ABOUND R1, 109            ; 'm'
DISPERSE R4, R1
INCREASE R4, 1

ABOUND R1, 0              ; null terminator
DISPERSE R4, R1

; 但是... 我刚才修改了 R4！
; R4 现在指向字符串末尾，而不是开头
; 我需要保存原始地址

; 让我重新来... 这次用 R14 保存原始地址
ALLOC R14, 0              ; R14 = 分配 256 字节
ABOUND R4, R14            ; R4 = R14 (字符串开始)

; 现在填充字符串
ABOUND R1, 105            ; 'i'
DISPERSE R4, R1
INCREASE R4, 1

ABOUND R1, 110            ; 'n'
DISPERSE R4, R1
INCREASE R4, 1

ABOUND R1, 112            ; 'p'
DISPERSE R4, R1
INCREASE R4, 1

ABOUND R1, 117            ; 'u'
DISPERSE R4, R1
INCREASE R4, 1

ABOUND R1, 116            ; 't'
DISPERSE R4, R1
INCREASE R4, 1

ABOUND R1, 46             ; '.'
DISPERSE R4, R1
INCREASE R4, 1

ABOUND R1, 97             ; 'a'
DISPERSE R4, R1
INCREASE R4, 1

ABOUND R1, 115            ; 's'
DISPERSE R4, R1
INCREASE R4, 1

ABOUND R1, 109            ; 'm'
DISPERSE R4, R1
INCREASE R4, 1

ABOUND R1, 0              ; null terminator
DISPERSE R4, R1

; 现在 R14 指向 "input.asm"
ABOUND R4, R14            ; 恢复 R4 为文件名开头

; 同样地，准备输出文件名 "output.raw"
ALLOC R14, 0              ; 再分配 256 字节
ABOUND R5, R14            ; R5 = 输出文件名

ABOUND R1, 111            ; 'o'
DISPERSE R5, R1
INCREASE R5, 1

ABOUND R1, 117            ; 'u'
DISPERSE R5, R1
INCREASE R5, 1

ABOUND R1, 116            ; 't'
DISPERSE R5, R1
INCREASE R5, 1

ABOUND R1, 112            ; 'p'
DISPERSE R5, R1
INCREASE R5, 1

ABOUND R1, 117            ; 'u'
DISPERSE R5, R1
INCREASE R5, 1

ABOUND R1, 116            ; 't'
DISPERSE R5, R1
INCREASE R5, 1

ABOUND R1, 46             ; '.'
DISPERSE R5, R1
INCREASE R5, 1

ABOUND R1, 114            ; 'r'
DISPERSE R5, R1
INCREASE R5, 1

ABOUND R1, 97             ; 'a'
DISPERSE R5, R1
INCREASE R5, 1

ABOUND R1, 119            ; 'w'
DISPERSE R5, R1
INCREASE R5, 1

ABOUND R1, 0              ; null terminator
DISPERSE R5, R1

; 恢复 R5 为文件名开头
ALLOC R14, 0              ; 重新分配来获取原始地址？
; 不，这会分配新内存
; 让我用另一种方式：在填充前保存

; 实际上，让我简化这个程序
; 与其写这么复杂的代码，不如：
; 1. 创建一个简化的测试程序
; 2. 验证基本功能
; 3. 然后逐步完善

; 让我写一个最小的可行程序：
; 目标：分配内存，打开文件，读取，写入，退出

; 但首先，让我检查是否有更简单的方法
; 也许我可以在虚拟机中添加一个特殊的启动机制？
; 或者... 让我先专注于验证基本指令

; 让我写一个简单的程序来测试：
; 1. ALLOC 获取内存地址
; 2. 用 ABOUND + DISPERSE 存储数据
; 3. 用 PENETRATE 读取数据
; 4. 验证数据一致性

; 这会验证内存操作是否正常工作

; 简化后的测试程序：
ALLOC R0, 0                ; R0 = 分配 256 字节

; 存储 'A' (65) 到 R0
ABOUND R1, 65              ; 'A' (65 >= 16，所以是立即数)
DISPERSE R0, R1

; 读取回来
PENETRATE R2, R0           ; R2 = *R0

; R2 应该等于 65
; 如果是，说明内存操作正常

; 现在让我们继续更复杂的操作
; 让我准备成功消息 "OK\n"
ALLOC R11, 0               ; 分配消息内存
ABOUND R14, R11            ; 保存原始地址

ABOUND R1, 79              ; 'O'
DISPERSE R11, R1
INCREASE R11, 1

ABOUND R1, 75              ; 'K'
DISPERSE R11, R1
INCREASE R11, 1

ABOUND R1, 10              ; '\n'
DISPERSE R11, R1
INCREASE R11, 1

ABOUND R1, 0               ; null
DISPERSE R11, R1

ABOUND R11, R14            ; 恢复消息指针

; 打印消息
ABOUND R0, 40              ; SYS_PRINT = 40
ABOUND R1, R11
RECV R0, 0

; 退出
ABOUND R0, 255             ; SYS_EXIT = 255
RECV R0, 0

HALT
