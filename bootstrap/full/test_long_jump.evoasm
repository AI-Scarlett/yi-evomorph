; 测试长跳转
; 验证使用寄存器间接跳转的能力

SYS_PRINT   EQU 40
SYS_EXIT    EQU 255

START:
    ; 打印 "Start\n"
    ALLOC R0, 32
    FELLOWSHIP R4, R0
    
    ABOUND R0, 0x53       ; 'S'
    DISPERSE R4, R0, 0
    ABOUND R0, 0x74       ; 't'
    DISPERSE R4, R0, 1
    ABOUND R0, 0x61       ; 'a'
    DISPERSE R4, R0, 2
    ABOUND R0, 0x72       ; 'r'
    DISPERSE R4, R0, 3
    ABOUND R0, 0x74       ; 't'
    DISPERSE R4, R0, 4
    ABOUND R0, 0x0A       ; '\n'
    DISPERSE R4, R0, 5
    ABOUND R0, 0x00       ; '\0'
    DISPERSE R4, R0, 6
    
    FELLOWSHIP R0, R4
    RECV R0, R0, SYS_PRINT
    
    ; 现在测试长跳转
    ; 目标地址需要通过寄存器传递
    
    ; 首先，让我们用多条指令构建目标地址
    ; 假设目标在地址 0x0040 (64)
    
    ; 直接短跳转测试
    ; 先填充一些指令来增加代码长度
    
    ; 使用NOP-like指令填充
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    
    ; 现在应该超过了256字节？
    ; 实际上，每条指令4字节，20条SYNC = 80字节
    ; 加上前面的代码，可能还没到256
    
    ; 让我们添加更多
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC

    ; 现在尝试跳转到目标
    ; 首先，我们需要知道目标地址
    ; 但在汇编时我们不知道
    ; 这就是为什么需要两遍扫描
    
    ; 简化：直接跳到结束
    ; 打印 "Jumped\n"
    
TARGET:
    ALLOC R0, 32
    FELLOWSHIP R4, R0
    
    ABOUND R0, 0x4A       ; 'J'
    DISPERSE R4, R0, 0
    ABOUND R0, 0x75       ; 'u'
    DISPERSE R4, R0, 1
    ABOUND R0, 0x6D       ; 'm'
    DISPERSE R4, R0, 2
    ABOUND R0, 0x70       ; 'p'
    DISPERSE R4, R0, 3
    ABOUND R0, 0x65       ; 'e'
    DISPERSE R4, R0, 4
    ABOUND R0, 0x64       ; 'd'
    DISPERSE R4, R0, 5
    ABOUND R0, 0x0A       ; '\n'
    DISPERSE R4, R0, 6
    ABOUND R0, 0x00       ; '\0'
    DISPERSE R4, R0, 7
    
    FELLOWSHIP R0, R4
    RECV R0, R0, SYS_PRINT
    
    ; 退出
    ABOUND R0, 0
    RECV R0, R0, SYS_EXIT

HALT
