@evolang "3.0"

@xiangci {
    "汇编器生成入口 — 组合 asm_core 和 asm_main 生成完整 assembler.evob"
}

@locus generate.combine {
    mut_rate   = 0.005
    cross_pool = "bootstrap"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x"]

    卦序: {
        ䷁ RECV R0, 255
        ䷂ ALLOC R0, 0x8000
        ䷾ SYNC
        ䷋ HALT
    }
}
