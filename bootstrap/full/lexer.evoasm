; ============================================================
; 易衍·Evomorph 词法分析器 (Lexer)
; 将源代码转换为 Token 流
; ============================================================

; ========== 系统调用号 ==========
SYS_STRLEN    EQU 20
SYS_STRCMP    EQU 21
SYS_STRCPY    EQU 22
SYS_ISDIGIT   EQU 30
SYS_ISALPHA   EQU 31
SYS_ISALNUM   EQU 32
SYS_ISSPACE   EQU 33
SYS_TOUPPER   EQU 34
SYS_TOLOWER   EQU 35
SYS_ATOI      EQU 36
SYS_PRINT     EQU 40
SYS_PRINTLN   EQU 41
SYS_EXIT      EQU 255

; ========== Token 类型定义 ==========
TOKEN_EOF        EQU 0
TOKEN_MNEMONIC   EQU 1
TOKEN_REGISTER   EQU 2
TOKEN_NUMBER     EQU 3
TOKEN_IDENTIFIER EQU 4
TOKEN_COMMA      EQU 5
TOKEN_COLON      EQU 6
TOKEN_MODIFIER   EQU 7
TOKEN_EQU        EQU 8
TOKEN_MACRO      EQU 9
TOKEN_STRING     EQU 10
TOKEN_ERROR      EQU 11

; ========== 字符常量 ==========
CHAR_NULL     EQU 0
CHAR_TAB      EQU 9
CHAR_NEWLINE  EQU 10
CHAR_CR       EQU 13
CHAR_SPACE    EQU 32
CHAR_EXCLAM   EQU 33
CHAR_DQUOTE   EQU 34
CHAR_HASH     EQU 35
CHAR_DOLLAR   EQU 36
CHAR_PERCENT  EQU 37
CHAR_AMPERSAND EQU 38
CHAR_SQUOTE   EQU 39
CHAR_LPAREN   EQU 40
CHAR_RPAREN   EQU 41
CHAR_STAR     EQU 42
CHAR_PLUS     EQU 43
CHAR_COMMA    EQU 44
CHAR_MINUS    EQU 45
CHAR_DOT      EQU 46
CHAR_SLASH    EQU 47
CHAR_0        EQU 48
CHAR_1        EQU 49
CHAR_9        EQU 57
CHAR_COLON    EQU 58
CHAR_SEMICOLON EQU 59
CHAR_LT       EQU 60
CHAR_EQ       EQU 61
CHAR_GT       EQU 62
CHAR_QUESTION EQU 63
CHAR_AT       EQU 64
CHAR_A        EQU 65
CHAR_B        EQU 66
CHAR_F        EQU 70
CHAR_R        EQU 82
CHAR_X        EQU 88
CHAR_Z        EQU 90
CHAR_LBRACKET EQU 91
CHAR_BACKSLASH EQU 92
CHAR_RBRACKET EQU 93
CHAR_CARET    EQU 94
CHAR_UNDER    EQU 95
CHAR_BACKTICK EQU 96
CHAR_a        EQU 97
CHAR_b        EQU 98
CHAR_f        EQU 102
CHAR_r        EQU 114
CHAR_x        EQU 120
CHAR_z        EQU 122
CHAR_LBRACE   EQU 123
CHAR_PIPE     EQU 124
CHAR_RBRACE   EQU 125
CHAR_TILDE    EQU 126

; ========== 小立即数加载宏 ==========

%macro LOAD_0 1
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2
    FELLOWSHIP %1, R1
%endmacro

%macro LOAD_1 1
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    FELLOWSHIP %1, R1
%endmacro

%macro LOAD_2 1
    ABOUND R1, 16
    ABOUND R2, 14
    REDUCE R1, R2
    FELLOWSHIP %1, R1
%endmacro

%macro LOAD_10 1
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2
    FELLOWSHIP %1, R1
%endmacro

; ========== 指针操作宏 ==========

%macro PTR_INC 1
    LOAD_1 R1
    INCREASE %1, R1
%endmacro

; ========== 打印宏 ==========

%macro PRINT_STR 1
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, %1
    RECV R0, 0
%endmacro

%macro PRINT_NEWLINE 0
    ABOUND R0, SYS_PRINTLN
    LOAD_0 R1
    RECV R0, 0
%endmacro

; ========== 主程序 ==========
; 词法分析器测试
; 输入: 字符串 "ABOUND R0, 16"
; 输出: Token 列表
; ==========================================

main:
    ; ===== 步骤 1: 分配缓冲区 =====
    ; 输入缓冲区 - 存储 "ABOUND R0, 16"
    ALLOC R0, 0
    FELLOWSHIP R14, R0          ; R14 = 输入字符串地址
    FELLOWSHIP R10, R0          ; R10 = 工作指针
    
    ; Token 缓冲区 - 存储 Token
    ALLOC R0, 0
    FELLOWSHIP R15, R0          ; R15 = Token 缓冲区地址
    
    ; 当前 Token 缓冲区
    ALLOC R0, 0
    FELLOWSHIP R11, R0          ; R11 = 当前 Token 字符串
    FELLOWSHIP R12, R0          ; R12 = 工作指针
    
    ; ===== 步骤 2: 构建输入字符串 "ABOUND R0, 16\n\0" =====
    ; 'A' = 65
    ABOUND R1, 65
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'B' = 66
    ABOUND R1, 66
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'O' = 79
    ABOUND R1, 79
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'U' = 85
    ABOUND R1, 85
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'N' = 78
    ABOUND R1, 78
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'D' = 68
    ABOUND R1, 68
    DISPERSE R10, R1
    PTR_INC R10
    
    ; ' ' = 32
    ABOUND R1, 32
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'R' = 82
    ABOUND R1, 82
    DISPERSE R10, R1
    PTR_INC R10
    
    ; '0' = 48
    ABOUND R1, 48
    DISPERSE R10, R1
    PTR_INC R10
    
    ; ',' = 44
    ABOUND R1, 44
    DISPERSE R10, R1
    PTR_INC R10
    
    ; ' ' = 32
    ABOUND R1, 32
    DISPERSE R10, R1
    PTR_INC R10
    
    ; '1' = 49
    ABOUND R1, 49
    DISPERSE R10, R1
    PTR_INC R10
    
    ; '6' = 54
    ABOUND R1, 54
    DISPERSE R10, R1
    PTR_INC R10
    
    ; '\0' = 0
    LOAD_0 R1
    DISPERSE R10, R1
    
    ; ===== 步骤 3: 打印输入字符串 =====
    ; 先打印 "Input: "
    ALLOC R0, 0
    FELLOWSHIP R10, R0
    
    ; 'I' = 73
    ABOUND R1, 73
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'n' = 110
    ABOUND R1, 110
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'p' = 112
    ABOUND R1, 112
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'u' = 117
    ABOUND R1, 117
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 't' = 116
    ABOUND R1, 116
    DISPERSE R10, R1
    PTR_INC R10
    
    ; ':' = 58
    ABOUND R1, 58
    DISPERSE R10, R1
    PTR_INC R10
    
    ; ' ' = 32
    ABOUND R1, 32
    DISPERSE R10, R1
    PTR_INC R10
    
    LOAD_0 R1
    DISPERSE R10, R1
    
    PRINT_STR R0
    PRINT_STR R14
    PRINT_NEWLINE
    
    ; ===== 步骤 4: 词法分析主循环 =====
    ; 寄存器约定:
    ; R14 = 输入字符串指针 (当前位置)
    ; R11 = 当前 Token 开始
    ; R12 = 当前 Token 写入位置
    ; R13 = 状态 (0=普通, 1=字符串)
    
    FELLOWSHIP R14, R14          ; 重置输入指针
    FELLOWSHIP R11, R11          ; 当前 Token 缓冲区
    FELLOWSHIP R12, R11          ; Token 写入指针
    
lex_loop:
    ; 读取当前字符
    PENETRATE R14, R1            ; R1 = *R14
    
    ; 检查是否为结束符
    LOAD_0 R2
    FELLOWSHIP R0, R1
    REDUCE R0, R2                 ; R0 = R1 - 0
    ; 如果 R0 == 0，结束
    BRANCH R0, lex_check_char
    
    ; R0 == 0，到达 EOF
    BRANCH R0, lex_done
    
lex_check_char:
    ; 检查是否为空白字符
    FELLOWSHIP R0, R1
    ABOUND R1, SYS_ISSPACE
    RECV R0, 0                    ; R0 = 1 如果是空白
    
    ; 如果 R0 != 0，跳过空白
    BRANCH R0, lex_skip_whitespace
    
    ; 检查是否为注释 (;)
    FELLOWSHIP R0, R1
    ABOUND R2, CHAR_SEMICOLON
    REDUCE R0, R2                 ; R0 = R1 - ';'
    ; 如果 R0 == 0，是注释
    BRANCH R0, lex_skip_comment
    
    ; 检查是否为逗号 (,)
    FELLOWSHIP R0, R1
    ABOUND R2, CHAR_COMMA
    REDUCE R0, R2                 ; R0 = R1 - ','
    ; 如果 R0 == 0，是逗号
    BRANCH R0, lex_handle_comma
    
    ; 检查是否为冒号 (:)
    FELLOWSHIP R0, R1
    ABOUND R2, CHAR_COLON
    REDUCE R0, R2                 ; R0 = R1 - ':'
    ; 如果 R0 == 0，是冒号
    BRANCH R0, lex_handle_colon
    
    ; 检查是否为数字 (0-9)
    FELLOWSHIP R0, R1
    ABOUND R1, SYS_ISDIGIT
    RECV R0, 0                    ; R0 = 1 如果是数字
    
    ; 如果 R0 != 0，解析数字
    BRANCH R0, lex_parse_number
    
    ; 检查是否为字母 (用于标识符/助记符)
    FELLOWSHIP R0, R1
    ABOUND R1, SYS_ISALPHA
    RECV R0, 0                    ; R0 = 1 如果是字母
    
    ; 如果 R0 != 0，解析标识符
    BRANCH R0, lex_parse_identifier
    
    ; 其他字符，暂时跳过
    PTR_INC R14
    BRANCH R0, lex_loop

; ===== 跳过空白字符 =====
lex_skip_whitespace:
    ; 跳过当前空白
    PTR_INC R14
    
    ; 检查下一个字符
    PENETRATE R14, R1
    
    ; 检查是否为空白
    FELLOWSHIP R0, R1
    ABOUND R1, SYS_ISSPACE
    RECV R0, 0
    
    ; 如果是空白，继续跳过
    BRANCH R0, lex_skip_whitespace
    
    ; 不是空白，返回主循环
    BRANCH R0, lex_loop

; ===== 跳过注释 =====
lex_skip_comment:
    ; 跳过注释直到换行或结束
    PTR_INC R14
    
    PENETRATE R14, R1
    
    ; 检查是否为换行
    LOAD_0 R2
    FELLOWSHIP R0, R1
    REDUCE R0, R2                 ; R0 = R1 - 0
    ; 如果 R0 == 0，结束
    BRANCH R0, lex_check_newline
    
    ; R0 == 0，到达 EOF
    BRANCH R0, lex_done
    
lex_check_newline:
    ; 检查是否为换行符
    ABOUND R2, CHAR_NEWLINE
    FELLOWSHIP R0, R1
    REDUCE R0, R2                 ; R0 = R1 - '\n'
    ; 如果 R0 == 0，是换行，结束注释
    BRANCH R0, lex_skip_comment
    
    ; 不是换行，继续
    BRANCH R0, lex_skip_comment

; ===== 处理逗号 =====
lex_handle_comma:
    ; 输出 TOKEN_COMMA
    ; 打印 "COMMA"
    ALLOC R0, 0
    FELLOWSHIP R10, R0
    
    ; 'C' = 67
    ABOUND R1, 67
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'O' = 79
    ABOUND R1, 79
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'M' = 77
    ABOUND R1, 77
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'M' = 77
    ABOUND R1, 77
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'A' = 65
    ABOUND R1, 65
    DISPERSE R10, R1
    PTR_INC R10
    
    LOAD_0 R1
    DISPERSE R10, R1
    
    PRINT_STR R0
    PRINT_NEWLINE
    
    ; 跳过逗号
    PTR_INC R14
    
    BRANCH R0, lex_loop

; ===== 处理冒号 =====
lex_handle_colon:
    ; 输出 TOKEN_COLON
    ; 打印 "COLON"
    ALLOC R0, 0
    FELLOWSHIP R10, R0
    
    ; 'C' = 67
    ABOUND R1, 67
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'O' = 79
    ABOUND R1, 79
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'L' = 76
    ABOUND R1, 76
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'O' = 79
    ABOUND R1, 79
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'N' = 78
    ABOUND R1, 78
    DISPERSE R10, R1
    PTR_INC R10
    
    LOAD_0 R1
    DISPERSE R10, R1
    
    PRINT_STR R0
    PRINT_NEWLINE
    
    ; 跳过冒号
    PTR_INC R14
    
    BRANCH R0, lex_loop

; ===== 解析数字 =====
lex_parse_number:
    ; 收集连续的数字字符
    ; 保存开始位置
    FELLOWSHIP R12, R11
    FELLOWSHIP R13, R14          ; 保存输入指针
    
lex_number_loop:
    ; 存储当前字符到 Token 缓冲区
    PENETRATE R14, R1
    DISPERSE R12, R1
    PTR_INC R12
    
    ; 下一个字符
    PTR_INC R14
    
    ; 检查是否为数字
    PENETRATE R14, R1
    
    FELLOWSHIP R0, R1
    ABOUND R1, SYS_ISDIGIT
    RECV R0, 0
    
    ; 如果是数字，继续
    BRANCH R0, lex_number_loop
    
    ; 不是数字，结束
    ; 添加 null 终止符
    LOAD_0 R1
    DISPERSE R12, R1
    
    ; 输出 TOKEN_NUMBER
    ; 打印 "NUMBER: " + 数字
    ALLOC R0, 0
    FELLOWSHIP R10, R0
    
    ; 'N' = 78
    ABOUND R1, 78
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'U' = 85
    ABOUND R1, 85
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'M' = 77
    ABOUND R1, 77
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'B' = 66
    ABOUND R1, 66
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'E' = 69
    ABOUND R1, 69
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'R' = 82
    ABOUND R1, 82
    DISPERSE R10, R1
    PTR_INC R10
    
    ; ':' = 58
    ABOUND R1, 58
    DISPERSE R10, R1
    PTR_INC R10
    
    ; ' ' = 32
    ABOUND R1, 32
    DISPERSE R10, R1
    PTR_INC R10
    
    LOAD_0 R1
    DISPERSE R10, R1
    
    PRINT_STR R0
    PRINT_STR R11
    PRINT_NEWLINE
    
    BRANCH R0, lex_loop

; ===== 解析标识符 =====
lex_parse_identifier:
    ; 收集连续的字母数字字符
    ; 保存开始位置
    FELLOWSHIP R12, R11
    FELLOWSHIP R13, R14          ; 保存输入指针
    
lex_ident_loop:
    ; 存储当前字符到 Token 缓冲区
    PENETRATE R14, R1
    DISPERSE R12, R1
    PTR_INC R12
    
    ; 下一个字符
    PTR_INC R14
    
    ; 检查是否为字母数字
    PENETRATE R14, R1
    
    FELLOWSHIP R0, R1
    ABOUND R1, SYS_ISALNUM
    RECV R0, 0
    
    ; 如果是字母数字，继续
    BRANCH R0, lex_ident_loop
    
    ; 不是字母数字，结束
    ; 添加 null 终止符
    LOAD_0 R1
    DISPERSE R12, R1
    
    ; 判断 Token 类型:
    ; - 如果以 'R' 开头且后面是数字 -> TOKEN_REGISTER
    ; - 否则 -> TOKEN_IDENTIFIER (可能是助记符)
    
    ; 检查第一个字符是否为 'R'
    PENETRATE R11, R1             ; R1 = Token[0]
    
    ABOUND R2, CHAR_R
    FELLOWSHIP R0, R1
    REDUCE R0, R2                 ; R0 = R1 - 'R'
    
    ; 如果 R0 == 0，可能是寄存器
    BRANCH R0, lex_check_register
    
    ; 不是 'R' 开头，是标识符/助记符
    BRANCH R0, lex_output_identifier

lex_check_register:
    ; 检查第二个字符是否为数字
    FELLOWSHIP R10, R11
    PTR_INC R10                    ; R10 = Token[1]
    
    PENETRATE R10, R1
    
    FELLOWSHIP R0, R1
    ABOUND R1, SYS_ISDIGIT
    RECV R0, 0
    
    ; 如果是数字，是寄存器
    BRANCH R0, lex_output_register
    
    ; 不是数字，是标识符
    BRANCH R0, lex_output_identifier

lex_output_register:
    ; 输出 TOKEN_REGISTER
    ; 打印 "REGISTER: " + 寄存器名
    ALLOC R0, 0
    FELLOWSHIP R10, R0
    
    ; 'R' = 82
    ABOUND R1, 82
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'E' = 69
    ABOUND R1, 69
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'G' = 71
    ABOUND R1, 71
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'I' = 73
    ABOUND R1, 73
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'S' = 83
    ABOUND R1, 83
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'T' = 84
    ABOUND R1, 84
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'E' = 69
    ABOUND R1, 69
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'R' = 82
    ABOUND R1, 82
    DISPERSE R10, R1
    PTR_INC R10
    
    ; ':' = 58
    ABOUND R1, 58
    DISPERSE R10, R1
    PTR_INC R10
    
    ; ' ' = 32
    ABOUND R1, 32
    DISPERSE R10, R1
    PTR_INC R10
    
    LOAD_0 R1
    DISPERSE R10, R1
    
    PRINT_STR R0
    PRINT_STR R11
    PRINT_NEWLINE
    
    BRANCH R0, lex_loop

lex_output_identifier:
    ; 输出 TOKEN_IDENTIFIER (可能是助记符)
    ; 打印 "MNEMONIC: " + 标识符
    ALLOC R0, 0
    FELLOWSHIP R10, R0
    
    ; 'M' = 77
    ABOUND R1, 77
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'N' = 78
    ABOUND R1, 78
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'E' = 69
    ABOUND R1, 69
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'M' = 77
    ABOUND R1, 77
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'O' = 79
    ABOUND R1, 79
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'N' = 78
    ABOUND R1, 78
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'I' = 73
    ABOUND R1, 73
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'C' = 67
    ABOUND R1, 67
    DISPERSE R10, R1
    PTR_INC R10
    
    ; ':' = 58
    ABOUND R1, 58
    DISPERSE R10, R1
    PTR_INC R10
    
    ; ' ' = 32
    ABOUND R1, 32
    DISPERSE R10, R1
    PTR_INC R10
    
    LOAD_0 R1
    DISPERSE R10, R1
    
    PRINT_STR R0
    PRINT_STR R11
    PRINT_NEWLINE
    
    BRANCH R0, lex_loop

; ===== 词法分析完成 =====
lex_done:
    ; 打印完成消息
    ALLOC R0, 0
    FELLOWSHIP R10, R0
    
    ; 'L' = 76
    ABOUND R1, 76
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'e' = 101
    ABOUND R1, 101
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'x' = 120
    ABOUND R1, 120
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'i' = 105
    ABOUND R1, 105
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'n' = 110
    ABOUND R1, 110
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'g' = 103
    ABOUND R1, 103
    DISPERSE R10, R1
    PTR_INC R10
    
    ; ' ' = 32
    ABOUND R1, 32
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'd' = 100
    ABOUND R1, 100
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'o' = 111
    ABOUND R1, 111
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'n' = 110
    ABOUND R1, 110
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'e' = 101
    ABOUND R1, 101
    DISPERSE R10, R1
    PTR_INC R10
    
    ; '!' = 33
    ABOUND R1, 33
    DISPERSE R10, R1
    PTR_INC R10
    
    ; '\n' = 10
    LOAD_10 R1
    DISPERSE R10, R1
    PTR_INC R10
    
    LOAD_0 R1
    DISPERSE R10, R1
    
    PRINT_STR R0
    
    ; ===== 退出 =====
    ABOUND R0, SYS_EXIT
    RECV R0, 0

HALT
