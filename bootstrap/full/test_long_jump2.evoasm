; 测试长跳转 - 使用寄存器间接跳转
; 验证 .ASYNC BRANCH 可以跳转到超过255字节的位置

SYS_PRINT   EQU 40
SYS_EXIT    EQU 255

START:
    ; 打印 "Start\n"
    ALLOC R0, 0
    FELLOWSHIP R4, R0
    FELLOWSHIP R10, R4
    
    ; 'S' = 83
    ABOUND R1, 83
    DISPERSE R10, R1
    
    ; 指针加1
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 't' = 116
    ABOUND R1, 116
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'a' = 97
    ABOUND R1, 97
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'r' = 114
    ABOUND R1, 114
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 't' = 116
    ABOUND R1, 116
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '\n' = 10
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '\0' = 0
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2
    DISPERSE R10, R1
    
    ; 打印
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R4
    RECV R0, 0
    
    ; 现在，让我们用NOP填充代码，确保目标超过255字节
    ; 每条SYNC指令4字节
    ; 我们需要大约 256 / 4 = 64 条 SYNC 指令
    
    ; 填充60条 SYNC 指令 (240字节)
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    
    ; 现在，TARGET应该在超过255字节的位置
    ; 让我们尝试使用寄存器间接跳转
    
    ; 首先，我们需要知道TARGET的地址
    ; 但在汇编时我们不知道...
    ; 这就是为什么需要两遍扫描
    
    ; 简化：让我们直接跳转到TARGET
    ; 这应该会触发警告，但让我们看看会发生什么
    
    ; 首先，设置条件寄存器为非零
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2    ; R1 = 1
    
    ; 直接跳转 - 这应该会因为目标超过255而失败
    ; BRANCH R1, TARGET
    
    ; 相反，让我们使用寄存器间接跳转
    ; 但我们需要先将目标地址加载到寄存器
    ; 问题是：我们在汇编时不知道目标地址...
    
    ; 这就是为什么需要修改Python汇编器来自动处理长跳转
    ; 或者，在EvoASM中手动处理
    
    ; 让我们先尝试直接跳转，看看会发生什么
    BRANCH R1, TARGET
    
    ; 如果跳转失败，我们会到这里
    ; 打印 "Jump failed\n"
    ALLOC R0, 0
    FELLOWSHIP R4, R0
    FELLOWSHIP R10, R4
    
    ; 'J' = 74
    ABOUND R1, 74
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'u' = 117
    ABOUND R1, 117
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'm' = 109
    ABOUND R1, 109
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'p' = 112
    ABOUND R1, 112
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; ' ' = 32
    ABOUND R1, 32
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'f' = 102
    ABOUND R1, 102
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'a' = 97
    ABOUND R1, 97
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'i' = 105
    ABOUND R1, 105
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'l' = 108
    ABOUND R1, 108
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'e' = 101
    ABOUND R1, 101
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'd' = 100
    ABOUND R1, 100
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '\n' = 10
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '\0' = 0
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2
    DISPERSE R10, R1
    
    ; 打印
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R4
    RECV R0, 0
    
    ; 退出
    ABOUND R0, SYS_EXIT
    RECV R0, 0

; 目标标签 - 应该在超过255字节的位置
TARGET:
    ; 打印 "Jump success!\n"
    ALLOC R0, 0
    FELLOWSHIP R4, R0
    FELLOWSHIP R10, R4
    
    ; 'J' = 74
    ABOUND R1, 74
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'u' = 117
    ABOUND R1, 117
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'm' = 109
    ABOUND R1, 109
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'p' = 112
    ABOUND R1, 112
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; ' ' = 32
    ABOUND R1, 32
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 's' = 115
    ABOUND R1, 115
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'u' = 117
    ABOUND R1, 117
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'c' = 99
    ABOUND R1, 99
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'c' = 99
    ABOUND R1, 99
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'e' = 101
    ABOUND R1, 101
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 's' = 115
    ABOUND R1, 115
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 's' = 115
    ABOUND R1, 115
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '!' = 33
    ABOUND R1, 33
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '\n' = 10
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '\0' = 0
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2
    DISPERSE R10, R1
    
    ; 打印
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R4
    RECV R0, 0
    
    ; 退出
    ABOUND R0, SYS_EXIT
    RECV R0, 0

HALT
