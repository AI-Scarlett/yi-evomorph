    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 'a' = 97
    ABOUND R1, 97
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 'r' = 114
    ABOUND R1, 114
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 'g' = 103
    ABOUND R1, 103
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 'e' = 101
    ABOUND R1, 101
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 't' = 116
    ABOUND R1, 116
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; ' ' = 32
    ABOUND R1, 32
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 'r' = 114
    ABOUND R1, 114
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 'e' = 101
    ABOUND R1, 101
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 'a' = 97
    ABOUND R1, 97
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 'c' = 99
    ABOUND R1, 99
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 'h' = 104
    ABOUND R1, 104
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 'e' = 101
    ABOUND R1, 101
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 'd' = 100
    ABOUND R1, 100
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; '\n' = 10
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; '\0' = 0
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2
    DISPERSE R4, R1
    
    ; 打印
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R4
    RECV R0, 0
    
    ; 现在尝试使用寄存器间接跳转到 TARGET
    ; 首先，我们需要知道 TARGET 的地址
    ; 但在汇编时我们不知道...
    
    ; 让我们尝试另一种方法：使用多个短跳转
    ; 或者，让我们检查一下为什么长跳转代码不工作
    
    ; 让我们先退出
    ABOUND R0, SYS_EXIT
    RECV R0, 0

; 目标标签 - 应该在超过255字节的位置
TARGET:
    ; 打印 "Jump success!\n"
    ALLOC R0, 0
    FELLOWSHIP R4, R0
    
    ; 'J' = 74
    ABOUND R1, 74
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 'u' = 117
    ABOUND R1, 117
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 'm' = 109
    ABOUND R1, 109
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 'p' = 112
    ABOUND R1, 112
    DISPERSE R4, R1
    
    ABOUND R1, 16
