    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 'e' = 101
    ABOUND R1, 101
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 's' = 115
    ABOUND R1, 115
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 's' = 115
    ABOUND R1, 115
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; '!' = 33
    ABOUND R1, 33
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; '\n' = 10
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
