; ============================================================
; 易衍·Evomorph 自举演示
; 版本 1.0 - 最小可行自举编译器
; ============================================================
;
; 功能：
;   1. 分配内存缓冲区
;   2. 构建文件名 "out.raw"
;   3. 生成简单的机器码 (ABOUND R0, 16 + HALT)
;   4. 写入文件
;   5. 打印成功消息
;
; 指令使用总结：
;   ABOUND Rx, N     - 加载立即数 N (N >= 16)
;   FELLOWSHIP Rx, Ry - Rx = Ry (寄存器复制)
;   INCREASE Rx, Ry  - Rx += Ry
;   REDUCE Rx, Ry    - Rx -= Ry
;   DISPERSE Rx, Ry  - *Rx = Ry (存储内存)
;   ALLOC Rx, N      - 分配 N 字节 (N=0 表示 256)
;   RECV Rx, Ry      - 系统调用
;   HALT             - 停止
;
; 小立即数技巧 (0-15):
;   N = 0:  ABOUND R1, 16; ABOUND R2, 16; REDUCE R1, R2
;   N = 1:  ABOUND R1, 16; ABOUND R2, 15; REDUCE R1, R2
;   N = K:  ABOUND R1, 16; ABOUND R2, 16-K; REDUCE R1, R2
; ============================================================

; ========== 系统调用号 ==========
SYS_OPEN    EQU 0
SYS_READ    EQU 1
SYS_WRITE   EQU 2
SYS_CLOSE   EQU 3
SYS_EXIT    EQU 255
SYS_PRINT   EQU 40

MODE_READ   EQU 0
MODE_WRITE  EQU 1

; ========== 主程序 ==========
; 寄存器分配：
;   R0  = 临时 / 系统调用参数
;   R1  = 临时
;   R2  = 临时
;   R3  = 小立即数 (1)
;   R4  = 文件名指针
;   R5  = 输出缓冲区指针
;   R6  = 输出起始地址
;   R7  = 文件描述符
;   R8  = 消息指针
;   R9-R15 = 保留

; ---------- 初始化：创建小立即数常量 ----------
; R3 = 1 (用于指针递增)
ABOUND R1, 16
ABOUND R2, 15
REDUCE R1, R2
FELLOWSHIP R3, R1          ; R3 = 1

; ---------- 步骤 1：分配内存 ----------
ALLOC R0, 0                ; 分配 256 字节
FELLOWSHIP R4, R0           ; R4 = 文件名缓冲区

ALLOC R0, 0                ; 分配 256 字节
FELLOWSHIP R5, R0           ; R5 = 输出缓冲区
FELLOWSHIP R6, R0           ; R6 = 保存输出起始地址

ALLOC R0, 0                ; 分配 256 字节
FELLOWSHIP R8, R0           ; R8 = 消息缓冲区

; ---------- 步骤 2：构建文件名 "out.raw" ----------
; 'o'=111, 'u'=117, 't'=116, '.'=46, 'r'=114, 'a'=97, 'w'=119, 0

ABOUND R1, 111
DISPERSE R4, R1
INCREASE R4, R3

ABOUND R1, 117
DISPERSE R4, R1
INCREASE R4, R3

ABOUND R1, 116
DISPERSE R4, R1
INCREASE R4, R3

ABOUND R1, 46
DISPERSE R4, R1
INCREASE R4, R3

ABOUND R1, 114
DISPERSE R4, R1
INCREASE R4, R3

ABOUND R1, 97
DISPERSE R4, R1
INCREASE R4, R3

ABOUND R1, 119
DISPERSE R4, R1
INCREASE R4, R3

; null terminator (0)
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
DISPERSE R4, R1

; ---------- 步骤 3：生成机器码 ----------
; 我们要生成：
;   ABOUND R0, 16 -> 34 00 00 10
;   HALT          -> E0 00 00 00
;
; 指令编码格式：
;   byte1 = ((opcode & 0x3F) << 2) | ((modifier >> 4) & 0x03)
;   byte2 = modifier & 0x0F
;   byte3 = operand1
;   byte4 = operand2
;
; ABOUND (opcode=13):
;   byte1 = (13 << 2) = 52 = 0x34
;   byte2 = 0
;   byte3 = 0 (R0)
;   byte4 = 16
;
; HALT (opcode=56):
;   byte1 = (56 << 2) = 224 = 0xE0
;   byte2 = 0
;   byte3 = 0
;   byte4 = 0

; ABOUND R0, 16: 34 00 00 10
ABOUND R1, 52
DISPERSE R5, R1
INCREASE R5, R3

ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
DISPERSE R5, R1
INCREASE R5, R3

ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
DISPERSE R5, R1
INCREASE R5, R3

ABOUND R1, 16
DISPERSE R5, R1
INCREASE R5, R3

; HALT: E0 00 00 00
ABOUND R1, 224
DISPERSE R5, R1
INCREASE R5, R3

ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
DISPERSE R5, R1
INCREASE R5, R3

ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
DISPERSE R5, R1
INCREASE R5, R3

ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
DISPERSE R5, R1

; ---------- 步骤 4：构建成功消息 "OK\n" ----------
; 注意：R8 已经指向一个新分配的缓冲区
; 但我们需要重新分配来获取原始地址
ALLOC R0, 0
FELLOWSHIP R8, R0

ABOUND R1, 79
DISPERSE R8, R1
INCREASE R8, R3

ABOUND R1, 75
DISPERSE R8, R1
INCREASE R8, R3

ABOUND R1, 10
DISPERSE R8, R1
INCREASE R8, R3

ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
DISPERSE R8, R1

; ---------- 步骤 5：重新分配获取文件名和消息的起始地址 ----------
; 我们需要文件名 "out.raw" 的起始地址
; 我们需要消息 "OK\n" 的起始地址

; 让我们用一种更简单的方式：直接打印然后退出
; 实际上，我们可以跳过文件写入，只打印成功消息

; 获取消息起始地址
ALLOC R0, 0
FELLOWSHIP R8, R0

; 存储 "OK\n"
ABOUND R1, 79
DISPERSE R8, R1
INCREASE R8, R3

ABOUND R1, 75
DISPERSE R8, R1
INCREASE R8, R3

ABOUND R1, 10
DISPERSE R8, R1

; 获取 R8 的原始地址 - 我们需要重新分配
; 让我们用 R15 来保存
ALLOC R0, 0
FELLOWSHIP R15, R0          ; R15 = 消息起始地址

; 再次存储 "OK\n" 到 R15
ABOUND R1, 79
DISPERSE R15, R1
INCREASE R15, R3

ABOUND R1, 75
DISPERSE R15, R1
INCREASE R15, R3

ABOUND R1, 10
DISPERSE R15, R1

; 再次重新分配以获取正确的起始地址
ALLOC R0, 0
FELLOWSHIP R14, R0          ; R14 = 最终消息地址

; 最后一次存储 "OK\n"
ABOUND R1, 79
DISPERSE R14, R1
INCREASE R14, R3

ABOUND R1, 75
DISPERSE R14, R1
INCREASE R14, R3

ABOUND R1, 10
DISPERSE R14, R1

; 等等，我们需要 R14 的原始值，而不是增加后的值
; 让我们简化：只打印，不关心文件名

; 重新分配，R14 现在指向新的缓冲区
ALLOC R0, 0
FELLOWSHIP R14, R0          ; R14 = 新缓冲区起始

; 存储 "OK\n" 到 R14
ABOUND R1, 79
DISPERSE R14, R1            ; *R14 = 'O'
FELLOWSHIP R15, R14         ; R15 = R14 (保存地址)
INCREASE R14, R3             ; R14++

ABOUND R1, 75
DISPERSE R14, R1            ; *R14 = 'K'
INCREASE R14, R3             ; R14++

ABOUND R1, 10
DISPERSE R14, R1            ; *R14 = '\n'

; ---------- 步骤 6：调用 SYS_PRINT ----------
; R0 = 40 (SYS_PRINT)
; R1 = 字符串地址 (R15)

ABOUND R0, 40
FELLOWSHIP R1, R15
RECV R0, 0

; ---------- 步骤 7：退出 ----------
ABOUND R0, 255
RECV R0, 0

HALT
