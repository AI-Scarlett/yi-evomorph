
; ============================================================
; EvoASM 简单测试程序
; ============================================================

SYS_PRINT   EQU 40
SYS_EXIT    EQU 255

START:

    ; 字符串: 'Hello from EvoASM!\n'
    ; 分配缓冲区并保存地址到 R4
    ALLOC R0, 0
    FELLOWSHIP R4, R0      ; 保存缓冲区起始地址
    FELLOWSHIP R10, R0      ; 工作指针
    ABOUND R1, 72
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 101
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 108
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 108
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 111
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 32
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 102
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 114
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 111
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 109
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 32
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 69
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 118
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 111
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 65
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 83
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 77
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 33
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ; 小立即数 10
    ABOUND R2, 16
    ABOUND R3, 6
    REDUCE R2, R3
    FELLOWSHIP R1, R2
    DISPERSE R10, R1
    ; 字符串结束符
    ABOUND R2, 16
    ABOUND R3, 16
    REDUCE R2, R3
    FELLOWSHIP R1, R2
    DISPERSE R10, R1
    ; 打印字符串（地址在 R4）
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R4      ; R1 = 字符串地址
    RECV R0, 0
    
    ABOUND R0, SYS_EXIT
    RECV R0, 0

HALT

