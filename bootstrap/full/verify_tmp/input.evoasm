INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 84
XOR R1, R2
BRANCH R1, NOT_STEP
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 69
XOR R1, R2
BRANCH R1, NOT_STEP
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 80
XOR R1, R2
ABOUND R2, 1
INCREASE R4, R2
ABOUND R11, 59
FELLOWSHIP R11, R11
BRANCH R2, P2_PARSE_OPERANDS
NOT_STEP:
FELLOWSHIP R4, R12        ; Restore R4 to line start using saved R12
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
; Check 'XOR'
ABOUND R2, 88
XOR R1, R2
BRANCH R1, NOT_XOR
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 79
XOR R1, R2
BRANCH R1, NOT_XOR
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 82
XOR R1, R2
ABOUND R2, 1
INCREASE R4, R2
ABOUND R11, 37
FELLOWSHIP R11, R11
BRANCH R2, P2_PARSE_OPERANDS
NOT_XOR:
; Unknown mnemonic - skip line
P2_SKIP_LINE2:
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
BRANCH R1, P2_SL2_CONT
BRANCH R2, P2_END
P2_SL2_CONT:
ABOUND R2, 10
XOR R1, R2
BRANCH R1, P2_SKIP_LINE2
BRANCH R2, P2_LINE

; ===== Operand Parsing =====
P2_PARSE_OPERANDS:
; R4 points past mnemonic name, R11 = opcode
; Goal: R13 = operand1 byte, R14 = operand2 byte

; --- Skip spaces before operand1 ---
P2_PO_SKIPSP1:
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 32           ; ' '
XOR R1, R2
BRANCH R1, P2_PO_READ1
ABOUND R2, 1
INCREASE R4, R2
BRANCH R2, P2_PO_SKIPSP1

P2_PO_READ1:
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
; Check for register 'R' (82)
ABOUND R2, 82
XOR R1, R2
BRANCH R1, P2_PO_OP1NUM ; not 'R', parse as number
; --- Parse register ---
ABOUND R2, 1
INCREASE R4, R2         ; skip 'R'
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R13, R0
PENETRATE R4, R13
ABOUND R2, 1
INCREASE R4, R2
ABOUND R2, 48           ; '0'
REDUCE R13, R2          ; R13 = digit value
; Check if 2-digit register (R10-R15)
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 32           ; ' '
XOR R1, R2
BRANCH R1, P2_PO_REG2DIG ; not space, could be 2nd digit
BRANCH R2, P2_PO_SKIPCOMMA ; space, done with op1
P2_PO_REG2DIG:
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 44           ; ','
XOR R1, R2
BRANCH R1, P2_PO_REG2DIG2 ; not comma -> parse 2nd digit
BRANCH R2, P2_PO_SKIPCOMMA ; comma, done
P2_PO_REG2DIG2:
; Parse 2nd digit for register R10-R15
ABOUND R2, 1
INCREASE R4, R2         ; skip digit char
; R13 = R13 * 10 + digit
ABOUND R2, 48           ; '0'
REDUCE R1, R2           ; R1 = digit value
; Multiply R13 by 10: R13 = R13*8 + R13*2
FELLOWSHIP R14, R13     ; save original
ABOUND R3, 3
SHL R13, R3             ; R13 = R13 * 8
ABOUND R3, 1
SHL R14, R3             ; R14 = original * 2
INCREASE R13, R14       ; R13 = R13*8 + R13*2 = R13*10
INCREASE R13, R1        ; R13 = R13*10 + digit
BRANCH R2, P2_PO_SKIPCOMMA

; --- Parse number operand ---
P2_PO_OP1NUM:
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R13, R1      ; R13 = 0 (accumulator)
P2_PO_NUM1_LOOP:
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
; Check if digit (between '0' and '9')
ABOUND R2, 48           ; '0'
REDUCE R1, R2           ; R1 = char - '0'
; Check if R1 >= 10 (not a digit in 0-9 range)
FELLOWSHIP R14, R1      ; save digit value
ABOUND R2, 10
; We can't directly compare. Use: digit_value - 10, check negative
; But VM has no sign check for branch... Let's check if value > 10
; Approach: if value in 0-9 range, the value < 10 in unsigned
; We'll just proceed assuming it's a digit for well-formed input
; Actually, check common non-digit chars: space=32(-> -16), comma=44(-> -4)
BRANCH R14, P2_PO_NUM1BODY  ; if non-zero, might be digit or other
; R14 == 0 means char == '0' (digit), process
BRANCH R2, P2_PO_NUM1BODY
P2_PO_NUM1BODY:
; R13 = R13 * 10 + digit(R14)
FELLOWSHIP R15, R13     ; save old value
ABOUND R3, 3
SHL R13, R3             ; *8
ABOUND R3, 1
SHL R15, R3             ; *2
INCREASE R13, R15       ; *10
INCREASE R13, R14       ; + digit
ABOUND R2, 1
INCREASE R4, R2         ; advance past digit
; Peek next char
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 44           ; ','
XOR R1, R2
BRANCH R1, P2_PO_CHK_SP2 ; not comma
BRANCH R2, P2_PO_SKIPCOMMA ; comma, done
P2_PO_CHK_SP2:
ABOUND R2, 32           ; ' '
XOR R1, R2
BRANCH R1, P2_PO_NUM1_LOOP ; not space, continue parsing digits
BRANCH R2, P2_PO_SKIPSP2 ; space, done with op1

; --- Skip comma and spaces to operand2 ---
P2_PO_SKIPCOMMA:
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 44           ; ','
XOR R1, R2
BRANCH R1, P2_PO_SKIPSP2 ; no comma, just spaces
ABOUND R2, 1
INCREASE R4, R2         ; skip comma
P2_PO_SKIPSP2:
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 32           ; ' '
XOR R1, R2
BRANCH R1, P2_PO_READ2
ABOUND R2, 1
INCREASE R4, R2
BRANCH R2, P2_PO_SKIPSP2

; --- Parse operand2 (same pattern as operand1) ---
P2_PO_READ2:
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 82           ; 'R'
XOR R1, R2
BRANCH R1, P2_PO_OP2NUM ; not 'R', check for label or number
; Register
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R14, R0
PENETRATE R4, R14
ABOUND R2, 1
INCREASE R4, R2
ABOUND R2, 48
REDUCE R14, R2          ; R14 = digit value
; Check 2nd digit
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 32
XOR R1, R2
BRANCH R1, P2_PO_REG2DIG2B
BRANCH R2, P2_EMIT
P2_PO_REG2DIG2B:
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 44
XOR R1, R2
BRANCH R1, P2_PO_R2_DIG2
BRANCH R2, P2_EMIT
P2_PO_R2_DIG2:
ABOUND R2, 1
INCREASE R4, R2
ABOUND R2, 48
REDUCE R1, R2
FELLOWSHIP R15, R14
ABOUND R3, 3
SHL R14, R3
ABOUND R3, 1
SHL R15, R3
INCREASE R14, R15
INCREASE R14, R1
BRANCH R2, P2_EMIT

; --- Check if operand2 is label name or number ---
P2_PO_OP2NUM:
; Check if first char of operand2 is a letter (label name)
; Letters in EvoASM labels are uppercase A-Z (65-90)
; Check if >= 'A' (65)
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R14, R0
PENETRATE R4, R14
; Save label name start pointer for BRANCH lookup
FELLOWSHIP R10, R4      ; R10 = label name start (temporary use)
FELLOWSHIP R1, R14
ABOUND R2, 65           ; 'A'
REDUCE R1, R2           ; R1 = char - 'A'
; If R1 < 0 (char < 'A'), it's a number; if R1 >= 0, it's a letter
; Since we can't check sign easily, check if char is digit instead
FELLOWSHIP R1, R14
ABOUND R2, 48           ; '0'
REDUCE R1, R2           ; R1 = char - '0'
; If R1 is 0-9 (digit), it's a number
; We'll try number parsing, and if it fails, it's a label
; For well-formed input, just parse as number
BRANCH R2, P2_PO_OP2ASNUM

P2_PO_OP2ASNUM:
; Parse number for operand2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R14, R1      ; R14 = 0
BRANCH R2, P2_PO_NUM2_LOOP

P2_PO_NUM2_LOOP:
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 48
REDUCE R1, R2           ; R1 = char - '0'
FELLOWSHIP R15, R1      ; save digit
; Check for end: space or newline
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 32
XOR R1, R2
BRANCH R1, P2_PO_N2_CHKNL
; Next is space, process digit
FELLOWSHIP R1, R15
BRANCH R2, P2_PO_N2_ACCUM
P2_PO_N2_CHKNL:
ABOUND R2, 10           ; newline
XOR R1, R2
BRANCH R1, P2_PO_N2_CONT
; Next is newline, process digit
FELLOWSHIP R1, R15
BRANCH R2, P2_PO_N2_ACCUM
P2_PO_N2_CONT:
; More digits
FELLOWSHIP R1, R15
P2_PO_N2_ACCUM:
; R14 = R14 * 10 + digit(R1)
FELLOWSHIP R15, R14
ABOUND R3, 3
SHL R14, R3
ABOUND R3, 1
SHL R15, R3
INCREASE R14, R15
INCREASE R14, R1
; Peek next
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 32
XOR R1, R2
BRANCH R1, P2_PO_N2_NL
BRANCH R2, P2_EMIT      ; space → done
P2_PO_N2_NL:
ABOUND R2, 10
XOR R1, R2
BRANCH R1, P2_PO_NUM2_LOOP ; continue
BRANCH R2, P2_EMIT      ; newline → done

; ===== Emit 4-byte instruction =====
P2_EMIT:
; byte1 = opcode << 2
ABOUND R3, 1
FELLOWSHIP R1, R11
SHL R1, R3
SHL R1, R3
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
; byte2 = 0  (modifier byte)
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
DISPERSE R5, R1
INCREASE R5, R2
; byte3 = operand1 (from R13)
FELLOWSHIP R1, R13
DISPERSE R5, R1
INCREASE R5, R2
; byte4 = operand2 (from R14)
FELLOWSHIP R1, R14
DISPERSE R5, R1
INCREASE R5, R2
; addr += 4
ABOUND R2, 4
INCREASE R7, R2

; Skip to next line
P2_TO_NL:
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
BRANCH R1, P2_TNL_CONT
BRANCH R2, P2_END
P2_TNL_CONT:
ABOUND R2, 1
INCREASE R4, R2
ABOUND R2, 10
XOR R1, R2
BRANCH R1, P2_TO_NL
BRANCH R2, P2_LINE

P2_END:
; Pass 2 complete

DONE:
; Calculate output size: R5 - R9
FELLOWSHIP R1, R5
REDUCE R1, R9
FELLOWSHIP R13, R1

; Build 'output.evob' filename
ALLOC R0, 0
FELLOWSHIP R10, R0     ; Save base for later 0 (R14 corrupt by long jumps)
FELLOWSHIP R5, R0
ABOUND R1, 111
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 117
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 116
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 112
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 117
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 116
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 46
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 101
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 118
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 111
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 98
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2

; Open output file
ABOUND R0, 0
FELLOWSHIP R1, R10     ; Use saved base (R5 was advanced by wb())
ABOUND R2, 1
RECV R0, 0
FELLOWSHIP R12, R0

; Write bytecode
ABOUND R0, 2
FELLOWSHIP R1, R12
FELLOWSHIP R2, R9
FELLOWSHIP R3, R13
RECV R0, 0

; Close & exit
ABOUND R0, 3
FELLOWSHIP R1, R12
RECV R0, 0
ABOUND R0, 255
RECV R0, 0
HALT