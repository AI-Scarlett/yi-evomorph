; ===== EvoASM Self-Bootstrapping Two-Pass Assembler v2.0 =====
; Assembled by Python assembler v2 (auto long-jump support)

; ===== Macros =====




; ===== Constants =====

; ===== MAIN =====
START:
; Build input filename 'input.evoasm'
ALLOC R0, 0
FELLOWSHIP R10, R0
FELLOWSHIP R5, R0
ABOUND R1, 105
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 110
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 112
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 117
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 116
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 46
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 101
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 118
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 111
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 97
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 115
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 109
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
DISPERSE R5, R1
ABOUND R2, 1
INCREASE R5, R2
; Open for reading
ABOUND R0, 0
FELLOWSHIP R1, R10
ABOUND R2, 0
RECV R0, 0
FELLOWSHIP R12, R0       ; fd

; Alloc input buffer (64KB via 10)
ABOUND R0, 10             ; 10
ABOUND R1, 64       ; base = 64
ABOUND R14, 10            ; shift = 10 (×1024)
SHL R1, R14               ; size = 64×1024 = 65536
RECV R0, 0
FELLOWSHIP R6, R0
FELLOWSHIP R4, R6        ; in_buf ptr

READ_CHUNK:
ABOUND R0, 1
FELLOWSHIP R1, R12
ABOUND R3, 1
ABOUND R14, 8
SHL R3, R14              ; R3 = 256
FELLOWSHIP R2, R4         ; R2 = buffer
RECV R0, 0
FELLOWSHIP R15, R0       ; bytes_read
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
BRANCH R15, READ_HAS_DATA
BRANCH R2, READ_DONE
READ_HAS_DATA:
ABOUND R2, 1
ABOUND R14, 8
SHL R2, R14              ; R2 = 256
INCREASE R4, R2
BRANCH R2, READ_CHUNK
READ_DONE:
; Close input
ABOUND R0, 3
FELLOWSHIP R1, R12
RECV R0, 0

; ===== PASS 1: Collect labels =====
FELLOWSHIP R4, R6        ; reset ptr
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R7, R1        ; R7 = addr = 0
; Alloc label table (32KB via 10)
ABOUND R0, 10             ; 10
ABOUND R1, 32       ; base = 32
ABOUND R14, 10            ; shift = 10 (×1024)
SHL R1, R14               ; size = 32×1024 = 32768
RECV R0, 0
FELLOWSHIP R8, R0
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R13, R1       ; R13 = label count = 0

P1_LINE:
; Skip leading spaces
P1_SKIP_WS:
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 32
XOR R1, R2
BRANCH R1, P1_CHECK_CHAR
ABOUND R2, 1
INCREASE R4, R2
BRANCH R2, P1_SKIP_WS

P1_CHECK_CHAR:
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
; Null byte -> end of pass 1
BRANCH R1, P1_CHK_CONT
BRANCH R2, P1_END
P1_CHK_CONT:
; Newline -> next line
ABOUND R2, 10
XOR R1, R2
BRANCH R1, P1_NOT_NL
ABOUND R2, 1
INCREASE R4, R2
BRANCH R2, P1_LINE

P1_NOT_NL:
; Comment -> skip line
ABOUND R2, 59
XOR R1, R2
BRANCH R1, P1_NOT_COMMENT
; Skip comment
P1_SKIP_CMT:
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
BRANCH R1, P1_CMT_NL
BRANCH R2, P1_END
P1_CMT_NL:
ABOUND R2, 10
XOR R1, R2
BRANCH R1, P1_SKIP_CMT
BRANCH R2, P1_LINE

P1_NOT_COMMENT:
FELLOWSHIP R15, R4      ; R15 = line scan pointer
P1_SCAN:
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
PENETRATE R15, R1        ; R1 = memory[R15] (read byte)
BRANCH R1, P1_SCN_CONT   ; non-null byte -> continue
BRANCH R2, P1_END        ; null byte -> end of pass 1
P1_SCN_CONT:
ABOUND R2, 1
INCREASE R15, R2         ; R15++
FELLOWSHIP R3, R1        ; R3 = byte (save for comparisons)
; Check for ':' -> label
ABOUND R2, 58
REDUCE R3, R2            ; R3 = byte - ':'
BRANCH R3, P1_CHK_SP     ; R3 != 0 -> check space
BRANCH R2, P1_IS_LABEL   ; R3 == 0 -> matched ':'
P1_CHK_SP:
FELLOWSHIP R3, R1        ; R3 = byte (restore)
ABOUND R2, 32
REDUCE R3, R2            ; R3 = byte - ' '
BRANCH R3, P1_CHK_NL     ; R3 != 0 -> check newline
BRANCH R2, P1_IS_INSN    ; R3 == 0 -> matched ' '
P1_CHK_NL:
ABOUND R2, 10
REDUCE R1, R2            ; R1 = byte - '\n'
BRANCH R1, P1_SCAN       ; R1 != 0 -> continue scanning
BRANCH R2, P1_IS_INSN    ; R1 == 0 -> matched '\n'

P1_IS_LABEL:
; R15 points past colon char, label name from R4 to R15-1
FELLOWSHIP R2, R15
DISPERSE R8, R7          ; addr low byte
ABOUND R2, 1
INCREASE R8, R2
DISPERSE R8, R4          ; name_start
INCREASE R8, R2
REDUCE R15, R2           ; R15 = name_end (before colon)
DISPERSE R8, R15         ; name_end
INCREASE R8, R2
INCREASE R13, R2         ; label_count++
FELLOWSHIP R4, R15
ABOUND R2, 2
INCREASE R4, R2          ; skip ':' char
P1_SKIP_LINE:
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
BRANCH R1, P1_SL_CONT
BRANCH R2, P1_END
P1_SL_CONT:
ABOUND R2, 1
INCREASE R4, R2
ABOUND R2, 10
XOR R1, R2
BRANCH R1, P1_SKIP_LINE
BRANCH R2, P1_LINE

P1_IS_INSN:
FELLOWSHIP R2, R15
ABOUND R15, 4
INCREASE R7, R15         ; addr += 4
FELLOWSHIP R4, R2
BRANCH R2, P1_LINE

P1_END:
; Pass 1 complete, continue to Pass 2

; ===== PASS 2: Encode instructions =====
FELLOWSHIP R4, R6        ; reset ptr
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R7, R1        ; addr = 0
; Alloc output buffer (64KB via 10)
ABOUND R0, 10             ; 10
ABOUND R1, 64       ; base = 64
ABOUND R14, 10            ; shift = 10 (×1024)
SHL R1, R14               ; size = 64×1024 = 65536
RECV R0, 0
FELLOWSHIP R9, R0
FELLOWSHIP R5, R9        ; output buf ptr = out base

P2_LINE:
P2_SKIP_WS:
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 32
XOR R1, R2
BRANCH R1, P2_CHECK_CHAR
ABOUND R2, 1
INCREASE R4, R2
BRANCH R2, P2_SKIP_WS

P2_CHECK_CHAR:
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
; Null byte -> end of pass 2
BRANCH R1, P2_CHK_CONT
BRANCH R2, P2_END
P2_CHK_CONT:
; Newline
ABOUND R2, 10
XOR R1, R2
BRANCH R1, P2_NOT_NL
ABOUND R2, 1
INCREASE R4, R2
BRANCH R2, P2_LINE

P2_NOT_NL:
; Comment
ABOUND R2, 59
XOR R1, R2
BRANCH R1, P2_NOT_CMT
P2_SKIP_CMT:
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
BRANCH R1, P2_SC_NL
BRANCH R2, P2_END
P2_SC_NL:
ABOUND R2, 10
XOR R1, R2
BRANCH R1, P2_SKIP_CMT
BRANCH R2, P2_LINE

P2_NOT_CMT:
; Scan for colon (label line vs instruction)
FELLOWSHIP R15, R4
P2_SCAN_COLON:
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R15, R1
BRANCH R1, P2_SCO_CONT
BRANCH R2, P2_END
P2_SCO_CONT:
ABOUND R2, 1
INCREASE R15, R2
FELLOWSHIP R3, R1         ; save byte
ABOUND R2, 58
REDUCE R3, R2             ; R3 = byte - ':'
BRANCH R3, P2_CHK_NL2     ; not ':'
BRANCH R2, P2_IS_LABEL_LINE ; is ':', skip label line
P2_CHK_NL2:
ABOUND R2, 10
REDUCE R1, R2             ; R1 = byte - '\n'
BRANCH R1, P2_SCAN_COLON  ; not '\n', continue scan
BRANCH R2, P2_ENCODE      ; is '\n', encode instruction

P2_IS_LABEL_LINE:
FELLOWSHIP R4, R15
P2_AFTER_COLON:
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
BRANCH R1, P2_AC_CONT
BRANCH R2, P2_END
P2_AC_CONT:
ABOUND R2, 1
INCREASE R4, R2
ABOUND R2, 10
XOR R1, R2
BRANCH R1, P2_AFTER_COLON
BRANCH R2, P2_LINE

; ===== Mnemonic Recognition =====
P2_ENCODE:
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
FELLOWSHIP R12, R4        ; Save R4 starting position for NOT_xxx restore
; Check 'ABOUND'
ABOUND R2, 65
XOR R1, R2
BRANCH R1, NOT_ABOUND
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 66
XOR R1, R2
BRANCH R1, NOT_ABOUND
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 79
XOR R1, R2
BRANCH R1, NOT_ABOUND
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 85
XOR R1, R2
BRANCH R1, NOT_ABOUND
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 78
XOR R1, R2
BRANCH R1, NOT_ABOUND
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 68
XOR R1, R2
ABOUND R2, 1
INCREASE R4, R2
ABOUND R11, 13
FELLOWSHIP R11, R11
BRANCH R2, P2_PARSE_OPERANDS
NOT_ABOUND:
FELLOWSHIP R4, R12        ; Restore R4 to line start using saved R12
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
; Check 'ALLOC'
ABOUND R2, 65
XOR R1, R2
BRANCH R1, NOT_ALLOC
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 76
XOR R1, R2
BRANCH R1, NOT_ALLOC
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 76
XOR R1, R2
BRANCH R1, NOT_ALLOC
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 79
XOR R1, R2
BRANCH R1, NOT_ALLOC
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 67
XOR R1, R2
ABOUND R2, 1
INCREASE R4, R2
ABOUND R11, 17
FELLOWSHIP R11, R11
BRANCH R2, P2_PARSE_OPERANDS
NOT_ALLOC:
FELLOWSHIP R4, R12        ; Restore R4 to line start using saved R12
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
; Check 'BRANCH'
ABOUND R2, 66
XOR R1, R2
BRANCH R1, NOT_BRANCH
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 82
XOR R1, R2
BRANCH R1, NOT_BRANCH
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 65
XOR R1, R2
BRANCH R1, NOT_BRANCH
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 78
XOR R1, R2
BRANCH R1, NOT_BRANCH
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 67
XOR R1, R2
BRANCH R1, NOT_BRANCH
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 72
XOR R1, R2
ABOUND R2, 1
INCREASE R4, R2
ABOUND R11, 2
FELLOWSHIP R11, R11
BRANCH R2, P2_PARSE_OPERANDS
NOT_BRANCH:
FELLOWSHIP R4, R12        ; Restore R4 to line start using saved R12
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
; Check 'CREA'
ABOUND R2, 67
XOR R1, R2
BRANCH R1, NOT_CREA
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 82
XOR R1, R2
BRANCH R1, NOT_CREA
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 69
XOR R1, R2
BRANCH R1, NOT_CREA
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 65
XOR R1, R2
ABOUND R2, 1
INCREASE R4, R2
ABOUND R11, 63
FELLOWSHIP R11, R11
BRANCH R2, P2_PARSE_OPERANDS
NOT_CREA:
FELLOWSHIP R4, R12        ; Restore R4 to line start using saved R12
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
; Check 'DISPERSE'
ABOUND R2, 68
XOR R1, R2
BRANCH R1, NOT_DISPERSE
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 73
XOR R1, R2
BRANCH R1, NOT_DISPERSE
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 83
XOR R1, R2
BRANCH R1, NOT_DISPERSE
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 80
XOR R1, R2
BRANCH R1, NOT_DISPERSE
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 69
XOR R1, R2
BRANCH R1, NOT_DISPERSE
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 82
XOR R1, R2
BRANCH R1, NOT_DISPERSE
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 83
XOR R1, R2
BRANCH R1, NOT_DISPERSE
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 69
XOR R1, R2
ABOUND R2, 1
INCREASE R4, R2
ABOUND R11, 50
FELLOWSHIP R11, R11
BRANCH R2, P2_PARSE_OPERANDS
NOT_DISPERSE:
FELLOWSHIP R4, R12        ; Restore R4 to line start using saved R12
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
; Check 'FELLOWSHIP'
ABOUND R2, 70
XOR R1, R2
BRANCH R1, NOT_FELLOWSHIP
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 69
XOR R1, R2
BRANCH R1, NOT_FELLOWSHIP
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 76
XOR R1, R2
BRANCH R1, NOT_FELLOWSHIP
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 76
XOR R1, R2
BRANCH R1, NOT_FELLOWSHIP
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 79
XOR R1, R2
BRANCH R1, NOT_FELLOWSHIP
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 87
XOR R1, R2
BRANCH R1, NOT_FELLOWSHIP
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 83
XOR R1, R2
BRANCH R1, NOT_FELLOWSHIP
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 72
XOR R1, R2
BRANCH R1, NOT_FELLOWSHIP
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 73
XOR R1, R2
BRANCH R1, NOT_FELLOWSHIP
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 80
XOR R1, R2
ABOUND R2, 1
INCREASE R4, R2
ABOUND R11, 61
FELLOWSHIP R11, R11
BRANCH R2, P2_PARSE_OPERANDS
NOT_FELLOWSHIP:
FELLOWSHIP R4, R12        ; Restore R4 to line start using saved R12
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
; Check 'GATHER'
ABOUND R2, 71
XOR R1, R2
BRANCH R1, NOT_GATHER
ABOUND R2, 1
INCREASE R4, R2
ABOUND R1, 16
ABOUND R2, 16
REDUCE R1, R2
FELLOWSHIP R1, R0
PENETRATE R4, R1
ABOUND R2, 65
XOR R1, R2
