NOT_XOR:
    ; Unknown mnemonic - skip line
P2_SKIP_LINE2:
    ABOUND R2, 1
    INCREASE R4, R2
    LOADB R1, R4
    BRANCH R1, P2_SL2_CONT
    BRANCH R2, P2_END
P2_SL2_CONT:
    ABOUND R2, CHAR_NL
    XOR R1, R2
    BRANCH R1, P2_SKIP_LINE2
    BRANCH R2, P2_LINE

    ; ===== Emit 4-byte instruction =====
P2_EMIT:
    ; byte1 = opcode << 2
    ABOUND R3, 1      ; shift amount (R3 corrupted by long jump code)
    FELLOWSHIP R1, R11
    SHL R1, R3
    SHL R1, R3
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ; byte2 = 0, byte3 = 0, byte4 = 0 (no operands parsed)
    WB0
    WB0
    WB0
    ; addr += 4
    ABOUND R2, 4
    INCREASE R7, R2

    ; Skip to next line
P2_TO_NL:
    LOADB R1, R4
    BRANCH R1, P2_TNL_CONT
    BRANCH R2, P2_END
P2_TNL_CONT:
    ABOUND R2, 1
    INCREASE R4, R2
    ABOUND R2, CHAR_NL
    XOR R1, R2
    BRANCH R1, P2_TO_NL
    BRANCH R2, P2_LINE

P2_END:
    ; Pass 2 complete

DONE:
    ; Calculate output size: R5 - R9
    FELLOWSHIP R1, R5
    REDUCE R1, R9
    FELLOWSHIP R13, R1

    ; Build 'output.evob' filename
    ALLOC R0, 0
    FELLOWSHIP R10, R0     ; Save base for later SYS_OPEN (R14 corrupt by long jumps)
    FELLOWSHIP R5, R0
    ABOUND R1, 111
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ABOUND R1, 117
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ABOUND R1, 116
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ABOUND R1, 112
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ABOUND R1, 117
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ABOUND R1, 116
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ABOUND R1, 46
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ABOUND R1, 101
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ABOUND R1, 118
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ABOUND R1, 111
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ABOUND R1, 98
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    WB0

    ; Open output file
    ABOUND R0, SYS_OPEN
    FELLOWSHIP R1, R10     ; Use saved base (R5 was advanced by wb())
    ABOUND R2, MODE_WRITE
    RECV R0, 0
    FELLOWSHIP R12, R0

    ; Write bytecode
    ABOUND R0, SYS_WRITE
    FELLOWSHIP R1, R12
    FELLOWSHIP R2, R9
    FELLOWSHIP R3, R13
    RECV R0, 0

    ; Close & exit
    ABOUND R0, SYS_CLOSE
    FELLOWSHIP R1, R12
    RECV R0, 0
    ABOUND R0, SYS_EXIT
    RECV R0, 0
HALT