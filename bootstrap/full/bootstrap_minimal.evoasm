WRITE_FAILED:
    ; 打印错误信息
    ALLOC R0, 0
    FELLOWSHIP R10, R0

; 字符串: 'ERROR: Failed to open output file\n'
    ABOUND R1, 69
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 82
    DISPERSE R10, R1
    ABOUND R2, 1
