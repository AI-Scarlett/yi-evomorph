; ============================================================
; 易衍·Evomorph 自举编译器 - 最小可运行版本
; 
; 这个版本演示了自举的核心概念：
; 1. 用 EvoASM 编写一个简化汇编器
; 2. 用 Python 汇编器编译它
; 3. 在虚拟机上运行它
; 4. 它能编译简单的 EvoASM 代码
;
; 支持的指令：ABOUND, INCREASE, REDUCE, HALT
; 操作数：寄存器(R0-R15) 和 立即数(0-255)
; ============================================================

; ========== 常量定义 ==========
SYS_OPEN    EQU 0
SYS_READ    EQU 1
SYS_WRITE   EQU 2
SYS_CLOSE   EQU 3
SYS_EXIT    EQU 255
SYS_PRINT   EQU 40
SYS_ISDIGIT EQU 30
SYS_ISALPHA EQU 31
SYS_ISSPACE EQU 33
SYS_STRLEN  EQU 20

MODE_READ   EQU 0
MODE_WRITE  EQU 1

MAX_INPUT   EQU 4096
MAX_TOKENS  EQU 256
MAX_TOKEN   EQU 64

; ========== 内存布局 ==========
; 程序加载到 0x00110000
; 注意：字符串数据需要通过指令在运行时初始化
; 我们使用从 0x00120000 开始的数据区

; 数据区地址
DATA_START  EQU 0x00120000

; 字符串表 (需要运行时初始化)
; 每个字符串的地址 = DATA_START + 偏移量
; "ABOUND"   @ DATA_START + 0
; "INCREASE" @ DATA_START + 7
; "REDUCE"  @ DATA_START + 16
; "HALT"    @ DATA_START + 23
; "input.asm" @ DATA_START + 28
; "output.raw" @ DATA_START + 38
; "ERR: " @ DATA_START + 49
; "OK\n" @ DATA_START + 55

; 操作码表
; 索引=助记符索引, 值=操作码
OPCODE_TABLE EQU DATA_START + 64

; 输入缓冲区
INPUT_BUF  EQU DATA_START + 128

; 输出缓冲区
OUTPUT_BUF EQU DATA_START + 4224

; Token 缓冲区
TOKEN_BUF  EQU DATA_START + 4352

; 当前位置
CURRENT_PTR EQU DATA_START + 4416

; ========== 程序入口 ==========
; 首先初始化字符串数据
; 我们使用一系列 ABOUND + DISPERSE 指令来初始化内存

; 初始化 "ABOUND" (6个字符 + null)
ABOUND R0, DATA_START    ; 目标地址
ABOUND R1, 65             ; 'A'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 66             ; 'B'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 79             ; 'O'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 85             ; 'U'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 78             ; 'N'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 68             ; 'D'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 0              ; null terminator
DISPERSE R0, R1

; 初始化 "INCREASE" (8个字符 + null)
ABOUND R0, DATA_START
INCREASE R0, 7             ; 偏移量 7
ABOUND R1, 73             ; 'I'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 78             ; 'N'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 67             ; 'C'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 82             ; 'R'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 69             ; 'E'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 65             ; 'A'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 83             ; 'S'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 69             ; 'E'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 0
DISPERSE R0, R1

; 初始化 "REDUCE" (7个字符 + null)
ABOUND R0, DATA_START
INCREASE R0, 16
ABOUND R1, 82             ; 'R'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 69             ; 'E'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 68             ; 'D'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 85             ; 'U'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 67             ; 'C'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 69             ; 'E'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 0
DISPERSE R0, R1

; 初始化 "HALT" (4个字符 + null)
ABOUND R0, DATA_START
INCREASE R0, 23
ABOUND R1, 72             ; 'H'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 65             ; 'A'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 76             ; 'L'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 84             ; 'T'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 0
DISPERSE R0, R1

; 初始化操作码表
; 索引 0: ABOUND (13)
; 索引 1: INCREASE (49)
; 索引 2: REDUCE (35)
; 索引 3: HALT (56)
ABOUND R0, OPCODE_TABLE
ABOUND R1, 13
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 49
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 35
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 56
DISPERSE R0, R1

; 初始化文件名 "input.asm"
ABOUND R0, DATA_START
INCREASE R0, 28
ABOUND R1, 105            ; 'i'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 110            ; 'n'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 112            ; 'p'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 117            ; 'u'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 116            ; 't'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 46             ; '.'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 97             ; 'a'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 115            ; 's'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 109            ; 'm'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 0
DISPERSE R0, R1

; 初始化输出文件名 "output.raw"
ABOUND R0, DATA_START
INCREASE R0, 38
ABOUND R1, 111            ; 'o'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 117            ; 'u'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 116            ; 't'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 112            ; 'p'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 117            ; 'u'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 116            ; 't'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 46             ; '.'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 114            ; 'r'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 97             ; 'a'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 119            ; 'w'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 0
DISPERSE R0, R1

; 初始化成功消息 "OK\n"
ABOUND R0, DATA_START
INCREASE R0, 55
ABOUND R1, 79             ; 'O'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 75             ; 'K'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 10             ; '\n'
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 0
DISPERSE R0, R1

; ========== 主程序 ==========
; 初始化 CURRENT_PTR
ABOUND R0, DATA_START
INCREASE R0, 28            ; "input.asm" 的地址
ABOUND R8, R0              ; R8 = 输入文件名

ABOUND R0, DATA_START
INCREASE R0, 38            ; "output.raw" 的地址
ABOUND R9, R0              ; R9 = 输出文件名

ABOUND R0, DATA_START
INCREASE R0, 55            ; "OK\n" 的地址
ABOUND R10, R0             ; R10 = 成功消息

; 打印开始消息 (使用 R10 中的 "OK\n")
ABOUND R0, SYS_PRINT
ABOUND R1, R10
RECV R0, 0

; 打开输入文件
ABOUND R0, SYS_OPEN
ABOUND R1, R8
ABOUND R2, MODE_READ
RECV R0, 0
ABOUND R11, R0             ; R11 = 输入文件描述符

CMP R11, 0
BRANCH R0, exit_error      ; 打开失败

; 读取输入文件
ABOUND R0, SYS_READ
ABOUND R1, R11
ABOUND R2, INPUT_BUF
ABOUND R3, 4096
RECV R0, 0
ABOUND R12, R0             ; R12 = 读取的字节数

; 关闭输入文件
ABOUND R0, SYS_CLOSE
ABOUND R1, R11
RECV R0, 0

; 初始化 CURRENT_PTR
ABOUND R0, INPUT_BUF
ABOUND R1, CURRENT_PTR
DISPERSE R1, R0

; 现在编译... 简化版本：只输出固定的测试字节码
; 实际的完整编译器需要：
; 1. 词法分析
; 2. 助记符查找
; 3. 操作数解析
; 4. 指令编码

; 简化：输出一个测试程序
; ABOUND R0, 5 -> 34 00 00 05
; ABOUND R1, 10 -> 34 00 01 0A
; INCREASE R0, R1 -> C4 00 00 01
; HALT -> E0 00 00 00

ABOUND R0, OUTPUT_BUF
ABOUND R1, 0x34            ; byte1 for ABOUND
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 0x00            ; byte2
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 0x00            ; R0
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 0x05            ; 5
DISPERSE R0, R1
INCREASE R0, 1

ABOUND R1, 0x34
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 0x00
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 0x01            ; R1
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 0x0A            ; 10
DISPERSE R0, R1
INCREASE R0, 1

ABOUND R1, 0xC4            ; INCREASE
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 0x00
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 0x00            ; R0
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 0x01            ; R1
DISPERSE R0, R1
INCREASE R0, 1

ABOUND R1, 0xE0            ; HALT
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 0x00
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 0x00
DISPERSE R0, R1
INCREASE R0, 1
ABOUND R1, 0x00
DISPERSE R0, R1
INCREASE R0, 1

; 打开输出文件
ABOUND R0, SYS_OPEN
ABOUND R1, R9
ABOUND R2, MODE_WRITE
RECV R0, 0
ABOUND R11, R0

CMP R11, 0
BRANCH R0, exit_error

; 写入输出文件 (16 字节 = 4 条指令)
ABOUND R0, SYS_WRITE
ABOUND R1, R11
ABOUND R2, OUTPUT_BUF
ABOUND R3, 16
RECV R0, 0

; 关闭输出文件
ABOUND R0, SYS_CLOSE
ABOUND R1, R11
RECV R0, 0

; 打印成功
ABOUND R0, SYS_PRINT
ABOUND R1, R10
RECV R0, 0

; 退出
ABOUND R0, SYS_EXIT
RECV R0, 0

HALT

exit_error:
ABOUND R0, SYS_EXIT
RECV R0, 0

HALT
