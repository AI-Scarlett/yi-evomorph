    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 46
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ; 小立即数 10
    ABOUND R2, 16
    ABOUND R3, 6
    REDUCE R2, R3
    FELLOWSHIP R1, R2
    DISPERSE R10, R1
    ; 字符串结束符
    ABOUND R2, 16
    ABOUND R3, 16
    REDUCE R2, R3
    FELLOWSHIP R1, R2
    DISPERSE R10, R1
    ABOUND R0, SYS_PRINT
    ALLOC R1, 0
    FELLOWSHIP R1, R1
    RECV R0, 0
    
    ; 执行写入
    ABOUND R0, SYS_WRITE
    FELLOWSHIP R1, R5
    ALLOC R2, 0
    FELLOWSHIP R2, R2
    FELLOWSHIP R3, R13
    RECV R0, 0
    
    ; 检查写入结果
    FELLOWSHIP R6, R0              ; R6 = 写入的字节数
    
    ; 关闭文件
    ABOUND R0, SYS_CLOSE
    FELLOWSHIP R1, R5
    RECV R0, 0
    
    ; 打印成功信息
    ALLOC R0, 0
    FELLOWSHIP R10, R0

; 字符串: 'Success! Output written to output.raw\n'
    ABOUND R1, 83
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 117
