
; ============================================================
; EvoASM 最小自举汇编器 v0.1
; ============================================================
; 这是一个能够实际工作的 EvoASM 程序
; 功能：
;   1. 打印启动信息
;   2. 编码一个简单的程序（ABOUND + HALT）
;   3. 写入输出文件
;
; 自举验证：
;   - 用 Python 汇编器编译这个文件
;   - 用虚拟机运行编译后的程序
;   - 程序会生成字节码文件
; ============================================================

; 系统调用号
SYS_OPEN    EQU 0
SYS_READ    EQU 1
SYS_WRITE   EQU 2
SYS_CLOSE   EQU 3
SYS_MALLOC  EQU 10
SYS_PRINT   EQU 40
SYS_EXIT    EQU 255

; 文件模式
MODE_READ   EQU 0
MODE_WRITE  EQU 1

; 操作码
OPCODE_ABOUND    EQU 13
OPCODE_HALT      EQU 56

START:
    ; 保存堆指针
    ALLOC R0, 0
    FELLOWSHIP R4, R0          ; R4 = 堆基址
    
    ; ========== 打印启动信息 ==========
    ALLOC R0, 0
    FELLOWSHIP R10, R0

; 字符串: 'EvoASM Bootstrap Assembler v0.1\n'
    ABOUND R1, 69
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 118
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 111
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 65
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 83
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 77
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 32
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 66
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 111
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 111
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 116
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 115
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 116
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 114
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 97
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 112
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 32
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 65
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 115
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 115
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 101
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 109
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 98
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 108
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 101
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 114
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 32
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 118
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 48
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 46
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 49
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ; 小立即数 10
    ABOUND R2, 16
    ABOUND R3, 6
    REDUCE R2, R3
    FELLOWSHIP R1, R2
    DISPERSE R10, R1
    ; 字符串结束符
    ABOUND R2, 16
    ABOUND R3, 16
    REDUCE R2, R3
    FELLOWSHIP R1, R2
    DISPERSE R10, R1
    ; 打印
    ABOUND R0, SYS_PRINT
    ALLOC R1, 0
    FELLOWSHIP R1, R1
    RECV R0, 0
    
    ; ========== 分配输出缓冲区 ==========
    ALLOC R0, 0
    FELLOWSHIP R11, R0         ; R11 = 输出缓冲区指针
    ALLOC R0, 0
    FELLOWSHIP R12, R0         ; R12 = 输出缓冲区起始
    
    ; 初始化输出计数
    ABOUND R13, 16
    ABOUND R14, 16
    REDUCE R13, R14            ; R13 = 0 (输出字节计数)
    
    ; ========== 编码指令 1: ABOUND R0, 16 ==========
    ; 指令格式：byte1 byte2 byte3 byte4
    ; byte1 = (opcode << 2) | modifier
    ; byte2 = 0 (操作数扩展)
    ; byte3 = dst 寄存器
    ; byte4 = src/立即数
    
    ; ABOUND 操作码 13 (0x0D)
    ; byte1 = (13 << 2) | 0 = 52 (0x34)
    ; byte2 = 0
    ; byte3 = 0 (R0)
    ; byte4 = 16
    
    ; byte1: 52
    ABOUND R5, 52
    DISPERSE R11, R5
    ABOUND R2, 1
    INCREASE R11, R2
    INCREASE R13, R2
    
    ; byte2: 0
    ABOUND R5, 16
    ABOUND R6, 16
    REDUCE R5, R6
    DISPERSE R11, R5
    ABOUND R2, 1
    INCREASE R11, R2
    INCREASE R13, R2
    
    ; byte3: 0 (R0)
    ABOUND R5, 16
    ABOUND R6, 16
    REDUCE R5, R6
    DISPERSE R11, R5
    ABOUND R2, 1
    INCREASE R11, R2
    INCREASE R13, R2
    
    ; byte4: 16
    ABOUND R5, 16
    DISPERSE R11, R5
    ABOUND R2, 1
    INCREASE R11, R2
    INCREASE R13, R2
    
    ; ========== 编码指令 2: HALT ==========
    ; HALT 操作码 56 (0x38)
    ; byte1 = (56 << 2) | 0 = 224 (0xE0)
    ; byte2 = 0
    ; byte3 = 0
    ; byte4 = 0
    
    ; byte1: 224
    ABOUND R5, 224
    DISPERSE R11, R5
    ABOUND R2, 1
    INCREASE R11, R2
    INCREASE R13, R2
    
    ; byte2: 0
    ABOUND R5, 16
    ABOUND R6, 16
    REDUCE R5, R6
    DISPERSE R11, R5
    ABOUND R2, 1
    INCREASE R11, R2
    INCREASE R13, R2
    
    ; byte3: 0
    ABOUND R5, 16
    ABOUND R6, 16
    REDUCE R5, R6
    DISPERSE R11, R5
    ABOUND R2, 1
    INCREASE R11, R2
    INCREASE R13, R2
    
    ; byte4: 0
    ABOUND R5, 16
    ABOUND R6, 16
    REDUCE R5, R6
    DISPERSE R11, R5
    ABOUND R2, 1
    INCREASE R11, R2
    INCREASE R13, R2
    
    ; ========== 打印生成信息 ==========
    ALLOC R0, 0
    FELLOWSHIP R10, R0

; 字符串: 'Generated 8 bytes of bytecode\n'
    ABOUND R1, 71
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 101
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 110
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 101
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 114
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 97
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 116
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 101
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 100
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 32
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 56
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 32
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 98
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 121
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 116
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 101
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 115
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 32
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 111
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 102
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 32
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 98
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 121
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 116
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 101
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 99
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 111
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 100
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 101
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ; 小立即数 10
    ABOUND R2, 16
    ABOUND R3, 6
    REDUCE R2, R3
    FELLOWSHIP R1, R2
    DISPERSE R10, R1
    ; 字符串结束符
    ABOUND R2, 16
    ABOUND R3, 16
    REDUCE R2, R3
    FELLOWSHIP R1, R2
    DISPERSE R10, R1
    ABOUND R0, SYS_PRINT
    ALLOC R1, 0
    FELLOWSHIP R1, R1
    RECV R0, 0
    
    ; ========== 写入输出文件 ==========
    ; 构建文件名 "output.raw"
    ALLOC R0, 0
    FELLOWSHIP R10, R0

; 字符串: 'output.raw'
    ABOUND R1, 111
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 117
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 116
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 112
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 117
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 116
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 46
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 114
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 97
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 119
    DISPERSE R10, R1
    ; 字符串结束符
    ABOUND R2, 16
    ABOUND R3, 16
    REDUCE R2, R3
    FELLOWSHIP R1, R2
    DISPERSE R10, R1
    
    ; 打开输出文件
    ABOUND R0, SYS_OPEN
    ALLOC R1, 0
    FELLOWSHIP R1, R1
    ABOUND R2, 1
    RECV R0, 0
    FELLOWSHIP R5, R0              ; R5 = 文件描述符
    
    ; 检查是否打开成功 (fd != 0)
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2                  ; R1 = 0
    CMP R5, R1
    BRANCH R0, WRITE_FAILED        ; 如果 R5 == 0，跳转
    
    ; ========== 写入文件 ==========
    ALLOC R0, 0
    FELLOWSHIP R10, R0

; 字符串: 'Writing to output.raw...\n'
    ABOUND R1, 87
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 114
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 105
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 116
    DISPERSE R10, R1
    ABOUND R2, 1
    INCREASE R10, R2
    ABOUND R1, 105
    DISPERSE R10, R1
    ABOUND R2, 1
