; 验证基础指令
; 测试 ABOUND、PREFETCH、MICRO、INCREASE 等指令

SYS_PRINT   EQU 40
SYS_EXIT    EQU 255

START:
    ; 测试 1: ABOUND R5, 3
    ; 期望: R5 = 3
    ABOUND R5, 3
    
    ; 测试 2: ABOUND R6, 8
    ; 期望: R6 = 8
    ABOUND R6, 8
    
    ; 测试 3: PREFETCH R5, R6 (R5 = R5 << R6)
    ; 期望: R5 = 3 << 8 = 768
    PREFETCH R5, R6
    
    ; 测试 4: MICRO R5, 44 (R5 = R5 + 44)
    ; 期望: R5 = 768 + 44 = 812
    MICRO R5, 44
    
    ; 现在 R5 应该是 812
    ; 让我们打印 R5 的值（以十六进制）
    ; 但首先，让我们检查一下是否可以跳转到已知地址
    
    ; 设置条件寄存器
    ABOUND R1, 1
    
    ; 尝试跳转到地址 0（START）
    ; 但这会导致无限循环...
    
    ; 让我们直接打印结果
    ; 首先，将 R5 转换为字符串
    ; 但这很复杂...
    
    ; 替代方案：让我们检查 R5 的值是否正确
    ; 如果 R5 = 812，跳转到 SUCCESS
    ; 否则，跳转到 FAIL
    
    ; 但我们不知道 SUCCESS 和 FAIL 的地址...
    
    ; 让我们使用一种更简单的方法：
    ; 如果 R5 = 812，打印 "OK"
    ; 否则，打印 "FAIL"
    
    ; 首先，检查 R5 = 812?
    ; 我们可以使用 CMP 指令，但需要确认它的行为
    
    ; 让我们先尝试一个简单的方法：
    ; 直接跳转到 SUCCESS，如果 R5 正确，它会打印 "OK"
    ; 但我们不知道 SUCCESS 的地址...
    
    ; 让我们重新设计：
    ; 使用固定的偏移量
    
    ; 替代方案：让我们直接打印寄存器值的调试信息
    ; 但我们没有这样的系统调用...
    
    ; 让我们尝试一种不同的方法：
    ; 如果 R5 = 812，那么 R5 = 0x032C
    ; 让我们检查 R5 的低字节是否为 0x2C (44)
    ; 和高字节是否为 0x03 (3)
    
    ; 但这很复杂...
    
    ; 让我们尝试最简单的方法：
    ; 直接使用 HALT 停止，然后检查寄存器状态
    
    ; 但首先，让我们确认一下各个指令的行为
    
    ; 让我们先打印 "Test\n"
    ALLOC R0, 0
    FELLOWSHIP R4, R0
    
    ; 'T' = 84
    ABOUND R1, 84
    DISPERSE R4, R1
    
    ; 指针加1
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 'e' = 101
    ABOUND R1, 101
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 's' = 115
    ABOUND R1, 115
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 't' = 116
    ABOUND R1, 116
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; '\n' = 10
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; '\0' = 0
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2
    DISPERSE R4, R1
    
    ; 打印
    ABOUND R0, SYS_PRINT
    ALLOC R4, 0
    FELLOWSHIP R1, R4
    RECV R0, 0
    
    ; 现在停止，检查寄存器状态
    HALT

; 成功标签
SUCCESS:
    ; 打印 "OK\n"
    ALLOC R0, 0
    FELLOWSHIP R4, R0
    
    ; 'O' = 79
    ABOUND R1, 79
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 'K' = 75
    ABOUND R1, 75
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; '\n' = 10
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; '\0' = 0
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2
    DISPERSE R4, R1
    
    ; 打印
    ABOUND R0, SYS_PRINT
    ALLOC R4, 0
    FELLOWSHIP R1, R4
    RECV R0, 0
    
    ; 退出
    ABOUND R0, SYS_EXIT
    RECV R0, 0

; 失败标签
FAIL:
    ; 打印 "FAIL\n"
    ALLOC R0, 0
    FELLOWSHIP R4, R0
    
    ; 'F' = 70
    ABOUND R1, 70
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 'A' = 65
    ABOUND R1, 65
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 'I' = 73
    ABOUND R1, 73
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; 'L' = 76
    ABOUND R1, 76
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; '\n' = 10
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2
    DISPERSE R4, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R4, R1
    
    ; '\0' = 0
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2
    DISPERSE R4, R1
    
    ; 打印
    ABOUND R0, SYS_PRINT
    ALLOC R4, 0
    FELLOWSHIP R1, R4
    RECV R0, 0
    
    ; 退出
    ABOUND R0, SYS_EXIT
    RECV R0, 0

HALT
