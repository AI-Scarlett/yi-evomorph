; 测试 SHL 指令

SYS_PRINT   EQU 40
SYS_EXIT    EQU 255

START:
    ; 测试 ABOUND R5, 1
    ABOUND R5, 1
    
    ; 测试 ABOUND R6, 8
    ABOUND R6, 8
    
    ; 测试 SHL R5, R6 (R5 = 1 << 8 = 256)
    SHL R5, R6
    
    ; 测试 MICRO R5, 100 (R5 = 256 + 100 = 356)
    MICRO R5, 100
    
    ; 现在 R5 应该是 356
    ; 让我们检查一下 - 打印 R5 的值
    
    ; 但是我们没有打印数字的系统调用...
    ; 让我们用 R5 作为循环计数器
    
    ; 如果 R5 = 356，让我们检查 R5 > 255
    ; ABOUND 只能加载 0-255，所以如果 R5 > 255，它一定是通过 SHL+MICRO 计算的
    
    ; 让我们尝试：如果 R5 > 255，跳转到 SUCCESS
    ; 我们可以用 BRANCH 来测试
    
    ; 先设置条件寄存器
    ; R7 = 255
    ABOUND R7, 255
    
    ; R8 = R5 - R7 (如果 R5 > 255，R8 != 0)
    ; 但是我们没有 SUB 指令...
    ; 让我们用 REDUCE (按位与)
    
    ; R7 = 0xFF00 (高8位非零)
    ; ABOUND 只能加载 8 位，所以我们需要构建
    ; R7 = (0xFF << 8) = 0xFF00
    
    ; ABOUND R7, 255
    ABOUND R7, 255
    
    ; ABOUND R8, 8
    ABOUND R8, 8
    
    ; SHL R7, R8 → R7 = 0xFF00
    SHL R7, R8
    
    ; REDUCE R5, R7 → R5 = R5 & R7
    ; 如果 R5 > 255，结果 != 0
    REDUCE R5, R7
    
    ; 如果 R5 != 0，跳转到 SUCCESS
    BRANCH R5, SUCCESS
    
    ; 如果 R5 = 0，打印 "Test failed\n"
    ALLOC R0, 0
    FELLOWSHIP R4, R0
    FELLOWSHIP R10, R4
    
    ; 'T' = 84
    ABOUND R1, 84
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'e' = 101
    ABOUND R1, 101
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 's' = 115
    ABOUND R1, 115
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 't' = 116
    ABOUND R1, 116
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; ' ' = 32
    ABOUND R1, 32
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'f' = 102
    ABOUND R1, 102
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'a' = 97
    ABOUND R1, 97
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'i' = 105
    ABOUND R1, 105
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'l' = 108
    ABOUND R1, 108
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'e' = 101
    ABOUND R1, 101
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'd' = 100
    ABOUND R1, 100
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '\n' = 10
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '\0' = 0
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2
    DISPERSE R10, R1
    
    ; 打印
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R4
    RECV R0, 0
    
    ; 退出
    ABOUND R0, SYS_EXIT
    RECV R0, 0

SUCCESS:
    ; 打印 "Test success!\n"
    ALLOC R0, 0
    FELLOWSHIP R4, R0
    FELLOWSHIP R10, R4
    
    ; 'T' = 84
    ABOUND R1, 84
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'e' = 101
    ABOUND R1, 101
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 's' = 115
    ABOUND R1, 115
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 't' = 116
    ABOUND R1, 116
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; ' ' = 32
    ABOUND R1, 32
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 's' = 115
    ABOUND R1, 115
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'u' = 117
    ABOUND R1, 117
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'c' = 99
    ABOUND R1, 99
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'c' = 99
    ABOUND R1, 99
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'e' = 101
    ABOUND R1, 101
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 's' = 115
    ABOUND R1, 115
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 's' = 115
    ABOUND R1, 115
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '!' = 33
    ABOUND R1, 33
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '\n' = 10
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '\0' = 0
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2
    DISPERSE R10, R1
    
    ; 打印
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R4
    RECV R0, 0
    
    ; 退出
    ABOUND R0, SYS_EXIT
    RECV R0, 0

HALT
