; 测试 .ASYNC BRANCH 寄存器间接跳转
; 手动编写长跳转代码

SYS_PRINT   EQU 40
SYS_EXIT    EQU 255

START:
    ; 打印 "Start\n"
    ALLOC R0, 0
    FELLOWSHIP R4, R0
    FELLOWSHIP R10, R4
    
    ; 'S' = 83
    ABOUND R1, 83
    DISPERSE R10, R1
    
    ; 指针加1
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2      ; R1 = 1
    INCREASE R10, R1
    
    ; 't' = 116
    ABOUND R1, 116
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'a' = 97
    ABOUND R1, 97
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'r' = 114
    ABOUND R1, 114
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 't' = 116
    ABOUND R1, 116
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '\n' = 10
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '\0' = 0
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2
    DISPERSE R10, R1
    
    ; 打印
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R4
    RECV R0, 0
    
    ; ============================================
    ; 手动计算 TARGET 的地址
    ; 让我们先尝试跳转到 NEAR_TARGET（应该在255字节范围内）
    ; ============================================
    
    ; 设置条件寄存器 R1 = 1
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2      ; R1 = 1
    
    ; 尝试直接跳转
    BRANCH R1, NEAR_TARGET
    
    ; 如果跳转失败，打印 "Direct jump failed\n"
    ALLOC R0, 0
    FELLOWSHIP R4, R0
    FELLOWSHIP R10, R4
    
    ; 'D' = 68
    ABOUND R1, 68
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'i' = 105
    ABOUND R1, 105
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'r' = 114
    ABOUND R1, 114
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'e' = 101
    ABOUND R1, 101
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'c' = 99
    ABOUND R1, 99
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 't' = 116
    ABOUND R1, 116
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; ' ' = 32
    ABOUND R1, 32
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'j' = 106
    ABOUND R1, 106
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'u' = 117
    ABOUND R1, 117
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'm' = 109
    ABOUND R1, 109
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'p' = 112
    ABOUND R1, 112
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; ' ' = 32
    ABOUND R1, 32
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'f' = 102
    ABOUND R1, 102
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'a' = 97
    ABOUND R1, 97
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'i' = 105
    ABOUND R1, 105
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'l' = 108
    ABOUND R1, 108
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'e' = 101
    ABOUND R1, 101
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'd' = 100
    ABOUND R1, 100
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '\n' = 10
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '\0' = 0
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2
    DISPERSE R10, R1
    
    ; 打印
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R4
    RECV R0, 0
    
    ; 退出
    ABOUND R0, SYS_EXIT
    RECV R0, 0

; 近目标 - 应该在255字节范围内？
NEAR_TARGET:
    ; 现在尝试使用寄存器间接跳转到 TARGET
    ; 首先，我们需要知道 TARGET 的地址
    ; 但我们不知道...
    
    ; 让我们尝试另一种方法：
    ; 在 NEAR_TARGET 中，我们知道我们在内存中的位置
    ; 我们可以计算到 TARGET 的偏移量
    
    ; 但是这很复杂...
    
    ; 让我们先检查 NEAR_TARGET 是否可达
    ; 打印 "Near target reached\n"
    ALLOC R0, 0
    FELLOWSHIP R4, R0
    FELLOWSHIP R10, R4
    
    ; 'N' = 78
    ABOUND R1, 78
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'e' = 101
    ABOUND R1, 101
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
