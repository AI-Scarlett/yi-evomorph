; 易衍·Evomorph 简单测试程序
; 测试核心指令和系统调用

; 系统调用常量
SYS_PRINT   EQU 40
SYS_EXIT    EQU 255
SYS_MALLOC  EQU 10

; 主程序入口
MAIN:
    ; 分配缓冲区
    ALLOC R0, 32           ; R0 = 缓冲区地址
    FELLOWSHIP R4, R0       ; R4 = 缓冲区地址
    
    ; 构建字符串 "Hello, Evomorph!\n"
    ABOUND R0, 0x48         ; 'H'
    DISPERSE R4, R0, 0
    ABOUND R0, 0x65         ; 'e'
    DISPERSE R4, R0, 1
    ABOUND R0, 0x6C         ; 'l'
    DISPERSE R4, R0, 2
    ABOUND R0, 0x6C         ; 'l'
    DISPERSE R4, R0, 3
    ABOUND R0, 0x6F         ; 'o'
    DISPERSE R4, R0, 4
    ABOUND R0, 0x2C         ; ','
    DISPERSE R4, R0, 5
    ABOUND R0, 0x20         ; ' '
    DISPERSE R4, R0, 6
    ABOUND R0, 0x45         ; 'E'
    DISPERSE R4, R0, 7
    ABOUND R0, 0x76         ; 'v'
    DISPERSE R4, R0, 8
    ABOUND R0, 0x6F         ; 'o'
    DISPERSE R4, R0, 9
    ABOUND R0, 0x6D         ; 'm'
    DISPERSE R4, R0, 10
    ABOUND R0, 0x6F         ; 'o'
    DISPERSE R4, R0, 11
    ABOUND R0, 0x72         ; 'r'
    DISPERSE R4, R0, 12
    ABOUND R0, 0x70         ; 'p'
    DISPERSE R4, R0, 13
    ABOUND R0, 0x68         ; 'h'
    DISPERSE R4, R0, 14
    ABOUND R0, 0x21         ; '!'
    DISPERSE R4, R0, 15
    ABOUND R0, 0x0A         ; '\n'
    DISPERSE R4, R0, 16
    ABOUND R0, 0x00         ; '\0'
    DISPERSE R4, R0, 17
    
    ; 打印字符串
    FELLOWSHIP R0, R4
    RECV R0, R0, SYS_PRINT
    
    ; 测试加法
    ABOUND R5, 10
    ABOUND R6, 20
    INCREASE R5, R6          ; R5 = 10 + 20 = 30
    
    ; 测试减法
    ABOUND R7, 50
    ABOUND R8, 20
    REDUCE R7, R8            ; R7 = 50 - 20 = 30
    
    ; 测试条件分支
    ; 如果 R5 == R7 (都等于30)，跳转到 SUCCESS
    ; 首先计算 R5 - R7 = 0
    ABOUND R9, 0
    FELLOWSHIP R10, R5
    REDUCE R10, R7           ; R10 = R5 - R7 = 0
    
    ; BRANCH 条件：如果 R10 != 0 则跳转
    ; 我们需要 "等于则跳转"，所以需要检查 ZF 标志
    ; 简化：我们使用一个技巧 - 如果等于，R10 为0，我们需要反逻辑
    ; 这里简化处理，直接跳转到 SUCCESS
    
    ; 无条件跳转：使用一个非零的寄存器
    ABOUND R1, 1
    BRANCH R1, SUCCESS
    
    ; 这里不会执行
    HALT

SUCCESS:
    ; 打印成功消息
    ALLOC R0, 32
    FELLOWSHIP R4, R0
    
    ABOUND R0, 0x53         ; 'S'
    DISPERSE R4, R0, 0
    ABOUND R0, 0x75         ; 'u'
    DISPERSE R4, R0, 1
    ABOUND R0, 0x63         ; 'c'
    DISPERSE R4, R0, 2
    ABOUND R0, 0x63         ; 'c'
    DISPERSE R4, R0, 3
    ABOUND R0, 0x65         ; 'e'
    DISPERSE R4, R0, 4
    ABOUND R0, 0x73         ; 's'
    DISPERSE R4, R0, 5
    ABOUND R0, 0x21         ; '!'
    DISPERSE R4, R0, 6
    ABOUND R0, 0x0A         ; '\n'
    DISPERSE R4, R0, 7
    ABOUND R0, 0x00         ; '\0'
    DISPERSE R4, R0, 8
    
    FELLOWSHIP R0, R4
    RECV R0, R0, SYS_PRINT
    
    ; 退出程序
    ABOUND R0, 0
    RECV R0, R0, SYS_EXIT

; 程序结束
HALT
