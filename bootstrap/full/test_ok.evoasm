; 简单测试程序 - 修正版
; 验证工具链是否正常工作

SYS_PRINT   EQU 40
SYS_EXIT    EQU 255

START:
    ; 分配缓冲区 (ALLOC R0, 0 分配 256 字节)
    ALLOC R0, 0
    FELLOWSHIP R4, R0          ; R4 = 缓冲区地址
    FELLOWSHIP R10, R0         ; R10 = 工作指针
    
    ; 存储 'O' (79)
    ABOUND R1, 79
    DISPERSE R10, R1           ; *R10 = 'O'
    
    ; 指针加 1
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2              ; R1 = 1
    INCREASE R10, R1           ; R10++
    
    ; 存储 'K' (75)
    ABOUND R1, 75
    DISPERSE R10, R1
    
    ; 指针加 1
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 存储 '\n' (10)
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2              ; R1 = 10
    DISPERSE R10, R1
    
    ; 指针加 1
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 存储 '\0' (0)
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2              ; R1 = 0
    DISPERSE R10, R1
    
    ; 打印字符串
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R4
    RECV R0, 0                 ; 第二个操作数是 0，触发系统调用
    
    ; 退出
    ABOUND R0, SYS_EXIT
    RECV R0, 0

HALT
