NOT_XOR:
    ; Unknown mnemonic - skip line
P2_SKIP_LINE2:
    ABOUND R2, 1
    INCREASE R4, R2
    LOADB R1, R4
    BRANCH R1, P2_SL2_CONT
    BRANCH R2, P2_END
P2_SL2_CONT:
    ABOUND R2, CHAR_NL
    XOR R1, R2
    BRANCH R1, P2_SKIP_LINE2
    BRANCH R2, P2_LINE

    ; ===== Operand Parsing =====
P2_PARSE_OPERANDS:
    ; R4 points past mnemonic name, R11 = opcode
    ; Goal: R13 = operand1 byte, R14 = operand2 byte

    ; --- Skip spaces before operand1 ---
P2_PO_SKIPSP1:
    LOADB R1, R4
    ABOUND R2, 32           ; ' '
    XOR R1, R2
    BRANCH R1, P2_PO_READ1
    ABOUND R2, 1
    INCREASE R4, R2
    BRANCH R2, P2_PO_SKIPSP1

P2_PO_READ1:
    LOADB R1, R4            ; first char of operand1
    ; Check for newline -> 0-operand instruction (e.g., HALT)
    ABOUND R2, CHAR_NL
    XOR R1, R2
    BRANCH R1, P2_PO_RD1_NL  ; not newline, continue
    BRANCH R2, P2_EMIT       ; newline -> emit (0-operand)
P2_PO_RD1_NL:
    LOADB R1, R4            ; reload (R1 was clobbered by XOR above)
    ; Check for register 'R' (82)
    ABOUND R2, 82
    XOR R1, R2
    BRANCH R1, P2_PO_OP1NUM ; not 'R', parse as number
    ; --- Parse register ---
    ABOUND R2, 1
    INCREASE R4, R2         ; skip 'R'
    LOADB R13, R4           ; first digit char
    ABOUND R2, 1
    INCREASE R4, R2
    ABOUND R2, 48           ; '0'
    REDUCE R13, R2          ; R13 = digit value
    ; Check if 2-digit register (R10-R15)
    LOADB R1, R4            ; peek next char
    ABOUND R2, 32           ; ' '
    XOR R1, R2
    BRANCH R1, P2_PO_REG2DIG ; not space, could be 2nd digit
    BRANCH R2, P2_PO_SKIPCOMMA ; space, done with op1
P2_PO_REG2DIG:
    LOADB R1, R4            ; could be digit or comma
    ABOUND R2, 44           ; ','
    XOR R1, R2
    BRANCH R1, P2_PO_REG2DIG2 ; not comma -> parse 2nd digit
    BRANCH R2, P2_PO_SKIPCOMMA ; comma, done
P2_PO_REG2DIG2:
    ; Parse 2nd digit for register R10-R15
    ABOUND R2, 1
    INCREASE R4, R2         ; skip digit char
    ; R13 = R13 * 10 + digit
    ABOUND R2, 48           ; '0'
    REDUCE R1, R2           ; R1 = digit value
    ; Multiply R13 by 10: R13 = R13*8 + R13*2
    FELLOWSHIP R14, R13     ; save original
    ABOUND R3, 3
    SHL R13, R3             ; R13 = R13 * 8
    ABOUND R3, 1
    SHL R14, R3             ; R14 = original * 2
    INCREASE R13, R14       ; R13 = R13*8 + R13*2 = R13*10
    INCREASE R13, R1        ; R13 = R13*10 + digit
    BRANCH R2, P2_PO_SKIPCOMMA

    ; --- Parse number operand ---
P2_PO_OP1NUM:
    LOADB R1, R4            ; first digit char (re-read)
    ZERO
    FELLOWSHIP R13, R1      ; R13 = 0 (accumulator)
P2_PO_NUM1_LOOP:
    LOADB R1, R4            ; current char
    ; Check if digit (between '0' and '9')
    ABOUND R2, 48           ; '0'
    REDUCE R1, R2           ; R1 = char - '0'
    ; Check if R1 >= 10 (not a digit in 0-9 range)
    FELLOWSHIP R14, R1      ; save digit value
    ABOUND R2, 10
    ; We can't directly compare. Use: digit_value - 10, check negative
    ; But VM has no sign check for branch... Let's check if value > 10
    ; Approach: if value in 0-9 range, the value < 10 in unsigned
    ; We'll just proceed assuming it's a digit for well-formed input
    ; Actually, check common non-digit chars: space=32(-> -16), comma=44(-> -4)
    BRANCH R14, P2_PO_NUM1BODY  ; if non-zero, might be digit or other
    ; R14 == 0 means char == '0' (digit), process
    BRANCH R2, P2_PO_NUM1BODY
P2_PO_NUM1BODY:
    ; R13 = R13 * 10 + digit(R14)
    FELLOWSHIP R15, R13     ; save old value
    ABOUND R3, 3
    SHL R13, R3             ; *8
    ABOUND R3, 1
    SHL R15, R3             ; *2
    INCREASE R13, R15       ; *10
    INCREASE R13, R14       ; + digit
    ABOUND R2, 1
    INCREASE R4, R2         ; advance past digit
    ; Peek next char
    LOADB R1, R4
    ABOUND R2, 44           ; ','
    XOR R1, R2
    BRANCH R1, P2_PO_CHK_SP2 ; not comma
    BRANCH R2, P2_PO_SKIPCOMMA ; comma, done
P2_PO_CHK_SP2:
    ; Check for newline (end of line, no operand2)
    LOADB R1, R4            ; reload peek char
    ABOUND R2, CHAR_NL
    XOR R1, R2
    BRANCH R1, P2_PO_CHK_SP2A ; not newline, check space
    BRANCH R2, P2_EMIT       ; newline -> emit (1-operand)
P2_PO_CHK_SP2A:
    ABOUND R2, 32           ; ' '
    XOR R1, R2
    BRANCH R1, P2_PO_NUM1_LOOP ; not space, continue parsing digits
    BRANCH R2, P2_PO_SKIPSP2 ; space, done with op1

    ; --- Skip comma and spaces to operand2 ---
P2_PO_SKIPCOMMA:
    LOADB R1, R4
    ABOUND R2, 44           ; ','
    XOR R1, R2
    BRANCH R1, P2_PO_SKIPSP2 ; no comma, just spaces
    ABOUND R2, 1
    INCREASE R4, R2         ; skip comma
P2_PO_SKIPSP2:
    LOADB R1, R4
    ABOUND R2, 32           ; ' '
    XOR R1, R2
    BRANCH R1, P2_PO_READ2
    ABOUND R2, 1
    INCREASE R4, R2
    BRANCH R2, P2_PO_SKIPSP2

    ; --- Parse operand2 (same pattern as operand1) ---
P2_PO_READ2:
    LOADB R1, R4
    ABOUND R2, 82           ; 'R'
    XOR R1, R2
    BRANCH R1, P2_PO_OP2NUM ; not 'R', check for label or number
    ; Register
    ABOUND R2, 1
    INCREASE R4, R2
    LOADB R14, R4
    ABOUND R2, 1
    INCREASE R4, R2
    ABOUND R2, 48
    REDUCE R14, R2          ; R14 = digit value
    ; Check 2nd digit
    LOADB R1, R4
    ABOUND R2, 32
    XOR R1, R2
    BRANCH R1, P2_PO_REG2DIG2B
    BRANCH R2, P2_EMIT
P2_PO_REG2DIG2B:
    LOADB R1, R4
    ABOUND R2, 44
    XOR R1, R2
    BRANCH R1, P2_PO_R2_DIG2
    BRANCH R2, P2_EMIT
P2_PO_R2_DIG2:
    ABOUND R2, 1
    INCREASE R4, R2
    ABOUND R2, 48
    REDUCE R1, R2
    FELLOWSHIP R15, R14
    ABOUND R3, 3
    SHL R14, R3
    ABOUND R3, 1
    SHL R15, R3
    INCREASE R14, R15
    INCREASE R14, R1
    BRANCH R2, P2_EMIT

    ; --- Check if operand2 is label name or number ---
P2_PO_OP2NUM:
    ; Check high nibble: digits have 0x30-0x39 (high nibble 0x30)
    ; Labels start with A-Z (0x41-0x5A), _ (0x5F), or @ (0x40)
    LOADB R14, R4           ; first char
    ; Save operand start pointer for label lookup (R10 = label count)
    FELLOWSHIP R15, R4      ; R15 = operand start
    ; Check (char & 0xF0) == 0x30
    FELLOWSHIP R1, R14
    ABOUND R2, 0xF0
    AND R1, R2              ; R1 = char & 0xF0
    ABOUND R2, 0x30
    XOR R1, R2              ; R1 = 0 if high nibble is 0x30 (digit)
    BRANCH R1, P2_PO_OP2LABEL ; high nibble != 0x30 -> label name!
    ; Falls through: high nibble == 0x30 -> parse as number
    BRANCH R2, P2_PO_OP2ASNUM

P2_PO_OP2ASNUM:
    ; Parse number for operand2
    ZERO
    FELLOWSHIP R14, R1      ; R14 = 0
    BRANCH R2, P2_PO_NUM2_LOOP

P2_PO_NUM2_LOOP:
    LOADB R1, R4
    ABOUND R2, 48
    REDUCE R1, R2           ; R1 = char - '0'
    FELLOWSHIP R15, R1      ; save digit
    ; Check for end: space or newline
    ABOUND R2, 1
    INCREASE R4, R2
    LOADB R1, R4            ; peek next
    ABOUND R2, 32
    XOR R1, R2
    BRANCH R1, P2_PO_N2_CHKNL
    ; Next is space, process digit
    FELLOWSHIP R1, R15
    BRANCH R2, P2_PO_N2_ACCUM
P2_PO_N2_CHKNL:
    ABOUND R2, 10           ; newline
    XOR R1, R2
    BRANCH R1, P2_PO_N2_CONT
    ; Next is newline, process digit
    FELLOWSHIP R1, R15
    BRANCH R2, P2_PO_N2_ACCUM
P2_PO_N2_CONT:
    ; More digits
    FELLOWSHIP R1, R15
P2_PO_N2_ACCUM:
    ; R14 = R14 * 10 + digit(R1)
    FELLOWSHIP R15, R14
    ABOUND R3, 3
    SHL R14, R3
    ABOUND R3, 1
    SHL R15, R3
    INCREASE R14, R15
    INCREASE R14, R1
    ; Peek next
    LOADB R1, R4
    ABOUND R2, 32
    XOR R1, R2
    BRANCH R1, P2_PO_N2_NL
    BRANCH R2, P2_EMIT      ; space → done
P2_PO_N2_NL:
    ABOUND R2, 10
    XOR R1, R2
    BRANCH R1, P2_PO_NUM2_LOOP ; continue
    BRANCH R2, P2_EMIT      ; newline → done

    ; --- Label operand2 lookup ---
P2_PO_OP2LABEL:
    ; R15 = operand start, R10 = label count, R8 = label table
    ; Table entry format (5 bytes): addr_lo, addr_hi, hash, name_start, name_end
    ; Step 1: Scan forward to find end of operand (space or newline)
    FELLOWSHIP R4, R15      ; R4 = scan = operand start
P2_LB_FINDEND:
    ABOUND R2, 1
    INCREASE R4, R2          ; R4++
    LOADB R1, R4             ; peek next char
    ABOUND R2, CHAR_SP
    XOR R1, R2
    BRANCH R1, P2_LB_FE_NL   ; not space, check newline
    BRANCH R2, P2_LB_ENDOK   ; space, end found
P2_LB_FE_NL:
    LOADB R1, R4             ; reload (XOR clobbered R1)
    ABOUND R2, CHAR_NL
    XOR R1, R2
    BRANCH R1, P2_LB_FINDEND ; not newline, continue scan
    ; Falls through: newline -> end found
P2_LB_ENDOK:
    ; R15 = start, R4 = end (points to delimiting char)
    ; Step 2: Compute hash = sum of bytes in [R15, R4)
    ZERO
    FELLOWSHIP R14, R1       ; R14 = 0 (hash accumulator)
    FELLOWSHIP R12, R15      ; R12 = scan ptr = start
P2_LB_HASH_LOOP:
    FELLOWSHIP R1, R12
    REDUCE R1, R4            ; R1 = R12 - end
    BRANCH R1, P2_LB_HASH_BYTE ; not done yet
    BRANCH R2, P2_LB_HASH_DONE  ; done
P2_LB_HASH_BYTE:
    ZERO                     ; R1=0
    PENETRATE R12, R1         ; R1 = memory[R12]
    INCREASE R14, R1          ; hash += byte
    ABOUND R1, 1
    INCREASE R12, R1          ; R12++
    BRANCH R2, P2_LB_HASH_LOOP
P2_LB_HASH_DONE:
    ; R14 = operand hash. Search label table (5-byte entries)
    FELLOWSHIP R12, R8        ; R12 = table ptr
    ZERO
    FELLOWSHIP R3, R1         ; R3 = 0 (entry counter)
P2_LB_SRCH_LOOP:
    FELLOWSHIP R1, R3
    REDUCE R1, R10            ; R1 = counter - count
    BRANCH R1, P2_LB_NEXT_ENT ; not done yet
    BRANCH R2, P2_LB_NOTFOUND ; all entries searched
P2_LB_NEXT_ENT:
    ; Save counter before ZERO clobbers it
    FELLOWSHIP R0, R3         ; R0 = counter (temp save)
    ; Read addr_lo (byte0 of 5-byte entry)
    ZERO
    PENETRATE R12, R1         ; R1 = addr_lo
    FELLOWSHIP R15, R1        ; R15 = addr_lo
    ABOUND R1, 1
    INCREASE R12, R1          ; R12++ (past addr_lo)
    ; Read addr_hi (byte1 of 5-byte entry)
    ZERO
    PENETRATE R12, R1         ; R1 = addr_hi
    ; Compose 16-bit addr: (addr_hi << 8) | addr_lo
    ABOUND R2, 8              ; R2 = 8 (shift amount)
    SHL R1, R2                ; R1 = addr_hi << 8
    MERGE R1, R15             ; R1 = (addr_hi << 8) | addr_lo
    FELLOWSHIP R15, R1        ; R15 = full 16-bit addr
    ABOUND R1, 1
    INCREASE R12, R1          ; R12++ (past addr_hi)
    ; Read hash byte (byte2 of 5-byte entry)
    ZERO
    PENETRATE R12, R1         ; R1 = hash byte
    XOR R1, R14               ; compare with operand hash
    BRANCH R1, P2_LB_NOMATCH  ; hash doesn't match
    ; Match! Use addr from R15
    FELLOWSHIP R14, R15       ; R14 = addr (operand2 value)
    BRANCH R2, P2_EMIT         ; done, write instruction
P2_LB_NOMATCH:
    ; Skip name_start, name_end (2 bytes) to reach next entry
    ABOUND R1, 2
    INCREASE R12, R1          ; R12 += 2
    ; Restore and increment counter
    FELLOWSHIP R3, R0         ; R3 = saved counter
    ABOUND R1, 1
    INCREASE R3, R1           ; counter++
    BRANCH R2, P2_LB_SRCH_LOOP
P2_LB_NOTFOUND:
    ; Label not found - use 0 as placeholder
    ZERO
    FELLOWSHIP R14, R1        ; R14 = 0
    BRANCH R2, P2_EMIT

    ; ===== Emit 4-byte instruction =====
P2_EMIT:
    ; Check for BRANCH with long jump target
    ABOUND R2, OP_BRANCH       ; R2 = 2
    FELLOWSHIP R1, R11         ; R1 = opcode
    REDUCE R1, R2              ; R1 = opcode - 2
    BRANCH R1, P2_EMIT_NORMAL  ; not BRANCH -> normal emit
    ; It is BRANCH. Check if target addr > 255
    FELLOWSHIP R1, R14         ; R1 = target addr
    ABOUND R2, 8               ; R2 = 8 (shift amount)
    SHR R1, R2                 ; R1 = target >> 8 (high byte)
    ABOUND R2, 1               ; restore R2 = 1
    BRANCH R1, P2_EMIT_LONGJMP ; high byte != 0 -> target >= 256
P2_EMIT_NORMAL:
    ; byte1 = opcode << 2
    ABOUND R3, 1
    FELLOWSHIP R1, R11
    SHL R1, R3
    SHL R1, R3
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ; byte2 = 0  (modifier byte)
    ZERO
    ABOUND R2, 1              ; Fix: ZERO leaves R2=16, must reset to 1
    DISPERSE R5, R1
    INCREASE R5, R2
    ; byte3 = operand1 (from R13)
    FELLOWSHIP R1, R13
    DISPERSE R5, R1
    INCREASE R5, R2
    ; byte4 = operand2 (from R14)
    FELLOWSHIP R1, R14
    DISPERSE R5, R1
    INCREASE R5, R2
    BRANCH R2, P2_EMIT_DONE
P2_EMIT_LONGJMP:
    ; Long jump: byte1=(opcode<<2)|0x01, byte2=addr_hi, byte3=cond_reg, byte4=addr_lo
    ; byte1 = (opcode << 2) | 0x01
    FELLOWSHIP R1, R11
    ABOUND R3, 1
    SHL R1, R3
    SHL R1, R3                ; R1 = opcode << 2
    ABOUND R2, 1
    MERGE R1, R2              ; R1 = (opcode << 2) | 0x01
    DISPERSE R5, R1           ; byte1
    INCREASE R5, R2           ; R5++
    ; byte2 = target >> 8 (addr_hi)
    FELLOWSHIP R1, R14        ; R1 = target addr
    ABOUND R2, 8              ; R2 = 8
    SHR R1, R2                ; R1 = target >> 8
    ABOUND R2, 1              ; R2 = 1
    DISPERSE R5, R1           ; byte2
    INCREASE R5, R2           ; R5++
    ; byte3 = cond_reg (R13)
    FELLOWSHIP R1, R13
    DISPERSE R5, R1           ; byte3
    INCREASE R5, R2           ; R5++
    ; byte4 = target & 0xFF (addr_lo, DISPERSE stores low 8 bits)
    FELLOWSHIP R1, R14        ; R1 = target addr
    DISPERSE R5, R1           ; byte4
    INCREASE R5, R2           ; R5++
P2_EMIT_DONE:
    ; addr += 4
    ABOUND R2, 4
    INCREASE R7, R2

    ; Skip to next line
P2_TO_NL:
    LOADB R1, R4
    BRANCH R1, P2_TNL_CONT
    BRANCH R2, P2_END
P2_TNL_CONT:
    ABOUND R2, 1
    INCREASE R4, R2
    ABOUND R2, CHAR_NL
    XOR R1, R2
    BRANCH R1, P2_TO_NL
    BRANCH R2, P2_LINE

P2_END:
    ; Pass 2 complete
    ; Debug: print R7 (address counter)
    ABOUND R0, 39              ; SYSCALL_PRINT_NUM
    FELLOWSHIP R1, R7
    RECV R0, 0
    ABOUND R0, 41              ; SYSCALL_PRINTLN (newline)
    ZERO
    FELLOWSHIP R1, R1          ; R1 = 0 (print just newline)
    RECV R0, 0

DONE:
    ; Calculate output size: R5 - R9
    FELLOWSHIP R1, R5
    REDUCE R1, R9
    FELLOWSHIP R13, R1

    ; Build 'output.evob' filename
    ALLOC R0, 0
    FELLOWSHIP R10, R0     ; Save base for later SYS_OPEN (R14 corrupt by long jumps)
    FELLOWSHIP R5, R0
    ABOUND R1, 111
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ABOUND R1, 117
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ABOUND R1, 116
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ABOUND R1, 112
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ABOUND R1, 117
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ABOUND R1, 116
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ABOUND R1, 46
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ABOUND R1, 101
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ABOUND R1, 118
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ABOUND R1, 111
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    ABOUND R1, 98
    DISPERSE R5, R1
    ABOUND R2, 1
    INCREASE R5, R2
    WB0

    ; Open output file
    ABOUND R0, SYS_OPEN
    FELLOWSHIP R1, R10     ; Use saved base (R5 was advanced by wb())
    ABOUND R2, MODE_WRITE
    RECV R0, 0
    FELLOWSHIP R12, R0

    ; Write bytecode (code size saved in R13 at P2_END)
    ABOUND R0, SYS_WRITE
    FELLOWSHIP R1, R12
    FELLOWSHIP R2, R9
    FELLOWSHIP R3, R13       ; R3 = code size (saved before filename construction)
    RECV R0, 0

    ; Close & exit
    ABOUND R0, SYS_CLOSE
    FELLOWSHIP R1, R12
    RECV R0, 0
    ABOUND R0, SYS_EXIT
    RECV R0, 0
HALT
