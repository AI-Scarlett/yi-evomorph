; 测试长跳转代码生成 - 手动验证
; 目标：跳转到地址 812 (0x032C)
; 
; 正确的长跳转代码应该是：
;   ABOUND R5, 3          ; R5 = 0x03 (高字节)
;   ABOUND R6, 8          ; R6 = 8
;   PREFETCH R5, R6       ; R5 = 0x03 << 8 = 0x0300 = 768
;   ABOUND R6, 44         ; R6 = 0x2C = 44 (低字节)
;   INCREASE R5, R6       ; R5 = 768 + 44 = 812
;   .ASYNC BRANCH R1, R5  ; 寄存器间接跳转

SYS_PRINT   EQU 40
SYS_EXIT    EQU 255

START:
    ; 打印 "Start\n"
    ALLOC R0, 0
    FELLOWSHIP R4, R0
    FELLOWSHIP R10, R4
    
    ; 'S' = 83
    ABOUND R1, 83
    DISPERSE R10, R1
    
    ; 指针加1 (INCREASE R10, 1)
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2      ; R1 = 1
    INCREASE R10, R1
    
    ; 't' = 116
    ABOUND R1, 116
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'a' = 97
    ABOUND R1, 97
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'r' = 114
    ABOUND R1, 114
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 't' = 116
    ABOUND R1, 116
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '\n' = 10
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '\0' = 0
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2
    DISPERSE R10, R1
    
    ; 打印
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R4
    RECV R0, 0
    
    ; 用NOP填充代码
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    SYNC
    
    ; 设置条件寄存器为非零
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2      ; R1 = 1
    
    ; ============================================
    ; 手动编写的长跳转代码
    ; 目标：跳转到 TARGET 标签
    ; ============================================
    
    ; 第一步：获取 TARGET 的地址
    ; 但我们在汇编时不知道...
    ; 这就是为什么需要两遍扫描
    
    ; 替代方案：直接跳转到一个已知的短标签
    ; 然后从那里跳转到长目标
    
    ; 让我们先尝试一个简单的方法：
    ; 跳转到 NEAR_TARGET，然后从那里跳转到 TARGET
    
    BRANCH R1, NEAR_TARGET
    
    ; 如果跳转失败，打印 "Jump failed\n"
    ALLOC R0, 0
    FELLOWSHIP R4, R0
    FELLOWSHIP R10, R4
    
    ; 'J' = 74
    ABOUND R1, 74
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'u' = 117
    ABOUND R1, 117
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'm' = 109
    ABOUND R1, 109
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'p' = 112
    ABOUND R1, 112
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; ' ' = 32
    ABOUND R1, 32
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'f' = 102
    ABOUND R1, 102
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'a' = 97
    ABOUND R1, 97
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'i' = 105
    ABOUND R1, 105
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'l' = 108
    ABOUND R1, 108
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'e' = 101
    ABOUND R1, 101
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'd' = 100
    ABOUND R1, 100
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '\n' = 10
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '\0' = 0
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2
    DISPERSE R10, R1
    
    ; 打印
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R4
    RECV R0, 0
    
    ; 退出
    ABOUND R0, SYS_EXIT
    RECV R0, 0

; 近目标 - 应该在255字节范围内
NEAR_TARGET:
    ; 现在，从这里跳转到 TARGET
    ; 但是，如果 TARGET 仍然超过255字节呢？
    
    ; 让我们尝试使用寄存器间接跳转
    ; 但我们需要知道 TARGET 的地址...
    
    ; 实际上，让我们重新思考整个问题
    ; 问题的核心是：
    ; 1. 我们需要在第一遍扫描时知道所有标签的地址
    ; 2. 然后在第二遍扫描时，对于长跳转，生成寄存器间接跳转代码
    ; 3. 但是，生成额外代码会改变后续标签的地址
    
    ; 解决方案：
    ; 1. 第一遍：计算初始地址
    ; 2. 检测哪些跳转是长跳转
    ; 3. 为每个长跳转预留额外的空间（或重新计算地址）
    ; 4. 第二遍：生成实际代码
    
    ; 但这很复杂...
    
    ; 让我们先尝试一个简单的解决方案：
    ; 在 Python 汇编器中自动处理长跳转
    
    ; 但首先，让我验证我的手动长跳转代码是否正确
    
    ; 让我们假设 TARGET 的地址是 812 (0x032C)
    ; 让我们手动构建这个地址到 R5
    
    ; 812 = 0x032C = 0x03 * 256 + 0x2C = 3 * 256 + 44 = 768 + 44
    
    ; 第一步：加载 3 到 R5
    ABOUND R5, 3           ; R5 = 3
    
    ; 第二步：左移 8 位 (3 * 256 = 768)
    ABOUND R6, 8            ; R6 = 8
    PREFETCH R5, R6         ; R5 = R5 << R6 = 3 << 8 = 768 (0x0300)
    
    ; 第三步：加上 44 (768 + 44 = 812)
    ; INCREASE 是加法：reg[dst] = reg[dst] + reg[src]
    ABOUND R6, 44           ; R6 = 44
    INCREASE R5, R6         ; R5 = 768 + 44 = 812 (0x032C)
    
    ; 第四步：寄存器间接跳转
    ; .ASYNC BRANCH cond, Rx
    ; 根据 C 虚拟机代码：
    ; if (modifier != 0) {
    ;     uint8_t reg = operands[1] & 0x0F;
    ;     target = vm->registers[reg];
    ; }
    .ASYNC BRANCH R1, R5
    
    ; 如果跳转失败，打印 "Near jump failed\n"
    ALLOC R0, 0
    FELLOWSHIP R4, R0
    FELLOWSHIP R10, R4
    
    ; 'N' = 78
    ABOUND R1, 78
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'e' = 101
    ABOUND R1, 101
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'a' = 97
    ABOUND R1, 97
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'r' = 114
    ABOUND R1, 114
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; ' ' = 32
    ABOUND R1, 32
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'j' = 106
    ABOUND R1, 106
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'u' = 117
    ABOUND R1, 117
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'm' = 109
    ABOUND R1, 109
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'p' = 112
    ABOUND R1, 112
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; ' ' = 32
    ABOUND R1, 32
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'f' = 102
    ABOUND R1, 102
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'a' = 97
    ABOUND R1, 97
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'i' = 105
    ABOUND R1, 105
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'l' = 108
    ABOUND R1, 108
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'e' = 101
    ABOUND R1, 101
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'd' = 100
    ABOUND R1, 100
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '\n' = 10
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '\0' = 0
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2
    DISPERSE R10, R1
    
    ; 打印
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R4
    RECV R0, 0
    
    ; 退出
    ABOUND R0, SYS_EXIT
    RECV R0, 0

; 目标标签 - 应该在超过255字节的位置
TARGET:
    ; 打印 "Jump success!\n"
    ALLOC R0, 0
    FELLOWSHIP R4, R0
    FELLOWSHIP R10, R4
    
    ; 'J' = 74
    ABOUND R1, 74
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'u' = 117
    ABOUND R1, 117
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'm' = 109
    ABOUND R1, 109
