    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'u' = 117
    ABOUND R1, 117
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'c' = 99
    ABOUND R1, 99
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'c' = 99
    ABOUND R1, 99
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 'e' = 101
    ABOUND R1, 101
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 's' = 115
    ABOUND R1, 115
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; 's' = 115
    ABOUND R1, 115
    DISPERSE R10, R1
    
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    INCREASE R10, R1
    
    ; '!' = 33
    ABOUND R1, 33
