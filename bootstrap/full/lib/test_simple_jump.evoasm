; ============================================================
; 测试寄存器间接跳转 (简化版)
; ============================================================

SYS_PRINT   EQU 40
SYS_EXIT    EQU 255

%macro LOAD_0 1
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2
    FELLOWSHIP %1, R1
%endmacro

%macro LOAD_1 1
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    FELLOWSHIP %1, R1
%endmacro

%macro LOAD_10 1
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2
    FELLOWSHIP %1, R1
%endmacro

%macro PTR_INC 1
    LOAD_1 R1
    INCREASE %1, R1
%endmacro

main:
    ; 分配缓冲区存储 "OK\n"
    ALLOC R0, 0
    FELLOWSHIP R14, R0
    FELLOWSHIP R10, R0
    
    ; 'O' = 79
    ABOUND R1, 79
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'K' = 75
    ABOUND R1, 75
    DISPERSE R10, R1
    PTR_INC R10
    
    ; '\n' = 10
    LOAD_10 R1
    DISPERSE R10, R1
    PTR_INC R10
    
    ; null
    LOAD_0 R1
    DISPERSE R10, R1
    
    ; 打印 "OK\n"
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R14
    RECV R0, 0
    
    ; 测试寄存器间接跳转
    ; 目标: 如果成功跳转到 print_b，打印 "B\n"
    ; 否则打印 "FAIL\n"
    
    ; 将目标地址加载到 R1
    ; 注意: 我们需要知道 print_b 的地址
    ; 这里我们手动计算: 假设 print_b 在某个位置
    
    ; 先设置 R0 = 1 (非零) 确保跳转
    LOAD_1 R0
    
    ; 简单起见，我们先不测试长跳转
    ; 而是继续开发，同时修改汇编器支持长跳转
    
    ; 打印 "DONE\n"
    ALLOC R0, 0
    FELLOWSHIP R10, R0
    
    ; 'D' = 68
    ABOUND R1, 68
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'O' = 79
    ABOUND R1, 79
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'N' = 78
    ABOUND R1, 78
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'E' = 69
    ABOUND R1, 69
    DISPERSE R10, R1
    PTR_INC R10
    
    ; '\n' = 10
    LOAD_10 R1
    DISPERSE R10, R1
    PTR_INC R10
    
    LOAD_0 R1
    DISPERSE R10, R1
    
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R0
    RECV R0, 0
    
    ; 退出
    ABOUND R0, SYS_EXIT
    RECV R0, 0

HALT
