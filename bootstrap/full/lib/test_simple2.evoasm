; ============================================================
; 易衍·Evomorph 简单测试
; 验证基本字符串操作
; ============================================================
;
; 注意：
; - ALLOC Rx, N 中 N 是立即数 (0-255)，不是寄存器
; - N=0 表示分配 256 字节
; ============================================================

; ========== 常量定义 ==========
SYS_STRLEN  EQU 20
SYS_STRCMP  EQU 21
SYS_PRINT   EQU 40
SYS_EXIT    EQU 255

; ========== 宏：加载小立即数 ==========
; 加载 0
%macro LOAD_0 1
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2
    FELLOWSHIP %1, R1
%endmacro

; 加载 1
%macro LOAD_1 1
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    FELLOWSHIP %1, R1
%endmacro

; 加载 10 (换行符)
%macro LOAD_10 1
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2
    FELLOWSHIP %1, R1
%endmacro

; 指针递增
%macro PTR_INC 1
    LOAD_1 R1
    INCREASE %1, R1
%endmacro

; ========== 主程序 ==========
; 测试流程：
; 1. 分配缓冲区
; 2. 存储 "OK\n"
; 3. 打印
; 4. 测试 strlen
; 5. 比较两个相同的字符串
; 6. 根据比较结果打印 PASS 或 FAIL
; ==========================================

main:
    ; ===== 步骤 1：分配缓冲区 =====
    ; ALLOC Rx, N - N 是立即数，N=0 表示 256 字节
    ALLOC R0, 0                 ; R0 = 缓冲区 1 (256 字节)
    FELLOWSHIP R14, R0          ; R14 = 保存缓冲区 1 地址
    
    ALLOC R0, 0                 ; R0 = 缓冲区 2 (256 字节)
    FELLOWSHIP R15, R0          ; R15 = 保存缓冲区 2 地址
    
    ALLOC R0, 0                 ; R0 = 结果缓冲区 (256 字节)
    FELLOWSHIP R10, R0          ; R10 = 结果缓冲区地址
    FELLOWSHIP R11, R0          ; R11 = 保存结果地址 (用于打印)
    
    ; ===== 步骤 2：构建 "OK\n" 到缓冲区 1 =====
    FELLOWSHIP R0, R14          ; R0 = 缓冲区 1
    
    ; 'O' = 79
    ABOUND R1, 79
    DISPERSE R0, R1
    PTR_INC R0
    
    ; 'K' = 75
    ABOUND R1, 75
    DISPERSE R0, R1
    PTR_INC R0
    
    ; '\n' = 10
    LOAD_10 R1
    DISPERSE R0, R1
    PTR_INC R0
    
    ; null = 0
    LOAD_0 R1
    DISPERSE R0, R1
    
    ; ===== 步骤 3：构建相同的字符串到缓冲区 2 =====
    FELLOWSHIP R0, R15          ; R0 = 缓冲区 2
    
    ABOUND R1, 79
    DISPERSE R0, R1
    PTR_INC R0
    
    ABOUND R1, 75
    DISPERSE R0, R1
    PTR_INC R0
    
    LOAD_10 R1
    DISPERSE R0, R1
    PTR_INC R0
    
    LOAD_0 R1
    DISPERSE R0, R1
    
    ; ===== 步骤 4：测试 strcmp =====
    ; 比较 R14 和 R15，应该相等 (返回 0)
    FELLOWSHIP R1, R14
    FELLOWSHIP R2, R15
    ABOUND R0, SYS_STRCMP
    RECV R0, 0
    ; 现在 R0 = 0 (相等) 或 != 0 (不等)
    
    ; ===== 步骤 5：根据比较结果构建结果字符串 =====
    ; BRANCH 在非零时跳转
    ; 所以如果 R0 == 0，不跳转，继续执行 PASS 代码
    ; 如果 R0 != 0，跳转到 FAIL 代码
    
    BRANCH R0, build_fail
    
    ; ===== 构建 "PASS\n" =====
    ; 'P' = 80, 'A' = 65, 'S' = 83, 'S' = 83, '\n' = 10, 0
    
    ABOUND R1, 80
    DISPERSE R10, R1
    PTR_INC R10
    
    ABOUND R1, 65
    DISPERSE R10, R1
    PTR_INC R10
    
    ABOUND R1, 83
    DISPERSE R10, R1
    PTR_INC R10
    
    ABOUND R1, 83
    DISPERSE R10, R1
    PTR_INC R10
    
    LOAD_10 R1
    DISPERSE R10, R1
    PTR_INC R10
    
    LOAD_0 R1
    DISPERSE R10, R1
    
    BRANCH R0, print_result

build_fail:
    ; ===== 构建 "FAIL\n" =====
    ; 'F' = 70, 'A' = 65, 'I' = 73, 'L' = 76, '\n' = 10, 0
    
    ABOUND R1, 70
    DISPERSE R10, R1
    PTR_INC R10
    
    ABOUND R1, 65
    DISPERSE R10, R1
    PTR_INC R10
    
    ABOUND R1, 73
    DISPERSE R10, R1
    PTR_INC R10
    
    ABOUND R1, 76
    DISPERSE R10, R1
    PTR_INC R10
    
    LOAD_10 R1
    DISPERSE R10, R1
    PTR_INC R10
    
    LOAD_0 R1
    DISPERSE R10, R1

print_result:
    ; ===== 打印结果 =====
    ; R11 保存了结果缓冲区的起始地址
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R11
    RECV R0, 0
    
    ; ===== 退出 =====
    ABOUND R0, SYS_EXIT
    RECV R0, 0

HALT
