; ============================================================
; 易衍·Evomorph 简单测试
; 验证 ALLOC 和 PRINT 基本功能
; ============================================================

; ========== 常量定义 ==========
SYS_PRINT   EQU 40
SYS_EXIT    EQU 255

; ========== 宏：加载小立即数 ==========
%macro LOAD_0 1
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2
    FELLOWSHIP %1, R1
%endmacro

%macro LOAD_1 1
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    FELLOWSHIP %1, R1
%endmacro

%macro LOAD_10 1
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2
    FELLOWSHIP %1, R1
%endmacro

%macro PTR_INC 1
    LOAD_1 R1
    INCREASE %1, R1
%endmacro

; ========== 主程序 ==========
; 测试流程：
; 1. 分配缓冲区
; 2. 存储 "ABC\n"
; 3. 打印
; 4. 退出
; ==========================================

main:
    ; ===== 分配缓冲区 =====
    ALLOC R0, 0                 ; R0 = 缓冲区 (256 字节)
    FELLOWSHIP R14, R0          ; R14 = 保存地址
    FELLOWSHIP R10, R0          ; R10 = 工作指针
    
    ; ===== 存储 "ABC\n\0" =====
    ; 'A' = 65
    ABOUND R1, 65
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'B' = 66
    ABOUND R1, 66
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 'C' = 67
    ABOUND R1, 67
    DISPERSE R10, R1
    PTR_INC R10
    
    ; '\n' = 10
    LOAD_10 R1
    DISPERSE R10, R1
    PTR_INC R10
    
    ; '\0' = 0
    LOAD_0 R1
    DISPERSE R10, R1
    
    ; ===== 打印 =====
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R14
    RECV R0, 0
    
    ; ===== 退出 =====
    ABOUND R0, SYS_EXIT
    RECV R0, 0

HALT
