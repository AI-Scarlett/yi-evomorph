; ============================================================
; 测试寄存器间接跳转
; ============================================================

SYS_PRINT   EQU 40
SYS_EXIT    EQU 255

%macro LOAD_0 1
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2
    FELLOWSHIP %1, R1
%endmacro

%macro LOAD_1 1
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2
    FELLOWSHIP %1, R1
%endmacro

%macro PTR_INC 1
    LOAD_1 R1
    INCREASE %1, R1
%endmacro

main:
    ; 分配缓冲区
    ALLOC R0, 0
    FELLOWSHIP R14, R0
    FELLOWSHIP R10, R0
    
    ; 存储 "A"
    ABOUND R1, 65
    DISPERSE R10, R1
    PTR_INC R10
    
    ; 存储 null
    LOAD_0 R1
    DISPERSE R10, R1
    
    ; 打印 "A"
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R14
    RECV R0, 0
    
    ; 测试寄存器间接跳转
    ; 将目标地址加载到 R1
    ABOUND R1, print_b_addr   ; 这会被汇编器替换为实际地址
    
    ; 使用 .ASYNC modifier 表示寄存器间接跳转
    ; BRANCH.ASYNC R0, R1  表示: 如果 R0 != 0，跳转到 R1 中的地址
    
    ; 先设置 R0 = 1 (非零) 确保跳转
    LOAD_1 R0
    
    ; 跳转到 R1 中的地址
    ; 注意: 使用 .ASYNC modifier 来触发寄存器间接跳转
    .ASYNC BRANCH R0, R1
    
    ; 如果不跳转，会执行这里
    ; 存储 "SKIP"
    ALLOC R0, 0
    FELLOWSHIP R10, R0
    
    ; 'S' = 83
    ABOUND R1, 83
    DISPERSE R10, R1
    PTR_INC R10
    
    LOAD_0 R1
    DISPERSE R10, R1
    
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R10
    RECV R0, 0
    
    ; 退出
    ABOUND R0, SYS_EXIT
    RECV R0, 0

print_b_addr:
    ; 存储 "B\n"
    ALLOC R0, 0
    FELLOWSHIP R14, R0
    FELLOWSHIP R10, R0
    
    ; 'B' = 66
    ABOUND R1, 66
    DISPERSE R10, R1
    PTR_INC R10
    
    ; '\n' = 10
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2
    DISPERSE R10, R1
    PTR_INC R10
    
    LOAD_0 R1
    DISPERSE R10, R1
    
    ; 打印
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R14
    RECV R0, 0
    
    ; 退出
    ABOUND R0, SYS_EXIT
    RECV R0, 0

HALT
