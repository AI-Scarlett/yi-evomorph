; ============================================================
; 易衍·Evomorph 详细测试
; 存储 "AB" 并打印
; ============================================================

; ========== 常量定义 ==========
SYS_PRINT   EQU 40
SYS_EXIT    EQU 255

; ========== 主程序 ==========
main:
    ; ===== 分配缓冲区 =====
    ALLOC R0, 0                 ; R0 = 缓冲区 (256 字节)
    FELLOWSHIP R14, R0          ; R14 = 保存地址
    FELLOWSHIP R10, R0          ; R10 = 工作指针
    
    ; ===== 存储 'A' (65) =====
    ABOUND R1, 65                ; R1 = 65 ('A')
    DISPERSE R10, R1             ; *R10 = 'A'
    
    ; 指针加 1 (R10++)
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2                ; R1 = 1
    INCREASE R10, R1             ; R10 = R10 + 1
    
    ; ===== 存储 'B' (66) =====
    ABOUND R1, 66                ; R1 = 66 ('B')
    DISPERSE R10, R1             ; *R10 = 'B'
    
    ; 指针加 1
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2                ; R1 = 1
    INCREASE R10, R1             ; R10++
    
    ; ===== 存储 '\n' (10) =====
    ABOUND R1, 16
    ABOUND R2, 6
    REDUCE R1, R2                ; R1 = 10
    DISPERSE R10, R1             ; *R10 = '\n'
    
    ; 指针加 1
    ABOUND R1, 16
    ABOUND R2, 15
    REDUCE R1, R2                ; R1 = 1
    INCREASE R10, R1             ; R10++
    
    ; ===== 存储 null (0) =====
    ABOUND R1, 16
    ABOUND R2, 16
    REDUCE R1, R2                ; R1 = 0
    DISPERSE R10, R1             ; *R10 = 0
    
    ; ===== 打印 =====
    ABOUND R0, SYS_PRINT
    FELLOWSHIP R1, R14
    RECV R0, 0
    
    ; ===== 退出 =====
    ABOUND R0, SYS_EXIT
    RECV R0, 0

HALT
