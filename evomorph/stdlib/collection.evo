@evolang "3.0"

@xiangci {
    "集合之基：列表、映射、集合、队列，
    组织数据之容器。"
}

@locus std.collection.list.new {
    mut_rate   = 0.01
    cross_pool = "collection_ops"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷂ ALLOC R0, 0x1000
        ䷍ ABUNDANCE R0, 0
        ䷾ SYNC
        ䷗ RETURN R0
    }
}

