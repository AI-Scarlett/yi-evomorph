@locus std.collection.list.concat {
    mut_rate   = 0.02
    cross_pool = "collection_ops"
    fitness    = max_throughput + min_energy
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::LIST_A
        ䷁ RECV R1, env::LIST_B
        ䷂ ALLOC R2, 0x2000
        ䷌ FELLOWSHIP R0, R2
        ䷌ FELLOWSHIP R1, R2
        ䷾ SYNC
        ䷗ RETURN R2
    }
}

