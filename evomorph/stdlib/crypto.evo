@locus std.crypto.encrypt_aes_gcm {
    mut_rate   = 0.03
    cross_pool = "crypto_ops"
    fitness    = min_energy + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::KEY
        ䷁ RECV R1, env::NONCE
        ䷁ RECV R2, env::PLAINTEXT
        ䷁ RECV R3, env::AAD
        ䷂ ALLOC R4, 0x1000
        ䷌ FELLOWSHIP R0, R4
        ䷌ FELLOWSHIP R1, R4
        ䷌ FELLOWSHIP R2, R4
        ䷌ FELLOWSHIP R3, R4
        ䷑ MUT R4, @aes_gcm_seal
        ䷾ SYNC
        ䷗ RETURN R4
    }
}

@locus std.crypto.decrypt_aes_gcm {
    mut_rate   = 0.03
    cross_pool = "crypto_ops"
    fitness    = min_energy + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::KEY
        ䷁ RECV R1, env::NONCE
        ䷁ RECV R2, env::CIPHERTEXT
        ䷁ RECV R3, env::TAG
        ䷁ RECV R4, env::AAD
        ䷂ ALLOC R5, 0x1000
        ䷌ FELLOWSHIP R0, R5
        ䷌ FELLOWSHIP R1, R5
        ䷌ FELLOWSHIP R2, R5
        ䷑ MUT R5, @aes_gcm_open
        ䷾ SYNC
        ䷗ RETURN R5
    }
}

