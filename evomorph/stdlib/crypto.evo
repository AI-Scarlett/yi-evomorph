@locus std.crypto.constant_time_eq {
    mut_rate   = 0.01
    cross_pool = "crypto_ops"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::A
        ䷁ RECV R1, env::B
        ䷒ APPROACH R0, R1
        ䷑ MUT R0, @constant_time_mask
        ䷗ RETURN R0
    }
}

@locus std.crypto.derive_key_pbkdf2 {
    mut_rate   = 0.03
    cross_pool = "crypto_ops"
    fitness    = min_energy
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::PASSWORD
        ䷁ RECV R1, env::SALT
        ䷁ RECV R2, env::ITERATIONS
        ䷁ RECV R3, env::KEY_LEN
        ䷂ ALLOC R4, 0x200
        ䷌ FELLOWSHIP R0, R4
        ䷌ FELLOWSHIP R1, R4
        ䷑ MUT R4, @pbkdf2_hmac
        ䷾ SYNC
        ䷗ RETURN R4
    }
}

@locus std.crypto.derive_key_argon2 {
    mut_rate   = 0.03
    cross_pool = "crypto_ops"
    fitness    = min_energy
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::PASSWORD
        ䷁ RECV R1, env::SALT
        ䷁ RECV R2, env::TIME_COST
        ䷁ RECV R3, env::MEM_COST
        ䷂ ALLOC R4, 0x10000
        ䷌ FELLOWSHIP R0, R4
        ䷌ FELLOWSHIP R1, R4
        ䷑ MUT R4, @argon2id
        ䷾ SYNC
        ䷗ RETURN R4
    }
}
