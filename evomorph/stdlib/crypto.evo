@evolang "3.0"

@xiangci {
    "加密之基：哈希、签名、验证、密钥，
    守护数据之安全。"
}

@locus std.crypto.hash_md5 {
    mut_rate   = 0.02
    cross_pool = "crypto_ops"
    fitness    = max_throughput + min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::DATA
        ䷂ ALLOC R1, 0x20
        ䷓ CONTEMPLATE R0
        ䷑ MUT R1, @md5_rounds
        ䷾ SYNC
        ䷗ RETURN R1
    }
}

@locus std.crypto.hash_sha1 {
    mut_rate   = 0.02
