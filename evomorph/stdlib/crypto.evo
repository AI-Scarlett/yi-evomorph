@locus std.crypto.hmac_sha256 {
    mut_rate   = 0.02
    cross_pool = "crypto_ops"
    fitness    = max_throughput + min_energy
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::KEY
        ䷁ RECV R1, env::DATA
        ䷂ ALLOC R2, 0x100
        ䷌ FELLOWSHIP R0, R2
        ䷌ FELLOWSHIP R1, R2
        ䷑ MUT R2, @hmac_pad
        ䷾ SYNC
        ䷗ RETURN R2
    }
}

@locus std.crypto.sign_rsa {
    mut_rate   = 0.03
    cross_pool = "crypto_ops"
    fitness    = min_energy + min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::PRIVATE_KEY
        ䷁ RECV R1, env::DATA_HASH
        ䷂ ALLOC R2, 0x400
        ䷌ FELLOWSHIP R0, R2
        ䷌ FELLOWSHIP R1, R2
        ䷑ MUT R2, @rsa_private_op
        ䷾ SYNC
        ䷗ RETURN R2
    }
}

@locus std.crypto.verify_rsa {
    mut_rate   = 0.03
    cross_pool = "crypto_ops"
    fitness    = min_energy + min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::PUBLIC_KEY
        ䷁ RECV R1, env::SIGNATURE
        ䷁ RECV R2, env::DATA_HASH
        ䷂ ALLOC R3, 0x40
        ䷌ FELLOWSHIP R0, R3
        ䷌ FELLOWSHIP R1, R3
        ䷑ MUT R3, @rsa_public_op
        ䷒ APPROACH R3, R2
        ䷗ RETURN R3
    }
}

