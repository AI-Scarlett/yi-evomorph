@locus std.crypto.encode_base64 {
    mut_rate   = 0.01
    cross_pool = "crypto_ops"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::DATA
        ䷂ ALLOC R1, 0x2000
        ䷕ ADORN R1, R0
        ䷾ SYNC
        ䷗ RETURN R1
    }
}

@locus std.crypto.decode_base64 {
    mut_rate   = 0.01
