@evolang "3.0"

@xiangci {
    "串之基：字符串创建、拼接、查找、替换，Unicode支持。"
}

@locus std.string.new {
    mut_rate   = 0.01
    cross_pool = "string_ops"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18"]

    卦序: {
        ䷀ CREA R0, @init
        ䷂ ALLOC R0, R1
        ䷍ ABUNDANCE R0, 0
        ䷗ RETURN R0
    }
}

@locus std.string.length {
    mut_rate   = 0.01
    cross_pool = "string_ops"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18"]

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷗ RETURN R1
    }
}

@locus std.string.concat {
    mut_rate   = 0.01
    cross_pool = "string_ops"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18"]

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷓ CONTEMPLATE R1
        ䷬ GATHER R2, R0
        ䷬ GATHER R2, R1
        ䷗ RETURN R2
    }
}

@locus std.string.substr {
    mut_rate   = 0.01
