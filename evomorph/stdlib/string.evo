    env_target = ["linux-6.x", "android-14", "ios-18"]

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷑ MUT R1, @offset
        ䷑ MUT R2, @length
        ䷗ RETURN R3
    }
}

