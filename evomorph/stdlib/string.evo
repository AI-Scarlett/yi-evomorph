    env_target = ["linux-6.x", "android-14", "ios-18"]

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷓ CONTEMPLATE R1
        ䷨ REDUCE R2, R0
        ䷨ REDUCE R2, R1
        ䷗ RETURN R2
    }
}

