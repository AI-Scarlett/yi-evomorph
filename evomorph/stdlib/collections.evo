@evolang "3.0"

@xiangci {
    "集合之基：列表、映射、集合，高效数据结构，动态扩容与收缩。"
}

@locus std.collections.list_new {
    mut_rate   = 0.01
    cross_pool = "collections"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18"]

    卦序: {
        ䷀ CREA R0, @initial_capacity
        ䷂ ALLOC R0, R1
        ䷍ ABUNDANCE R0, 0
        ䷗ RETURN R0
    }
}

@locus std.collections.list_append {
    mut_rate   = 0.01
    cross_pool = "collections"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18"]

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷋ HALT
        ䷭ PUSH_UP R0, R1
        ䷗ RETURN
    }
}

@locus std.collections.list_get {
    mut_rate   = 0.01
    cross_pool = "collections"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18"]

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷁ RECV R2, R0
        ䷗ RETURN R2
    }
}

@locus std.collections.list_set {
    mut_rate   = 0.01
    cross_pool = "collections"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18"]

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷍ ABUNDANCE R1, R0
        ䷗ RETURN
    }
}

@locus std.collections.list_length {
    mut_rate   = 0.01
    cross_pool = "collections"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18"]

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷗ RETURN R1
    }
}

@locus std.collections.map_new {
    mut_rate   = 0.01
    cross_pool = "collections"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18"]

    卦序: {
        ䷀ CREA R0, @hash_table
        ䷂ ALLOC R0, R1
        ䷍ ABUNDANCE R0, 0
        ䷗ RETURN R0
    }
}

@locus std.collections.map_insert {
    mut_rate   = 0.01
    cross_pool = "collections"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18"]

    卦序: {
        ䷑ MUT R1, @hash
        ䷓ CONTEMPLATE R0
        ䷍ ABUNDANCE R2, R1
        ䷗ RETURN
    }
}

@locus std.collections.map_lookup {
    mut_rate   = 0.01
    cross_pool = "collections"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18"]

    卦序: {
        ䷑ MUT R1, @hash
        ䷓ CONTEMPLATE R0
        ䷁ RECV R2, R1
        ䷗ RETURN R2
    }
}

@locus std.collections.set_new {
    mut_rate   = 0.01
    cross_pool = "collections"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18"]

    卦序: {
        ䷀ CREA R0, @set_impl
        ䷂ ALLOC R0, R1
