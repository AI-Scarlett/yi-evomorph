}

@locus std.collections.set_add {
    mut_rate   = 0.01
    cross_pool = "collections"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18"]

    卦序: {
        ䷓ CONTEMPLATE R0
