@evolang "3.0"

@xiangci {
    "监控之眼：采运行时之样，析热点之径，追踪适应度之变。"
}

@locus evomon.collect {
    mut_rate   = 0.01
    cross_pool = "monitor"
    fitness    = min_latency + min_energy
    env_target = ["linux-6.x"]

    卦序: {
        ䷁ RECV R0, 32
        ䷾ SYNC
        ䷋ HALT
    }
}

@locus evomon.analyze {
    mut_rate   = 0.01
    cross_pool = "monitor"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x"]

    卦序: {
        ䷁ RECV R0, 64
        ䷆ BRANCH R0, R1
        ䷾ SYNC
        ䷋ HALT
    }
}
