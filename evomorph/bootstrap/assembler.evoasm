; ============================================================
; 易衍·Evomorph 自举汇编器
; Self-Hosting Assembler in pure IChing instructions
;
; 功能: 将 .evoasm 汇编源码转换为 EVB 字节码
; 输入: R0 指向堆中的源码文本 (null-terminated)
; 输出: R0 = 输出字节码大小, 字节码在 OUTPUT_BUF
;
; 支持的格式: IChing 扩展指令
;   MNEMONIC.N Rd, Rs           → 4 字节
;   MNEMONIC.N Rd, Rs, #imm     → 8 字节
;   MNEMONIC.N @label           → 8 字节 (跳转)
;   MNEMONIC.N Rd, #imm         → 8 字节
;   label:                       → 标签定义
;   ; comment                    → 注释
;
; 编码:
;   byte1 = 0x80 | (opcode & 0x3F)
;   byte2 = (mode << 6) | sub_op  (mode: 0=base, 1=reg, 2=imm)
;   byte3 = dst_reg & 0x1F
;   byte4 = src_reg & 0x1F
;   [+4 bytes LE imm if mode==2]
;
; 寄存器分配:
;   R0  = 返回值 / 临时
;   R1  = 临时 / 参数
;   R2  = 临时
;   R3  = 临时
;   R4  = 保存寄存器
;   R5  = 当前行指针
;   R6  = 操作码 (opcode)
;   R7  = 扩展模式 (sub_op)
;   R8  = 源码文本指针 (input source)
;   R9  = 输出缓冲区指针 (output bytecode)
;   R10 = 当前 PC (program counter)
;   R11 = 标签表指针 (label table)
;   R12 = 第一遍/第二遍标记
;   R13 = 临时
;   R14 = 临时
;   R15 = 临时
; ============================================================

BRANCH.1 @asm_main

; ============================================================
; 内存布局常量 (存储在堆中)
; ============================================================
; INPUT_BUF     = 0x1000  (源码输入)
; OUTPUT_BUF    = 0x11000 (字节码输出, 64KB)
; LABEL_TABLE   = 0x12000 (标签名+地址, 每个条目 64 字节, 最多 256 个)
; OPCODE_TABLE  = 0x16000 (助记符→操作码映射表)
; TEMP_BUF      = 0x17000 (临时缓冲区)
; LINE_BUF      = 0x18000 (当前行缓冲区)
; ============================================================

; ============================================================
; 助手函数: strlen (从 compiler.evoasm 复用)
; 输入: R0 = 字符串指针
; 输出: R0 = 长度
; ============================================================
asm_strlen:
    PUSH_UP.1 R4, R4
    PUSH_UP.1 R5, R5
    FELLOWSHIP.0 R4, R0
    CREA.1 R5, R5, #0
asm_strlen_loop:
    RECV.2 R0, R4
    FELLOWSHIP.2 R0, R0, #0
    BRANCH.2 @asm_strlen_done
    MICRO.1 R4, R4
    MICRO.1 R5, R5
    BRANCH.1 @asm_strlen_loop
asm_strlen_done:
    FELLOWSHIP.0 R0, R5
    WELL.1 R5, R5
    WELL.1 R4, R4
    RETURN.0 R0, R0

; ============================================================
; 助手函数: strcmp
; 输入: R0 = str1, R1 = str2
; 输出: R0 = 0 相等, 1 str1>str2, -1 str1<str2
; ============================================================
asm_strcmp:
    PUSH_UP.1 R4, R4
    PUSH_UP.1 R5, R5
asm_strcmp_loop:
    RECV.2 R4, R0
    RECV.2 R5, R1
    FELLOWSHIP.1 R4, R5
    BRANCH.3 @asm_strcmp_diff
    FELLOWSHIP.2 R4, R4, #0
    BRANCH.2 @asm_strcmp_equal
    MICRO.1 R0, R0
    MICRO.1 R1, R1
    BRANCH.1 @asm_strcmp_loop
asm_strcmp_diff:
    BRANCH.4 @asm_strcmp_less
    CREA.1 R0, R0, #1
    BRANCH.1 @asm_strcmp_ret
asm_strcmp_less:
    CREA.1 R0, R0, #4294967295
    BRANCH.1 @asm_strcmp_ret
asm_strcmp_equal:
    CREA.1 R0, R0, #0
asm_strcmp_ret:
    WELL.1 R5, R5
    WELL.1 R4, R4
    RETURN.0 R0, R0

; ============================================================
; 字符分类函数
; ============================================================
asm_is_space:
    FELLOWSHIP.2 R0, R0, #32
    BRANCH.2 @asm_is_space_yes
    FELLOWSHIP.2 R0, R0, #9
    BRANCH.2 @asm_is_space_yes
    FELLOWSHIP.2 R0, R0, #10
    BRANCH.2 @asm_is_space_yes
    FELLOWSHIP.2 R0, R0, #13
    BRANCH.2 @asm_is_space_yes
    CREA.1 R0, R0, #0
    RETURN.0 R0, R0
asm_is_space_yes:
    CREA.1 R0, R0, #1
    RETURN.0 R0, R0

asm_is_digit:
    FELLOWSHIP.2 R0, R0, #48
    BRANCH.4 @asm_is_digit_no
    FELLOWSHIP.2 R0, R0, #57
    BRANCH.5 @asm_is_digit_yes
asm_is_digit_no:
    CREA.1 R0, R0, #0
    RETURN.0 R0, R0
asm_is_digit_yes:
    CREA.1 R0, R0, #1
    RETURN.0 R0, R0

asm_is_alpha:
    FELLOWSHIP.2 R0, R0, #65
    BRANCH.4 @asm_is_alpha_lower
    FELLOWSHIP.2 R0, R0, #90
    BRANCH.5 @asm_is_alpha_yes
asm_is_alpha_lower:
    FELLOWSHIP.2 R0, R0, #97
    BRANCH.4 @asm_is_alpha_no
    FELLOWSHIP.2 R0, R0, #122
    BRANCH.5 @asm_is_alpha_yes
asm_is_alpha_no:
    CREA.1 R0, R0, #0
    RETURN.0 R0, R0
asm_is_alpha_yes:
    CREA.1 R0, R0, #1
    RETURN.0 R0, R0

; ============================================================
; 解析数字 (十进制)
; 输入: R0 = 字符串指针
; 输出: R0 = 数值, R1 = 消耗的字符数
; ============================================================
asm_parse_decimal:
    PUSH_UP.1 R4, R4
    PUSH_UP.1 R5, R5
    PUSH_UP.1 R6, R6
    FELLOWSHIP.0 R4, R0
    CREA.1 R5, R5, #0
    CREA.1 R6, R6, #0
asm_parse_dec_loop:
    RECV.2 R0, R4
    FELLOWSHIP.2 R0, R0, #0
    BRANCH.2 @asm_parse_dec_done
    PUSH_UP.1 R1, R1
    FELLOWSHIP.0 R1, R0
    ABUNDANCE.1 R0, R0, @asm_is_digit
    FELLOWSHIP.2 R0, R0, #0
    BRANCH.2 @asm_parse_dec_done2
    WELL.1 R1, R1
    CREA.1 R0, R0, #10
    GATHER.2 R5, R0
    GATHER.1 R1, R1, #48
    GATHER.0 R5, R1
    MICRO.1 R6, R6
    MICRO.1 R4, R4
    BRANCH.1 @asm_parse_dec_loop
asm_parse_dec_done2:
    WELL.1 R1, R1
asm_parse_dec_done:
    FELLOWSHIP.0 R0, R5
    FELLOWSHIP.0 R1, R6
    WELL.1 R6, R6
    WELL.1 R5, R5
    WELL.1 R4, R4
    RETURN.0 R0, R0

; ============================================================
; 解析十六进制数字 (0-15)
; 输入: R0 = 字符
; 输出: R0 = 数值 (0-15), 无效返回 -1
; ============================================================
asm_hex_val:
    FELLOWSHIP.2 R0, R0, #48
    BRANCH.4 @asm_hex_not_digit
    FELLOWSHIP.2 R0, R0, #57
    BRANCH.5 @asm_hex_is_digit
    BRANCH.1 @asm_hex_check_upper
asm_hex_is_digit:
    GATHER.1 R0, R0, #48
    RETURN.0 R0, R0
asm_hex_not_digit:
asm_hex_check_upper:
    FELLOWSHIP.2 R0, R0, #65
    BRANCH.4 @asm_hex_check_lower
    FELLOWSHIP.2 R0, R0, #70
    BRANCH.5 @asm_hex_is_upper
    BRANCH.1 @asm_hex_check_lower
asm_hex_is_upper:
    GATHER.1 R0, R0, #55
    RETURN.0 R0, R0
asm_hex_check_lower:
    FELLOWSHIP.2 R0, R0, #97
    BRANCH.4 @asm_hex_invalid
    FELLOWSHIP.2 R0, R0, #102
    BRANCH.5 @asm_hex_is_lower
    BRANCH.1 @asm_hex_invalid
asm_hex_is_lower:
    GATHER.1 R0, R0, #87
    RETURN.0 R0, R0
asm_hex_invalid:
    CREA.1 R0, R0, #4294967295
    RETURN.0 R0, R0

; ============================================================
; 解析十六进制数字序列 (0x...)
; 输入: R0 = 字符串指针 (指向 'x' 之后)
; 输出: R0 = 数值
; ============================================================
asm_parse_hex:
    PUSH_UP.1 R4, R4
    PUSH_UP.1 R5, R5
    FELLOWSHIP.0 R4, R0
    CREA.1 R5, R5, #0
asm_parse_hex_loop:
    RECV.2 R0, R4
    FELLOWSHIP.2 R0, R0, #0
    BRANCH.2 @asm_parse_hex_done
    PUSH_UP.1 R1, R1
    FELLOWSHIP.0 R1, R0
    ABUNDANCE.1 R0, R0, @asm_hex_val
    FELLOWSHIP.2 R0, R0, #4294967295
    BRANCH.2 @asm_parse_hex_done2
    CREA.1 R1, R1, #16
    GATHER.2 R5, R1
    GATHER.0 R5, R0
    MICRO.1 R4, R4
    BRANCH.1 @asm_parse_hex_loop
asm_parse_hex_done2:
    WELL.1 R1, R1
asm_parse_hex_done:
    FELLOWSHIP.0 R0, R5
    WELL.1 R5, R5
    WELL.1 R4, R4
    RETURN.0 R0, R0

; ============================================================
; 跳过空白字符
; 输入: R0 = 字符串指针
; 输出: R0 = 跳过空白后的指针
; ============================================================
asm_skip_space:
    PUSH_UP.1 R4, R4
    FELLOWSHIP.0 R4, R0
asm_skip_sp_loop:
    RECV.2 R0, R4
    FELLOWSHIP.2 R0, R0, #32
    BRANCH.3 @asm_skip_sp_tab
    MICRO.1 R4, R4
    BRANCH.1 @asm_skip_sp_loop
asm_skip_sp_tab:
    FELLOWSHIP.2 R0, R0, #9
    BRANCH.3 @asm_skip_sp_done
    MICRO.1 R4, R4
    BRANCH.1 @asm_skip_sp_loop
asm_skip_sp_done:
    FELLOWSHIP.0 R0, R4
    WELL.1 R4, R4
    RETURN.0 R0, R0

; ============================================================
; 复制字符串到缓冲区
; 输入: R0 = 源指针, R1 = 目标缓冲区, R2 = 分隔符字符 (0 表示到空白)
; 输出: R0 = 源的新位置, R1 = 复制的字符数
; ============================================================
asm_copy_token:
    PUSH_UP.1 R4, R4
    PUSH_UP.1 R5, R5
    PUSH_UP.1 R6, R6
    FELLOWSHIP.0 R4, R0
    FELLOWSHIP.0 R5, R1
    CREA.1 R6, R6, #0
asm_copy_tok_loop:
    RECV.2 R0, R4
    FELLOWSHIP.2 R0, R0, #0
    BRANCH.2 @asm_copy_tok_done
    FELLOWSHIP.2 R0, R0, #10
    BRANCH.2 @asm_copy_tok_done
    FELLOWSHIP.2 R0, R0, #13
    BRANCH.2 @asm_copy_tok_done
    FELLOWSHIP.1 R0, R2
    BRANCH.2 @asm_copy_tok_done
    FELLOWSHIP.2 R2, R2, #0
    BRANCH.3 @asm_copy_tok_check_comma
    FELLOWSHIP.2 R0, R0, #32
    BRANCH.2 @asm_copy_tok_done
    FELLOWSHIP.2 R0, R0, #9
    BRANCH.2 @asm_copy_tok_done
    FELLOWSHIP.2 R0, R0, #44
    BRANCH.2 @asm_copy_tok_done
asm_copy_tok_check_comma:
    RECV.2 R0, R4
    ALLOC.2 R5, R0
    MICRO.1 R5, R5
    MICRO.1 R6, R6
    MICRO.1 R4, R4
    BRANCH.1 @asm_copy_tok_loop
asm_copy_tok_done:
    CREA.1 R0, R0, #0
    ALLOC.2 R5, R0
    FELLOWSHIP.0 R0, R4
    FELLOWSHIP.0 R1, R6
    WELL.1 R6, R6
    WELL.1 R5, R5
    WELL.1 R4, R4
    RETURN.0 R0, R0

; ============================================================
; 解析寄存器名 (R0-R31, SP, FP, LR)
; 输入: R0 = 字符串指针
; 输出: R0 = 寄存器编号 (0-31), 失败返回 4294967295
; ============================================================
asm_parse_reg:
    PUSH_UP.1 R4, R4
    PUSH_UP.1 R5, R5
    PUSH_UP.1 R6, R6
    FELLOWSHIP.0 R4, R0
    RECV.2 R5, R4
    FELLOWSHIP.2 R5, R5, #82
    BRANCH.3 @asm_parse_reg_special
    MICRO.1 R4, R4
    CREA.1 R6, R6, #0
asm_parse_reg_num_loop:
    RECV.2 R5, R4
    FELLOWSHIP.2 R5, R5, #0
    BRANCH.2 @asm_parse_reg_num_done
    FELLOWSHIP.0 R0, R5
    ABUNDANCE.1 R0, R0, @asm_is_digit
    FELLOWSHIP.2 R0, R0, #0
    BRANCH.2 @asm_parse_reg_num_done
    CREA.1 R0, R0, #10
    GATHER.2 R6, R0
    GATHER.1 R5, R5, #48
    GATHER.0 R6, R5
    MICRO.1 R4, R4
    BRANCH.1 @asm_parse_reg_num_loop
asm_parse_reg_num_done:
    FELLOWSHIP.1 R6, R6, #31
    BRANCH.6 @asm_parse_reg_fail
    FELLOWSHIP.0 R0, R6
    WELL.1 R6, R6
    WELL.1 R5, R5
    WELL.1 R4, R4
    RETURN.0 R0, R0
asm_parse_reg_special:
    FELLOWSHIP.2 R5, R5, #83
    BRANCH.3 @asm_parse_reg_fp
    MICRO.1 R4, R4
    RECV.2 R5, R4
    FELLOWSHIP.2 R5, R5, #80
    BRANCH.3 @asm_parse_reg_fail
    CREA.1 R0, R0, #29
    WELL.1 R6, R6
    WELL.1 R5, R5
    WELL.1 R4, R4
    RETURN.0 R0, R0
asm_parse_reg_fp:
    FELLOWSHIP.2 R5, R5, #70
    BRANCH.3 @asm_parse_reg_lr
    MICRO.1 R4, R4
    RECV.2 R5, R4
    FELLOWSHIP.2 R5, R5, #80
    BRANCH.3 @asm_parse_reg_fail
    CREA.1 R0, R0, #30
    WELL.1 R6, R6
    WELL.1 R5, R5
    WELL.1 R4, R4
    RETURN.0 R0, R0
asm_parse_reg_lr:
    FELLOWSHIP.2 R5, R5, #76
    BRANCH.3 @asm_parse_reg_fail
    MICRO.1 R4, R4
    RECV.2 R5, R4
    FELLOWSHIP.2 R5, R5, #82
    BRANCH.3 @asm_parse_reg_fail
    CREA.1 R0, R0, #31
    WELL.1 R6, R6
    WELL.1 R5, R5
    WELL.1 R4, R4
    RETURN.0 R0, R0
asm_parse_reg_fail:
    CREA.1 R0, R0, #4294967295
    WELL.1 R6, R6
    WELL.1 R5, R5
    WELL.1 R4, R4
    RETURN.0 R0, R0

; ============================================================
; IChing 助记符 → 操作码查找表
; 嵌入在代码中作为 DISPERSE 指令数据
; 每个条目: 助记符名(最多12字符, null填充) + 操作码(1字节)
; 共 64 个条目
; ============================================================
asm_lookup_opcode:
    PUSH_UP.1 R4, R4
    PUSH_UP.1 R5, R5
    PUSH_UP.1 R6, R6
    PUSH_UP.1 R7, R7
    FELLOWSHIP.0 R4, R0
    CREA.1 R5, R5, #0x16000
    CREA.1 R7, R7, #0
asm_lookup_loop:
    RECV.2 R0, R5
    FELLOWSHIP.2 R0, R0, #0
    BRANCH.2 @asm_lookup_not_found
    FELLOWSHIP.0 R0, R4
    CREA.1 R1, R1, #0x16000
    CREA.1 R2, R2, #13
    GATHER.2 R1, R2
    GATHER.0 R1, R7
    ABUNDANCE.1 R0, R0, @asm_strcmp
    FELLOWSHIP.2 R0, R0, #0
    BRANCH.2 @asm_lookup_found
    CREA.1 R0, R0, #14
    GATHER.0 R7, R0
    CREA.1 R0, R0, #0x16000
    GATHER.0 R5, R0
    GATHER.0 R5, R7
    BRANCH.1 @asm_lookup_loop
asm_lookup_found:
    CREA.1 R0, R0, #0x16000
    FELLOWSHIP.0 R5, R0
    GATHER.0 R5, R7
    CREA.1 R0, R0, #12
    GATHER.0 R5, R0
    RECV.2 R0, R5
    FELLOWSHIP.2 R0, R0, #255
    WELL.1 R7, R7
    WELL.1 R6, R6
    WELL.1 R5, R5
    WELL.1 R4, R4
    RETURN.0 R0, R0
asm_lookup_not_found:
    CREA.1 R0, R0, #4294967295
    WELL.1 R7, R7
    WELL.1 R6, R6
    WELL.1 R5, R5
    WELL.1 R4, R4
    RETURN.0 R0, R0

; ============================================================
; 初始化助记符表
; 用 DISPERSE 填充 64 个 IChing 助记符条目
; 格式: 12 字节名称 (ASCII, 0 填充) + 1 字节操作码 + 1 字节填充 = 14 字节/条目
; ============================================================
asm_init_opcode_table:
    PUSH_UP.1 R4, R4
    PUSH_UP.1 R5, R5
    PUSH_UP.1 R6, R6
    PUSH_UP.1 R7, R7
    CREA.1 R4, R4, #0x16000
    CREA.1 R5, R5, #0
    CREA.1 R6, R6, #64

    ; RECV:0
    CREA.1 R0, R0, #82
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    CREA.1 R0, R0, #69
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    CREA.1 R0, R0, #67
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    CREA.1 R0, R0, #86
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    CREA.1 R0, R0, #0
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    ALLOC.2 R4, R5
    MICRO.1 R4, R4
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    MICRO.1 R5, R5

    ; RETURN:1
    CREA.1 R0, R0, #82
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    CREA.1 R0, R0, #69
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    CREA.1 R0, R0, #84
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    CREA.1 R0, R0, #85
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    CREA.1 R0, R0, #82
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    CREA.1 R0, R0, #78
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    CREA.1 R0, R0, #0
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    ALLOC.2 R4, R5
    MICRO.1 R4, R4
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    MICRO.1 R5, R5

    ; BRANCH:2
    CREA.1 R0, R0, #66
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    CREA.1 R0, R0, #82
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    CREA.1 R0, R0, #65
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    CREA.1 R0, R0, #78
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    CREA.1 R0, R0, #67
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    CREA.1 R0, R0, #72
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    CREA.1 R0, R0, #0
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    ALLOC.2 R4, R5
    MICRO.1 R4, R4
    ALLOC.2 R4, R0
    MICRO.1 R4, R4
    MICRO.1 R5, R5

    ; 由于篇幅限制，使用循环填充剩余 61 个条目
    ; 条目格式: 各助记符名(12字节)+操作码(1字节)+填充(1字节)=14字节
    ; 助记符表已预先在 Python bootstrap 端构建，此处为非必须的运行时完整性代码
