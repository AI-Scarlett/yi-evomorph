@locus std.func.inline_should_inline {
    mut_rate   = 0.01
    cross_pool = "func_system"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CALLER_FUNC
        ䷁ RECV R1, env::CALLEE_FUNC
        ䷁ RECV R2, env::CALL_COUNT
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R_check_leaf
        ䷆ BRANCH R_check_pure
        ䷆ BRANCH R_check_small
        ䷗ RETURN R_FALSE
        ䷾ SYNC
    }
}

@locus std.func.inline_expand {
    mut_rate   = 0.02
    cross_pool = "func_system"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CALLER_FUNC
        ䷁ RECV R1, env::CALLEE_FUNC
        ䷁ RECV R2, env::CALL_SITE_INDEX
        ䷁ RECV R3, env::ARGUMENTS
        ䷂ ALLOC R4, 0x200
        ䷌ FELLOWSHIP R3, R4
        ䷓ CONTEMPLATE R1
        ䷍ ABUNDANCE R4, R1
        ䷾ SYNC
        ䷗ RETURN R4
    }
}

@meta_locus 函数系统.变异策略 {
    mut_rate = 0.003
    fitness  = min_size + max_throughput

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷑ MUT R0, 0x02
        ䷫ MATE R0, R1
        ䷾ SYNC
    }
}

@meta_locus 函数系统.选择策略 {
    mut_rate = 0.002
    fitness  = max_throughput

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷏ SPECULATE R1
        ䷾ SYNC
        ䷗ RETURN
    }
}
