@locus std.func.create_param {
    mut_rate   = 0.005
    cross_pool = "func_system"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::PARAM_NAME
        ䷁ RECV R1, env::PARAM_TYPE
        ䷁ RECV R2, env::PARAM_REG
        ䷁ RECV R3, env::PARAM_IS_OUTPUT
        ䷂ ALLOC R4, 0x20
        ䷍ ABUNDANCE R4, R0
        ䷍ ABUNDANCE R4, R1
        ䷍ ABUNDANCE R4, R2
        ䷍ ABUNDANCE R4, R3
        ䷗ RETURN R4
        ䷾ SYNC
    }
}

@locus std.func.create_signature {
    mut_rate   = 0.01
    cross_pool = "func_system"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::FUNC_NAME
        ䷁ RECV R1, env::PARAMS_LIST
        ䷁ RECV R2, env::RETURN_TYPE
        ䷁ RECV R3, env::VISIBILITY
        ䷁ RECV R4, env::CALLING_CONV
        ䷂ ALLOC R5, 0x40
        ䷍ ABUNDANCE R5, R0
        ䷍ ABUNDANCE R5, R1
        ䷍ ABUNDANCE R5, R2
        ䷍ ABUNDANCE R5, R3
        ䷍ ABUNDANCE R5, R4
        ䷗ RETURN R5
        ䷾ SYNC
    }
}

