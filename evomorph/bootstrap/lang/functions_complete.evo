    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::RETURN_ADDR
        ䷁ RECV R1, env::FRAME_POINTER
        ䷁ RECV R2, env::SAVED_REGS
        ䷁ RECV R3, env::LOCAL_VARS
        ䷁ RECV R4, env::FUNC_NAME
        ䷁ RECV R5, env::PARAM_VALUES
        ䷂ ALLOC R6, 0x60
        ䷍ ABUNDANCE R6, R0
        ䷍ ABUNDANCE R6, R1
        ䷍ ABUNDANCE R6, R2
        ䷍ ABUNDANCE R6, R3
        ䷍ ABUNDANCE R6, R4
        ䷍ ABUNDANCE R6, R5
        ䷗ RETURN R6
        ䷾ SYNC
    }
}

