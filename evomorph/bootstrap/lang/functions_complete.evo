@locus std.func.abi_get_param_reg {
    mut_rate   = 0.005
    cross_pool = "func_system"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::ABI
        ䷁ RECV R1, env::PARAM_INDEX
        ䷔ BITE R1, 0x06
        ䷆ BRANCH R_within_range
        ䷗ RETURN R_NULL
        ䷁ RECV R2, R0
        ䷗ RETURN R2
        ䷾ SYNC
    }
}

