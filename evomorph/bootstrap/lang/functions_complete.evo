@evolang "3.0"

@xiangci {
    "易衍·函数系统自举实现：以卦象之理，定义函数之基。
    "元·亨·利·贞四象限对应函数四大特性：元为创建之函数，亨为交互之函数，利为转换之函数，贞为终成之函数。
    "此实现涵盖：函数签名、函数注册、调用栈管理、调用约定、函数调用序列生成、内联扩展。
}

@locus std.func.visibility_public {
    mut_rate   = 0.001
    cross_pool = "func_system"
    fitness    = min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷂ ALLOC R0, 0x08
        ䷍ ABUNDANCE R0, 0x00
        ䷗ RETURN R0
        ䷾ SYNC
    }
}

