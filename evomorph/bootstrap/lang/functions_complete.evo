        ䷔ BITE R0, 0x06
        ䷆ BRANCH R_needs_stack
        ䷗ RETURN R_FALSE
        ䷗ RETURN R_TRUE
        ䷾ SYNC
    }
}

@locus std.func.gen_call_sequence {
    mut_rate   = 0.02
    cross_pool = "func_system"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::FUNC_NAME
        ䷁ RECV R1, env::ARGUMENTS
        ䷁ RECV R2, env::FUNC_DEF
        ䷂ ALLOC R3, 0x100
        ䷌ FELLOWSHIP R1, R3
        ䷀ CREA R4, R0
        ䷾ SYNC
        ䷗ RETURN R3
    }
}

