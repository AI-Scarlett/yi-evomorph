@locus std.types.create_primitive {
    mut_rate   = 0.005
    cross_pool = "type_system"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::TYPE_KIND
        ䷁ RECV R1, env::TYPE_SIZE
        ䷁ RECV R2, env::TYPE_ALIGNMENT
        ䷁ RECV R3, env::TYPE_CATEGORY
        ䷂ ALLOC R4, 0x20
        ䷍ ABUNDANCE R4, R0
        ䷍ ABUNDANCE R4, R1
        ䷍ ABUNDANCE R4, R2
        ䷍ ABUNDANCE R4, R3
        ䷗ RETURN R4
        ䷾ SYNC
    }
}

