    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::RETURN_TYPE
        ䷁ RECV R1, env::PARAM_TYPES
        ䷂ ALLOC R2, 0x60
        ䷍ ABUNDANCE R2, 0x07
        ䷍ ABUNDANCE R2, 0x08
        ䷍ ABUNDANCE R2, 0x08
        ䷍ ABUNDANCE R2, 0x00
        ䷍ ABUNDANCE R2, R0
        ䷍ ABUNDANCE R2, R1
        ䷗ RETURN R2
        ䷾ SYNC
