    卦序: {
        ䷁ RECV R0, env::ELEMENT_TYPE
        ䷁ RECV R1, env::ARRAY_LENGTH
        ䷂ ALLOC R2, 0x40
        ䷍ ABUNDANCE R2, 0x05
        ䷍ ABUNDANCE R2, R0
        ䷍ ABUNDANCE R2, R1
        ䷗ RETURN R2
        ䷾ SYNC
