}

@locus std.types.compare {
    mut_rate   = 0.01
    cross_pool = "type_system"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::TYPE_A
        ䷁ RECV R1, env::TYPE_B
        ䷓ CONTEMPLATE R0
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R_same_kind
        ䷗ RETURN R_FALSE
        ䷔ BITE R0, R1
        ䷆ BRANCH R_same_size
        ䷗ RETURN R_FALSE
        ䷔ BITE R0, R1
        ䷆ BRANCH R_same_alignment
        ䷗ RETURN R_FALSE
        ䷗ RETURN R_TRUE
        ䷾ SYNC
    }
}

@locus std.types.unify {
    mut_rate   = 0.02
    cross_pool = "type_system"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::TYPE_A
        ䷁ RECV R1, env::TYPE_B
        ䷓ CONTEMPLATE R0
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R_check_type_var_a
        ䷆ BRANCH R_check_type_var_b
        ䷔ BITE R0, R1
        ䷆ BRANCH R_same_type
        ䷆ BRANCH R_check_integer_promotion
        ䷆ BRANCH R_check_pointer_unify
        ䷗ RETURN R_NULL
        ䷾ SYNC
    }
}

@locus std.types.check_compatibility {
    mut_rate   = 0.01
    cross_pool = "type_system"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::EXPECTED_TYPE
        ䷁ RECV R1, env::ACTUAL_TYPE
        ䷓ CONTEMPLATE R0
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R_exact_match
        ䷆ BRANCH R_integer_promotion
        ䷆ BRANCH R_pointer_compatible
        ䷗ RETURN R_INCOMPATIBLE
        ䷾ SYNC
    }
}

@locus std.types.infer_category_from_opcode {
    mut_rate   = 0.005
    cross_pool = "type_system"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::OPCODE
        ䷔ BITE R0, 0x3F
        ䷆ BRANCH R_check_yuan_category
        ䷔ BITE R0, 0x2F
        ䷆ BRANCH R_check_heng_category
        ䷔ BITE R0, 0x1F
        ䷆ BRANCH R_check_li_category
        ䷗ RETURN R_ZHEN
        ䷾ SYNC
    }
}

@locus std.types.env_lookup {
    mut_rate   = 0.01
    cross_pool = "type_system"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::TYPE_ENV
        ䷁ RECV R1, env::SYMBOL_NAME
        ䷓ CONTEMPLATE R0
        ䷆ BRANCH R_search_bindings
        ䷆ BRANCH R_search_parent
        ䷗ RETURN R_NULL
        ䷾ SYNC
    }
}

@locus std.types.env_bind {
    mut_rate   = 0.01
    cross_pool = "type_system"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::TYPE_ENV
        ䷁ RECV R1, env::SYMBOL_NAME
        ䷁ RECV R2, env::SYMBOL_TYPE
        ䷓ CONTEMPLATE R0
        ䷍ ABUNDANCE R0, R1
        ䷍ ABUNDANCE R0, R2
        ䷾ SYNC
    }
}

@locus std.types.check_operand_types {
    mut_rate   = 0.02
    cross_pool = "type_system"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::OPCODE
        ䷁ RECV R1, env::OPERAND_TYPES
        ䷁ RECV R2, env::TYPE_CATEGORY
        ䷓ CONTEMPLATE R2
        ䷆ BRANCH R_yuan_category_check
        ䷆ BRANCH R_heng_category_check
        ䷆ BRANCH R_li_category_check
        ䷗ RETURN R_VALID
        ䷾ SYNC
    }
}

@meta_locus 类型系统.变异策略 {
    mut_rate = 0.003
    fitness  = min_size + max_throughput

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷑ MUT R0, 0x02
        ䷫ MATE R0, R1
        ䷾ SYNC
    }
}

@meta_locus 类型系统.选择策略 {
    mut_rate = 0.002
    fitness  = max_throughput

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷏ SPECULATE R1
        ䷾ SYNC
        ䷗ RETURN
    }
}
