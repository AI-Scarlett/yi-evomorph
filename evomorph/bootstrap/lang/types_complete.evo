@evolang "3.0"

@xiangci {
    "易衍·类型系统自举实现：以卦象之理，定义类型之基。
    "元·亨·利·贞四象限对应类型四大类：元为创生之类型，亨为交互之类型，利为转换之类型，贞为终成之类型。
    "此实现涵盖：类型枚举定义、类型比较、类型统一、类型检查、类型环境。
}

@locus std.types.kind_integer {
    mut_rate   = 0.001
    cross_pool = "type_system"
    fitness    = min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷂ ALLOC R0, 0x08
        ䷍ ABUNDANCE R0, 0x00
        ䷗ RETURN R0
        ䷾ SYNC
    }
}

