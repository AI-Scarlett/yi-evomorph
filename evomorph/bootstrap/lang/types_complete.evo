        ䷁ RECV R0, env::POINTEE_TYPE
        ䷂ ALLOC R1, 0x40
        ䷍ ABUNDANCE R1, 0x04
        ䷍ ABUNDANCE R1, 0x08
        ䷍ ABUNDANCE R1, 0x08
        ䷍ ABUNDANCE R1, 0x00
        ䷍ ABUNDANCE R1, R0
        ䷗ RETURN R1
