@evolang "3.0"

@xiangci {
    "易衍·Evomorph 完全自举实现"
    "道枢自举：编译器用自身之语言书写自身"
    "此文件包含：词法分析器、语法分析器、代码生成器、虚拟机、标准库、进化引擎、CLI工具"
    "目标：完全摆脱Python/C/JavaScript依赖，实现真正的自举"
}

@meta_locus 自举编译器.全局配置 {
    mut_rate = 0.001
    fitness  = max_throughput + min_size

    卦序: {
        ䷂ ALLOC R0, 0x04
        ䷍ ABUNDANCE R0, 0x03
        ䷾ SYNC
    }
}

@locus evoc.bootstrap.init {
    mut_rate   = 0.001
    cross_pool = "evoc_core"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷂ ALLOC R0, 0x100
        ䷂ ALLOC R1, 0x100
        ䷂ ALLOC R2, 0x100
        ䷂ ALLOC R3, 0x100
        ䷍ ABUNDANCE R0, 0x00
        ䷍ ABUNDANCE R1, 0x00
        ䷍ ABUNDANCE R2, 0x00
        ䷍ ABUNDANCE R3, 0x00
        ䷾ SYNC
    }
}

@locus evoc.core.memory_copy {
    mut_rate   = 0.001
    cross_pool = "evoc_core"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::SRC_ADDR
        ䷁ RECV R1, env::DST_ADDR
        ䷁ RECV R2, env::LENGTH
        ䷂ ALLOC R3, 0x04
        ䷍ ABUNDANCE R3, 0x00
        ䷓ CONTEMPLATE R2
        ䷆ BRANCH R_copy_loop_start
        ䷗ RETURN
        ䷁ RECV R4, env::SRC_ADDR
        ䷈ PREFETCH R4
        ䷍ ABUNDANCE R1, R4
        ䷉ STEP R0
        ䷉ STEP R1
        ䷉ STEP R3
        ䷨ REDUCE R2, 0x01
        ䷾ SYNC
    }
}

@locus evoc.core.memory_compare {
    mut_rate   = 0.001
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::SRC1
        ䷁ RECV R1, env::SRC2
        ䷁ RECV R2, env::LENGTH
        ䷂ ALLOC R3, 0x04
        ䷍ ABUNDANCE R3, 0x00
        ䷓ CONTEMPLATE R2
        ䷆ BRANCH R_cmp_loop_start
        ䷍ ABUNDANCE R0, 0x00
        ䷗ RETURN
        ䷁ RECV R4, env::SRC1
        ䷁ RECV R5, env::SRC2
        ䷈ PREFETCH R4
        ䷈ PREFETCH R5
        ䷔ BITE R4, R5
        ䷆ BRANCH R_cmp_not_equal
        ䷉ STEP R0
        ䷉ STEP R1
        ䷨ REDUCE R2, 0x01
        ䷾ SYNC
    }
}

@locus evoc.core.string_length {
    mut_rate   = 0.001
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::STR_ADDR
        ䷂ ALLOC R1, 0x04
        ䷍ ABUNDANCE R1, 0x00
        ䷓ CONTEMPLATE R0
        ䷆ BRANCH R_len_loop_start
        ䷍ ABUNDANCE R0, R1
        ䷗ RETURN
        ䷁ RECV R2, env::STR_ADDR
        ䷈ PREFETCH R2
        ䷔ BITE R2, 0x00
        ䷆ BRANCH R_len_end
        ䷉ STEP R0
        ䷉ STEP R1
        ䷾ SYNC
    }
}

@locus evoc.lexer.token_type {
    mut_rate   = 0.001
    cross_pool = "evoc_core"
    fitness    = min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷂ ALLOC R0, 0x20
        ䷍ ABUNDANCE R0, 0x00
        ䷍ ABUNDANCE R0, 0x01
        ䷍ ABUNDANCE R0, 0x02
        ䷍ ABUNDANCE R0, 0x03
        ䷍ ABUNDANCE R0, 0x04
        ䷍ ABUNDANCE R0, 0x05
        ䷍ ABUNDANCE R0, 0x06
        ䷍ ABUNDANCE R0, 0x07
        ䷍ ABUNDANCE R0, 0x08
        ䷍ ABUNDANCE R0, 0x09
        ䷍ ABUNDANCE R0, 0x0A
        ䷍ ABUNDANCE R0, 0x0B
        ䷍ ABUNDANCE R0, 0x0C
        ䷍ ABUNDANCE R0, 0x0D
        ䷍ ABUNDANCE R0, 0x0E
        ䷍ ABUNDANCE R0, 0x0F
        ䷾ SYNC
    }
}

@locus evoc.lexer.init {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷂ ALLOC R0, 0x04
        ䷂ ALLOC R1, 0x04
        ䷂ ALLOC R2, 0x04
        ䷂ ALLOC R3, 0x04
        ䷂ ALLOC R4, 0x04
        ䷂ ALLOC R5, 0x04
        ䷍ ABUNDANCE R0, 0x00
        ䷍ ABUNDANCE R1, 0x01
        ䷍ ABUNDANCE R2, 0x01
        ䷍ ABUNDANCE R3, 0x00
        ䷍ ABUNDANCE R4, 0x00
        ䷍ ABUNDANCE R5, 0x00
        ䷾ SYNC
    }
}

@locus evoc.lexer.advance {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::LEXER_STATE
        ䷉ STEP R0
        ䷉ STEP R0
        ䷓ CONTEMPLATE R0
        ䷔ BITE R0, 0x0A
        ䷆ BRANCH R_lexer_newline
        ䷉ STEP R0
        ䷾ SYNC
    }
}

@locus evoc.lexer.peek {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::SOURCE_PTR
        ䷁ RECV R1, env::OFFSET
        ䷩ INCREASE R0, R1
        ䷈ PREFETCH R0
        ䷾ SYNC
    }
}

@locus evoc.lexer.is_whitespace {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CHAR
        ䷔ BITE R0, 0x20
        ䷆ BRANCH R_is_space
        ䷔ BITE R0, 0x09
        ䷆ BRANCH R_is_tab
        ䷔ BITE R0, 0x0D
        ䷆ BRANCH R_is_cr
        ䷍ ABUNDANCE R0, 0x00
        ䷗ RETURN
        ䷍ ABUNDANCE R0, 0x01
        ䷾ SYNC
    }
}

@locus evoc.lexer.is_digit {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CHAR
        ䷔ BITE R0, 0x30
        ䷆ BRANCH R_below_zero
        ䷔ BITE R0, 0x39
        ䷆ BRANCH R_above_nine
        ䷍ ABUNDANCE R0, 0x01
        ䷗ RETURN
        ䷍ ABUNDANCE R0, 0x00
        ䷾ SYNC
    }
}

@locus evoc.lexer.is_alpha {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CHAR
        ䷔ BITE R0, 0x41
        ䷆ BRANCH R_below_A
        ䷔ BITE R0, 0x5A
        ䷆ BRANCH R_above_Z
        ䷍ ABUNDANCE R0, 0x01
        ䷗ RETURN
        ䷔ BITE R0, 0x61
        ䷆ BRANCH R_below_a
        ䷔ BITE R0, 0x7A
        ䷆ BRANCH R_above_z
        ䷍ ABUNDANCE R0, 0x01
        ䷗ RETURN
        ䷔ BITE R0, 0x5F
        ䷆ BRANCH R_is_underscore
        ䷍ ABUNDANCE R0, 0x00
        ䷾ SYNC
    }
}

@locus evoc.lexer.is_hexagram_symbol {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CHAR
        ䷔ BITE R0, 0x4DC0
        ䷆ BRANCH R_below_first_hex
        ䷔ BITE R0, 0x4DFF
        ䷆ BRANCH R_above_last_hex
        ䷍ ABUNDANCE R0, 0x01
        ䷗ RETURN
        ䷍ ABUNDANCE R0, 0x00
        ䷾ SYNC
    }
}

@locus evoc.lexer.scan_identifier {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = max_throughput + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::SOURCE_PTR
        ䷂ ALLOC R1, 0x40
        ䷂ ALLOC R2, 0x04
        ䷍ ABUNDANCE R2, 0x00
        ䷓ CONTEMPLATE R0
        ䷆ BRANCH R_id_scan_loop
        ䷍ ABUNDANCE R0, R1
        ䷗ RETURN
        ䷁ RECV R3, env::SOURCE_PTR
        ䷈ PREFETCH R3
        ䷀ CREA R4, @is_alpha
        ䷔ BITE R4, 0x01
        ䷆ BRANCH R_id_alpha_true
        ䷀ CREA R4, @is_digit
        ䷔ BITE R4, 0x01
        ䷆ BRANCH R_id_digit_true
        ䷆ BRANCH R_id_scan_end
        ䷍ ABUNDANCE R1, R3
        ䷉ STEP R0
        ䷉ STEP R1
        ䷉ STEP R2
        ䷾ SYNC
    }
}

@locus evoc.lexer.scan_number {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::SOURCE_PTR
        ䷂ ALLOC R1, 0x20
        ䷂ ALLOC R2, 0x04
        ䷂ ALLOC R3, 0x04
        ䷍ ABUNDANCE R2, 0x00
        ䷍ ABUNDANCE R3, 0x0A
        ䷓ CONTEMPLATE R0
        ䷆ BRANCH R_num_scan_loop
        ䷍ ABUNDANCE R0, R1
        ䷗ RETURN
        ䷁ RECV R4, env::SOURCE_PTR
        ䷈ PREFETCH R4
        ䷀ CREA R5, @is_digit
        ䷔ BITE R5, 0x01
        ䷆ BRANCH R_num_digit_true
        ䷆ BRANCH R_num_scan_end
        ䷍ ABUNDANCE R1, R4
        ䷉ STEP R0
        ䷉ STEP R1
        ䷉ STEP R2
        ䷾ SYNC
    }
}

@locus evoc.lexer.scan_string {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::SOURCE_PTR
        ䷂ ALLOC R1, 0x100
        ䷂ ALLOC R2, 0x04
        ䷍ ABUNDANCE R2, 0x00
        ䷉ STEP R0
        ䷓ CONTEMPLATE R0
        ䷆ BRANCH R_str_scan_loop
        ䷍ ABUNDANCE R0, R1
        ䷗ RETURN
        ䷁ RECV R3, env::SOURCE_PTR
        ䷈ PREFETCH R3
        ䷔ BITE R3, 0x22
        ䷆ BRANCH R_str_end_quote
        ䷔ BITE R3, 0x5C
        ䷆ BRANCH R_str_escape
        ䷍ ABUNDANCE R1, R3
        ䷉ STEP R0
        ䷉ STEP R1
        ䷉ STEP R2
        ䷾ SYNC
    }
}

@locus evoc.lexer.skip_comment {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::SOURCE_PTR
        ䷓ CONTEMPLATE R0
        ䷆ BRANCH R_comment_loop
        ䷗ RETURN
        ䷁ RECV R1, env::SOURCE_PTR
        ䷈ PREFETCH R1
        ䷔ BITE R1, 0x0A
        ䷆ BRANCH R_comment_newline
        ䷉ STEP R0
        ䷾ SYNC
    }
}

@locus evoc.lexer.tokenize {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = max_throughput + min_energy
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::SOURCE_CODE
        ䷀ CREA R1, @init
        ䷓ CONTEMPLATE R0
        ䷆ BRANCH R_tokenize_main_loop
        ䷗ RETURN
        ䷁ RECV R2, env::SOURCE_PTR
        ䷈ PREFETCH R2
        ䷀ CREA R3, @is_whitespace
        ䷔ BITE R3, 0x01
        ䷆ BRANCH R_tok_whitespace
        ䷔ BITE R2, 0x2F
        ䷆ BRANCH R_tok_slash
        ䷀ CREA R3, @is_hexagram_symbol
        ䷔ BITE R3, 0x01
        ䷆ BRANCH R_tok_hexagram
        ䷔ BITE R2, 0x22
        ䷆ BRANCH R_tok_string
        ䷀ CREA R3, @is_digit
        ䷔ BITE R3, 0x01
        ䷆ BRANCH R_tok_number
        ䷀ CREA R3, @is_alpha
        ䷔ BITE R3, 0x01
        ䷆ BRANCH R_tok_identifier
        ䷉ STEP R0
        ䷾ SYNC
    }
}

@locus evoc.parser.init {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷂ ALLOC R0, 0x04
        ䷂ ALLOC R1, 0x04
        ䷂ ALLOC R2, 0x04
        ䷂ ALLOC R3, 0x04
        ䷍ ABUNDANCE R0, 0x00
        ䷍ ABUNDANCE R1, 0x00
        ䷍ ABUNDANCE R2, 0x00
        ䷍ ABUNDANCE R3, 0x00
        ䷾ SYNC
    }
}

@locus evoc.parser.current_token {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::PARSER_STATE
        ䷁ RECV R1, env::TOKEN_STREAM
        ䷈ PREFETCH R1
        ䷾ SYNC
    }
}

@locus evoc.parser.advance {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::PARSER_STATE
        ䷉ STEP R0
        ䷾ SYNC
    }
}

@locus evoc.parser.expect {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::EXPECTED_TYPE
        ䷁ RECV R1, env::ACTUAL_TYPE
        ䷔ BITE R0, R1
        ䷆ BRANCH R_parser_expect_match
        ䷛ OVERLOAD R_parser_expect_error
        ䷾ SYNC
    }
}

@locus evoc.parser.match {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::EXPECTED_TYPE
        ䷁ RECV R1, env::ACTUAL_TYPE
        ䷔ BITE R0, R1
        ䷆ BRANCH R_parser_match_no
        ䷉ STEP R1
        ䷗ RETURN
        ䷾ SYNC
    }
}

@locus evoc.parser.skip_newlines {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CURRENT_TOKEN
        ䷓ CONTEMPLATE R0
        ䷔ BITE R0, 0x0A
        ䷆ BRANCH R_parser_skip_nl
        ䷗ RETURN
        ䷉ STEP R0
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_evolang {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::TOKEN_STREAM
        ䷂ ALLOC R1, 0x08
        ䷍ ABUNDANCE R1, R0
        ䷁ RECV R2, env::VERSION_STRING
        ䷂ ALLOC R3, 0x10
        ䷍ ABUNDANCE R3, R2
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_locus {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = max_throughput + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::LOCUS_KW
        ䷁ RECV R1, env::LOCUS_NAME
        ䷂ ALLOC R2, 0x200
        ䷌ FELLOWSHIP R0, R2
        ䷓ CONTEMPLATE R2
        ䷆ BRANCH R_parse_locus_attrs
        ䷆ BRANCH R_parse_guaxu
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_locus_name {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CURRENT_TOKEN
        ䷂ ALLOC R1, 0x40
        ䷌ FELLOWSHIP R0, R1
        ䷓ CONTEMPLATE R1
        ䷉ STEP R1
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_mut_rate {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::MUT_RATE_KW
        ䷁ RECV R1, env::ASSIGN_OP
        ䷁ RECV R2, env::FLOAT_VALUE
        ䷂ ALLOC R3, 0x08
        ䷍ ABUNDANCE R3, R2
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_fitness {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::FITNESS_KW
        ䷁ RECV R1, env::ASSIGN_OP
        ䷂ ALLOC R2, 0x100
        ䷌ FELLOWSHIP R0, R2
        ䷓ CONTEMPLATE R2
        ䷆ BRANCH R_parse_fitness_terms
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_env_target {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::ENV_TARGET_KW
        ䷁ RECV R1, env::ASSIGN_OP
        ䷁ RECV R2, env::LBRACKET
        ䷂ ALLOC R3, 0x40
        ䷌ FELLOWSHIP R2, R3
        ䷓ CONTEMPLATE R3
        ䷆ BRANCH R_parse_platform_list
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_max_generations {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::MAX_GEN_KW
        ䷁ RECV R1, env::ASSIGN_OP
        ䷁ RECV R2, env::NUMBER_VALUE
        ䷂ ALLOC R3, 0x08
        ䷍ ABUNDANCE R3, R2
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_gua_xu {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = max_throughput + min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::GUA_XU_KW
        ䷂ ALLOC R1, 0x1000
        ䷌ FELLOWSHIP R0, R1
        ䷉ STEP R1
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R_parse_instructions
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_instruction {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = max_throughput + min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::HEXAGRAM_OR_MNEMONIC
        ䷓ CONTEMPLATE R0
        ䷂ ALLOC R1, 0x08
        ䷍ ABUNDANCE R1, R0
        ䷁ RECV R2, env::OPERANDS
