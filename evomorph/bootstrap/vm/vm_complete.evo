@evolang "3.0"

@xiangci {
    "卦象虚拟机（IChingVM）完整实现：执行六十四卦字节码，如卦象之变易生生不息。"
    "道枢自举之四——虚拟机用自身之语言书写自身之执行引擎。"
    "此实现涵盖：寄存器管理、栈管理、堆管理、指令解码、指令执行、状态管理、IO处理。"
}

@locus evoc.vm.init {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷂ ALLOC R0, 0x10
        ䷂ ALLOC R1, 0x10000
        ䷂ ALLOC R2, 0x100000
        ䷀ CREA R3, R0
        ䷌ FELLOWSHIP R0, R1
        ䷌ FELLOWSHIP R1, R2
        ䷾ SYNC
    }
}

@locus evoc.vm.init_registers {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::REG_COUNT
        ䷂ ALLOC R1, 0x40
        ䷀ CREA R2, R1
        ䷉ STEP R2
        ䷓ CONTEMPLATE R2
        ䷍ ABUNDANCE R2, 0x00
        ䷾ SYNC
    }
}

@locus evoc.vm.init_stack {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷂ ALLOC R0, 0x10000
        ䷁ RECV R1, env::STACK_SIZE
        ䷌ FELLOWSHIP R0, R1
        ䷍ ABUNDANCE R0, 0x00
        ䷾ SYNC
    }
}

@locus evoc.vm.init_heap {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷂ ALLOC R0, 0x100000
        ䷁ RECV R1, env::HEAP_SIZE
        ䷌ FELLOWSHIP R0, R1
        ䷍ ABUNDANCE R0, 0x00
        ䷾ SYNC
    }
}

@locus evoc.vm.load_program {
    mut_rate   = 0.01
    cross_pool = "vm_core"
    fitness    = max_throughput + min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::BYTECODE
        ䷂ ALLOC R1, 0x100000
        ䷌ FELLOWSHIP R0, R1
        ䷉ STEP R0
        ䷓ CONTEMPLATE R0
        ䷍ ABUNDANCE R1, R0
        ䷾ SYNC
    }
}

@locus evoc.vm.decode_instruction {
    mut_rate   = 0.01
    cross_pool = "vm_core"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::PC
        ䷁ RECV R1, env::PROGRAM
        ䷂ ALLOC R2, 0x04
        ䷍ ABUNDANCE R2, R1
        ䷆ BRANCH R_extract_opcode
        ䷆ BRANCH R_extract_modifier
        ䷾ SYNC
    }
}

@locus evoc.vm.decode_opcode {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::INSTR_BYTE1
        ䷂ ALLOC R1, 0x04
        ䷍ ABUNDANCE R1, R0
        ䷰ REPLACE R1, 0x3F
        ䷾ SYNC
    }
}

@locus evoc.vm.decode_modifier {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::INSTR_BYTE1
        ䷁ RECV R1, env::INSTR_BYTE2
        ䷂ ALLOC R2, 0x04
        ䷍ ABUNDANCE R2, R0
        ䷰ REPLACE R2, 0x03
        ䷩ INCREASE R2, R1
        ䷾ SYNC
    }
}

@locus evoc.vm.execute_op_crea {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::DST_REG
        ䷁ RECV R1, env::THREAD_ID
        ䷍ ABUNDANCE R0, R1
        ䷾ SYNC
    }
}

@locus evoc.vm.execute_op_recv {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::DST_REG
        ䷁ RECV R1, env::PORT
        ䷆ BRANCH R_check_io_handler
        ䷍ ABUNDANCE R0, 0x00
        ䷾ SYNC
    }
}

@locus evoc.vm.execute_op_alloc {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::DST_REG
        ䷁ RECV R1, env::SIZE
        ䷁ RECV R2, env::HEAP_PTR
        ䷩ INCREASE R2, R1
        ䷍ ABUNDANCE R0, R2
        ䷾ SYNC
    }
}

@locus evoc.vm.execute_op_wait {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::COND_REG
        ䷓ CONTEMPLATE R0
        ䷆ BRANCH R_condition_zero
        ䷗ RETURN
        ䷁ RECV R1, env::PC
        ䷨ REDUCE R1, 0x02
        ䷾ SYNC
    }
}

@locus evoc.vm.execute_op_lock {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::LOCK_ID
        ䷓ CONTEMPLATE R0
        ䷆ BRANCH R_lock_held
        ䷍ ABUNDANCE R0, 0x01
        ䷾ SYNC
    }
}

@locus evoc.vm.execute_op_branch {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::COND_REG
        ䷁ RECV R1, env::TARGET_ADDR
        ䷓ CONTEMPLATE R0
        ䷆ BRANCH R_condition_non_zero
        ䷗ RETURN
        ䷍ ABUNDANCE R0, R1
        ䷾ SYNC
    }
}

@locus evoc.vm.execute_op_merge {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::DST_REG
        ䷁ RECV R1, env::SRC_REG
        ䷌ FELLOWSHIP R0, R1
        ䷾ SYNC
    }
}

@locus evoc.vm.execute_op_fellowship {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::DST_REG
        ䷁ RECV R1, env::SRC_REG
        ䷍ ABUNDANCE R0, R1
        ䷾ SYNC
    }
}

@locus evoc.vm.execute_op_abundance {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::ADDR_REG
        ䷁ RECV R1, env::SRC_REG
        ䷁ RECV R2, env::HEAP
        ䷍ ABUNDANCE R2, R1
        ䷾ SYNC
    }
}

@locus evoc.vm.execute_op_yield {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::VM_STATE
        ䷍ ABUNDANCE R0, 0x02
        ䷾ SYNC
    }
}

@locus evoc.vm.execute_op_mut {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::TARGET_REG
        ䷁ RECV R1, env::BIT_POS
        ䷑ MUT R0, R1
        ䷾ SYNC
    }
}

@locus evoc.vm.execute_op_contemplate {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::TARGET_REG
        ䷁ RECV R1, env::CYCLE_COUNT
        ䷍ ABUNDANCE R0, R1
        ䷾ SYNC
    }
}

@locus evoc.vm.execute_op_return {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CALL_STACK
        ䷓ CONTEMPLATE R0
        ䷆ BRANCH R_stack_empty
        ䷁ RECV R1, env::PC
        ䷍ ABUNDANCE R1, R0
        ䷾ SYNC
    }
}

@locus evoc.vm.execute_op_sync {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::BARRIER_ID
        ䷁ RECV R1, env::BARRIER_COUNT
        ䷩ INCREASE R1, 0x01
        ䷍ ABUNDANCE R0, R1
        ䷾ SYNC
    }
}

@locus evoc.vm.execute_op_mate {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::DST_REG
        ䷁ RECV R1, env::SRC_REG
        ䷫ MATE R0, R1
        ䷾ SYNC
    }
}

@locus evoc.vm.execute_op_gather {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::DST_REG
        ䷁ RECV R1, env::SRC_REG
        ䷩ INCREASE R0, R1
        ䷾ SYNC
    }
}

@locus evoc.vm.execute_op_push_up {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::REG_VAL
        ䷁ RECV R1, env::SP
        ䷨ REDUCE R1, 0x01
        ䷍ ABUNDANCE R1, R0
        ䷾ SYNC
    }
}

@locus evoc.vm.execute_op_well {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::DST_REG
        ䷁ RECV R1, env::SP
        ䷍ ABUNDANCE R0, R1
        ䷩ INCREASE R1, 0x01
        ䷾ SYNC
    }
}

@locus evoc.vm.execute_op_illuminate {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::REG_VAL
        ䷝ ILLUMINATE R0
        ䷾ SYNC
    }
}

@locus evoc.vm.step {
    mut_rate   = 0.01
    cross_pool = "vm_core"
    fitness    = max_throughput + min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::PC
        ䷁ RECV R1, env::PROGRAM
        ䷂ ALLOC R2, 0x08
        ䷍ ABUNDANCE R2, R1
        ䷆ BRANCH R_decode_opcode
        ䷆ BRANCH R_decode_modifier
        ䷆ BRANCH R_read_operands
        ䷆ BRANCH R_execute
        ䷾ SYNC
    }
}

@locus evoc.vm.run {
    mut_rate   = 0.02
    cross_pool = "vm_core"
    fitness    = max_throughput + min_energy
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::MAX_CYCLES
        ䷂ ALLOC R1, 0x04
        ䷀ CREA R1, R0
        ䷉ STEP R1
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R_check_halt
        ䷆ BRANCH R_step
        ䷾ SYNC
    }
}

@locus evoc.vm.reset {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷂ ALLOC R0, 0x10
        ䷂ ALLOC R1, 0x10000
        ䷂ ALLOC R2, 0x100000
        ䷍ ABUNDANCE R0, 0x00
        ䷍ ABUNDANCE R1, 0x00
        ䷍ ABUNDANCE R2, 0x00
        ䷾ SYNC
    }
}

@locus evoc.vm.dump_state {
    mut_rate   = 0.01
    cross_pool = "vm_core"
    fitness    = min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::REGISTERS
        ䷁ RECV R1, env::PC
        ䷁ RECV R2, env::STATE
        ䷂ ALLOC R3, 0x100
        ䷍ ABUNDANCE R3, R0
        ䷍ ABUNDANCE R3, R1
        ䷍ ABUNDANCE R3, R2
        ䷾ SYNC
    }
}

@meta_locus 虚拟机.变异策略 {
    mut_rate = 0.005
    fitness  = max_throughput + min_size

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷑ MUT R0, 0x03
        ䷫ MATE R0, R1
        ䷾ SYNC
    }
}

@meta_locus 虚拟机.选择策略 {
    mut_rate = 0.003
    fitness  = max_throughput

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷏ SPECULATE R1
        ䷾ SYNC
        ䷗ RETURN
    }
}
