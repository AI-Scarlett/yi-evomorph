}

@locus std.analysis.uninitialized_collect_vars {
    mut_rate   = 0.01
    cross_pool = "analysis_system"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::INSTRUCTIONS
        ䷂ ALLOC R1, 0x40
        ䷓ CONTEMPLATE R0
        ䷆ BRANCH R_iterate_instrs
        ䷆ BRANCH R_collect_registers
        ䷗ RETURN R1
        ䷾ SYNC
    }
}

@locus std.analysis.uninitialized_analyze {
    mut_rate   = 0.02
    cross_pool = "analysis_system"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CFG
        ䷁ RECV R1, env::INSTRUCTIONS
        ䷂ ALLOC R2, 0x80
        ䷌ FELLOWSHIP R0, R2
        ䷆ BRANCH R_run_reaching_defs
        ䷆ BRANCH R_check_uninitialized
        ䷗ RETURN R2
        ䷾ SYNC
    }
}

@locus std.analysis.dead_code_init {
    mut_rate   = 0.005
    cross_pool = "analysis_system"
    fitness    = min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CFG
        ䷁ RECV R1, env::INSTRUCTIONS
        ䷂ ALLOC R2, 0x80
        ䷍ ABUNDANCE R2, R0
        ䷍ ABUNDANCE R2, R1
        ䷗ RETURN R2
        ䷾ SYNC
    }
}

@locus std.analysis.dead_code_analyze {
    mut_rate   = 0.02
    cross_pool = "analysis_system"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CFG
        ䷁ RECV R1, env::INSTRUCTIONS
        ䷂ ALLOC R2, 0x80
        ䷌ FELLOWSHIP R0, R2
        ䷆ BRANCH R_find_unreachable
        ䷆ BRANCH R_run_live_vars
        ䷆ BRANCH R_find_dead_stores
        ䷗ RETURN R2
        ䷾ SYNC
    }
}

@locus std.analysis.memory_init {
    mut_rate   = 0.005
    cross_pool = "analysis_system"
    fitness    = min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CFG
        ䷁ RECV R1, env::INSTRUCTIONS
        ䷂ ALLOC R2, 0x80
        ䷍ ABUNDANCE R2, R0
        ䷍ ABUNDANCE R2, R1
        ䷗ RETURN R2
        ䷾ SYNC
    }
}

@locus std.analysis.memory_analyze {
    mut_rate   = 0.02
    cross_pool = "analysis_system"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CFG
        ䷁ RECV R1, env::INSTRUCTIONS
        ䷂ ALLOC R2, 0x80
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R_collect_memory_ops
        ䷆ BRANCH R_check_suspicious_addrs
        ䷆ BRANCH R_detect_aliasing
        ䷗ RETURN R2
        ䷾ SYNC
    }
}

@locus std.analysis.concurrency_init {
    mut_rate   = 0.005
    cross_pool = "analysis_system"
    fitness    = min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CFG
        ䷁ RECV R1, env::INSTRUCTIONS
        ䷂ ALLOC R2, 0x80
        ䷍ ABUNDANCE R2, R0
        ䷍ ABUNDANCE R2, R1
        ䷗ RETURN R2
        ䷾ SYNC
    }
}

@locus std.analysis.concurrency_analyze {
    mut_rate   = 0.02
    cross_pool = "analysis_system"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CFG
        ䷁ RECV R1, env::INSTRUCTIONS
        ䷂ ALLOC R2, 0x80
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R_count_thread_ops
        ䷆ BRANCH R_track_locks
        ䷆ BRANCH R_check_sync_coverage
        ䷗ RETURN R2
        ䷾ SYNC
    }
}

@locus std.analysis.static_analyzer_init {
    mut_rate   = 0.005
    cross_pool = "analysis_system"
    fitness    = min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷂ ALLOC R0, 0x100
        ䷀ CREA R1, R0
        ䷾ SYNC
        ䷗ RETURN R0
    }
}

@locus std.analysis.static_analyzer_run {
    mut_rate   = 0.03
    cross_pool = "analysis_system"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::INSTRUCTIONS
        ䷂ ALLOC R1, 0x200
        ䷆ BRANCH R_build_cfg
        ䷆ BRANCH R_identify_loops
        ䷆ BRANCH R_run_dataflow
        ䷆ BRANCH R_run_safety
        ䷆ BRANCH R_compile_results
        ䷗ RETURN R1
        ䷾ SYNC
    }
}

@meta_locus 静态分析器.变异策略 {
    mut_rate = 0.003
    fitness  = min_size + max_throughput

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷑ MUT R0, 0x02
        ䷫ MATE R0, R1
        ䷾ SYNC
    }
}

@meta_locus 静态分析器.选择策略 {
    mut_rate = 0.002
    fitness  = max_throughput

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷏ SPECULATE R1
        ䷾ SYNC
        ䷗ RETURN
    }
}
