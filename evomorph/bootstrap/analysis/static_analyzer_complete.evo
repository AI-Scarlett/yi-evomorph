    卦序: {
        ䷁ RECV R0, env::CFG
        ䷁ RECV R1, env::INSTRUCTIONS
        ䷂ ALLOC R2, 0x80
        ䷍ ABUNDANCE R2, R0
        ䷍ ABUNDANCE R2, R1
        ䷗ RETURN R2
        ䷾ SYNC
    }
}

@locus std.analysis.reaching_defs_collect {
    mut_rate   = 0.01
    cross_pool = "analysis_system"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::INSTRUCTIONS
        ䷂ ALLOC R1, 0x80
        ䷓ CONTEMPLATE R0
        ䷆ BRANCH R_iterate_instrs
        ䷆ BRANCH R_get_defined_vars
        ䷗ RETURN R1
        ䷾ SYNC
    }
}

@locus std.analysis.reaching_defs_analyze {
    mut_rate   = 0.02
    cross_pool = "analysis_system"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CFG
        ䷁ RECV R1, env::INSTRUCTIONS
        ䷂ ALLOC R2, 0x80
        ䷂ ALLOC R3, 0x80
        ䷌ FELLOWSHIP R0, R2
        ䷆ BRANCH R_run_forward_analysis
        ䷗ RETURN R2
        ䷾ SYNC
    }
}

