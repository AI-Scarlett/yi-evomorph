    卦序: {
        ䷁ RECV R0, env::CFG
        ䷁ RECV R1, env::INSTRUCTIONS
        ䷂ ALLOC R2, 0x80
        ䷌ FELLOWSHIP R0, R2
        ䷆ BRANCH R_run_backward_analysis
        ䷗ RETURN R2
        ䷾ SYNC
    }
}

@locus std.analysis.uninitialized_init {
    mut_rate   = 0.005
    cross_pool = "analysis_system"
    fitness    = min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CFG
        ䷁ RECV R1, env::INSTRUCTIONS
        ䷂ ALLOC R2, 0x80
        ䷍ ABUNDANCE R2, R0
        ䷍ ABUNDANCE R2, R1
        ䷗ RETURN R2
        ䷾ SYNC
