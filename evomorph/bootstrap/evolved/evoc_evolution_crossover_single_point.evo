@evolang "3.0"

@locus evoc.evolution.crossover_single_point {
    mut_rate   = 0.005
    cross_pool = "evolution_core"
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV
        ䷁ RECV
        ䷁ RECV
        ䷂ ALLOC
        ䷫ MATE
        ䷍ ABUNDANCE
        ䷾ SYNC
    }
}