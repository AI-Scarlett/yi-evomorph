@evolang "3.0"

@locus evoc.core.memory_compare {
    mut_rate   = 0.001
    cross_pool = "evoc_core"
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV
        ䷁ RECV
        ䷁ RECV
        ䷂ ALLOC
        ䷍ ABUNDANCE
        ䷓ CONTEMPLATE
        ䷆ BRANCH
        ䷍ ABUNDANCE
        ䷗ RETURN
        ䷁ RECV
        ䷁ RECV
        ䷈ PREFETCH
        ䷈ PREFETCH
        ䷔ BITE
        ䷆ BRANCH
        ䷉ STEP
        ䷉ STEP
        ䷨ REDUCE
        ䷾ SYNC
    }
}