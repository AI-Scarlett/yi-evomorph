@evolang "3.0"

@locus evoc.codegen.full_pass {
    mut_rate   = 0.02
    cross_pool = "evoc_core"
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV
        ䷂ ALLOC
        ䷌ FELLOWSHIP
        ䷉ STEP
        ䷆ BRANCH
        ䷆ BRANCH
        ䷆ BRANCH
        ䷾ SYNC
        ䷁ RECV
    }
}