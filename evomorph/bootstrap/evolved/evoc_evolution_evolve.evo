                ䷁ RECV R0, env::POPULATION
        ䷁ RECV R1, env::FITNESS_ARRAY
        ䷓ CONTEMPLATE R2
        ䷔ BITE R3, R1
        ䷆ BRANCH R3, @select_best
        ䷀ CREA R4, @evoc.evolution.select_tournament
        ䷌ FELLOWSHIP R0, R4
        ䷌ FELLOWSHIP R1, R4
        ䷾ SYNC
    }
}


@locus evoc.evolution.crossover_single_point {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
                ䷁ RECV R0, env::PARENT1
        ䷁ RECV R1, env::PARENT2
        ䷁ RECV R2, env::CROSS_POINT
        ䷫ MATE R0, R1
        ䷂ ALLOC R3, 0x08
        ䷍ ABUNDANCE R3, R0
        ䷍ ABUNDANCE R3, R1
        ䷾ SYNC
    }
}


@locus evoc.evolution.crossover_two_point {
    mut_rate   = 0.01
