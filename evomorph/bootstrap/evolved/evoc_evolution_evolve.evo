@evolang "3.0"

@locus evoc.evolution.evolve {
    mut_rate   = 0.02
    cross_pool = "evolution_core"
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV
        ䷁ RECV
        ䷁ RECV
        ䷁ RECV
        ䷂ ALLOC
        ䷌ FELLOWSHIP
        ䷉ STEP
        ䷓ CONTEMPLATE
        ䷆ BRANCH
        ䷍ ABUNDANCE
        ䷗ RETURN
        ䷀ CREA
        ䷀ CREA
        ䷀ CREA
        ䷀ CREA
        ䷾ SYNC
    }
}


@locus evoc.evolution.initialize_population {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
                ䷁ RECV R0, env::INPUT
        ䷀ CREA R1, @evoc.core.init
        ䷌ FELLOWSHIP R0, R1
        ䷓ CONTEMPLATE R2
        ䷆ BRANCH R2, @process
        ䷾ SYNC
    }
}


@locus evoc.evolution.selection_roulette {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
                ䷁ RECV R0, env::POPULATION
        ䷁ RECV R1, env::FITNESS_ARRAY
        ䷓ CONTEMPLATE R2
        ䷔ BITE R3, R1
        ䷆ BRANCH R3, @select_best
        ䷀ CREA R4, @evoc.evolution.select_tournament
        ䷌ FELLOWSHIP R0, R4
        ䷌ FELLOWSHIP R1, R4
        ䷾ SYNC
    }
}


@locus evoc.evolution.selection_tournament {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
                ䷁ RECV R0, env::POPULATION
        ䷁ RECV R1, env::FITNESS_ARRAY
        ䷓ CONTEMPLATE R2
        ䷔ BITE R3, R1
        ䷆ BRANCH R3, @select_best
        ䷀ CREA R4, @evoc.evolution.select_tournament
        ䷌ FELLOWSHIP R0, R4
        ䷌ FELLOWSHIP R1, R4
        ䷾ SYNC
    }
}


@locus evoc.evolution.selection_rank {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

