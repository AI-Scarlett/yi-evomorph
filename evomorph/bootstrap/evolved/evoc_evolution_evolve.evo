@evolang "3.0"

@locus evoc.evolution.evolve {
    mut_rate   = 0.02
    cross_pool = "evolution_core"
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV
        ䷁ RECV
        ䷁ RECV
        ䷁ RECV
        ䷂ ALLOC
        ䷌ FELLOWSHIP
        ䷉ STEP
        ䷓ CONTEMPLATE
        ䷆ BRANCH
        ䷍ ABUNDANCE
        ䷗ RETURN
        ䷀ CREA
        ䷀ CREA
        ䷀ CREA
        ䷀ CREA
        ䷾ SYNC
    }
}