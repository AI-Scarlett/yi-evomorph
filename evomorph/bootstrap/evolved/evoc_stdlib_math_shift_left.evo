@evolang "3.0"

@locus evoc.stdlib.math.shift_left {
    mut_rate   = 0.01
    cross_pool = "stdlib"
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV
        ䷁ RECV
        ䷓ CONTEMPLATE
        ䷆ BRANCH
        ䷗ RETURN
        ䷉ STEP
        ䷨ REDUCE
        ䷾ SYNC
    }
}