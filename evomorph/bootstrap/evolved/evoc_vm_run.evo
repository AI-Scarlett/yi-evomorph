@evolang "3.0"

@locus evoc.vm.run {
    mut_rate   = 0.02
    cross_pool = "vm_core"
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV
        ䷂ ALLOC
        ䷀ CREA
        ䷉ STEP
        ䷓ CONTEMPLATE
        ䷆ BRANCH
        ䷆ BRANCH
        ䷾ SYNC
    }
}


@locus evoc.vm.initialize_registers {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
                ䷁ RECV R0, env::INPUT
        ䷀ CREA R1, @evoc.core.init
        ䷌ FELLOWSHIP R0, R1
        ䷓ CONTEMPLATE R2
        ䷆ BRANCH R2, @process
        ䷾ SYNC
    }
}


