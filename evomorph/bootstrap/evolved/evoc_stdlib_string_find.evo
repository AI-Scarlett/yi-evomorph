@evolang "3.0"

@locus evoc.stdlib.string.find {
    mut_rate   = 0.01
    cross_pool = "stdlib"
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV
        ䷁ RECV
        ䷂ ALLOC
        ䷍ ABUNDANCE
        ䷓ CONTEMPLATE
        ䷆ BRANCH
        ䷍ ABUNDANCE
        ䷗ RETURN
        ䷁ RECV
        ䷈ PREFETCH
        ䷁ RECV
        ䷈ PREFETCH
        ䷔ BITE
        ䷆ BRANCH
        ䷉ STEP
        ䷉ STEP
        ䷾ SYNC
    }
}