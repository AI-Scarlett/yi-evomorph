@evolang "3.0"

@locus evoc.vm.execute_op_wait {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV
        ䷓ CONTEMPLATE
        ䷆ BRANCH
        ䷗ RETURN
        ䷁ RECV
        ䷨ REDUCE
        ䷾ SYNC
    }
}