@evolang "3.0"

@locus evoc.cli.parse_args {
    mut_rate   = 0.01
    cross_pool = "cli_core"
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV
        ䷁ RECV
        ䷂ ALLOC
        ䷍ ABUNDANCE
        ䷓ CONTEMPLATE
        ䷆ BRANCH
        ䷗ RETURN
        ䷁ RECV
        ䷈ PREFETCH
        ䷔ BITE
        ䷆ BRANCH
        ䷆ BRANCH
        ䷾ SYNC
    }
}