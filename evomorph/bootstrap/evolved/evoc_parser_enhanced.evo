@evolang "3.0"

@xiangci {
    "易衍·Evomorph 增强语法分析器"
    "实现完整的AST构建功能"
    "目标：达到Python语法分析器同等功能水平"
}

@locus evoc.parser.init_full {
    mut_rate   = 0.001
    cross_pool = "evoc_core"
    fitness    = min_latency + max_throughput + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::TOKEN_STREAM
        ䷂ ALLOC R1, 0x40
        ䷀ CREA R2, @evoc.core.memory_zero
        ䷌ FELLOWSHIP R1, R2
        ䷂ ALLOC R3, 0x04
        ䷍ ABUNDANCE R3, 0
        ䷂ ALLOC R4, 0x04
        ䷍ ABUNDANCE R4, 0
        ䷂ ALLOC R5, 0x04
        ䷍ ABUNDANCE R5, 0
        ䷂ ALLOC R6, 0x10
        ䷀ CREA R7, @evoc.core.memory_copy
        ䷌ FELLOWSHIP R6, R7
        ䷾ SYNC
    }
}

@locus evoc.parser.full_pass_full {
    mut_rate   = 0.001
    cross_pool = "evoc_core"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::PARSER_STATE
        ䷀ CREA R1, @evoc.parser.skip_newlines
        ䷌ FELLOWSHIP R0, R1
        
        @parse_loop:
        ䷀ CREA R2, @evoc.parser.current_token
        ䷌ FELLOWSHIP R0, R2
        ䷓ CONTEMPLATE R3
        ䷆ BRANCH R_zero, @parse_loop_done
        
        ䷀ CREA R3, @evoc.parser.parse_evolang
        ䷌ FELLOWSHIP R0, R3
        ䷆ BRANCH R3, @parse_loop
        
        ䷀ CREA R3, @evoc.parser.parse_locus
        ䷌ FELLOWSHIP R0, R3
        ䷆ BRANCH R3, @parse_loop
        
        ䷀ CREA R3, @evoc.parser.parse_meta_locus
        ䷌ FELLOWSHIP R0, R3
        ䷆ BRANCH R3, @parse_loop
        
        ䷀ CREA R3, @evoc.parser.parse_xiangci
        ䷌ FELLOWSHIP R0, R3
        ䷆ BRANCH R3, @parse_loop
        
        ䷀ CREA R2, @evoc.parser.advance
        ䷌ FELLOWSHIP R0, R2
        ䷆ BRANCH R_always, @parse_loop
        
        @parse_loop_done:
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_evolang_full {
    mut_rate   = 0.001
    cross_pool = "evoc_core"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::PARSER_STATE
        ䷀ CREA R1, @evoc.parser.current_token
        ䷌ FELLOWSHIP R0, R1
        ䷔ BITE R1, @TOKEN_EVOLANG
        ䷆ BRANCH R_ne, @parse_evolang_fail
        
        ䷀ CREA R1, @evoc.parser.advance
        ䷌ FELLOWSHIP R0, R1
        ䷀ CREA R1, @evoc.parser.skip_newlines
        ䷌ FELLOWSHIP R0, R1
        
        ䷀ CREA R2, @evoc.parser.current_token
        ䷌ FELLOWSHIP R0, R2
        ䷔ BITE R2, @TOKEN_STRING
        ䷆ BRANCH R_ne, @parse_evolang_fail
        
        ䷂ ALLOC R3, 0x04
        ䷍ ABUNDANCE R3, R2
        ䷀ CREA R2, @evoc.parser.advance
        ䷌ FELLOWSHIP R0, R2
        
        ䷀ CREA R4, @evoc.parser.skip_newlines
        ䷌ FELLOWSHIP R0, R4
        
        ䷂ ALLOC R5, 0x04
        ䷍ ABUNDANCE R5, 1
        ䷆ BRANCH R_always, @parse_evolang_done
        
        @parse_evolang_fail:
        ䷂ ALLOC R5, 0x04
        ䷍ ABUNDANCE R5, 0
        
        @parse_evolang_done:
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_locus_full {
    mut_rate   = 0.001
    cross_pool = "evoc_core"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::PARSER_STATE
        ䷀ CREA R1, @evoc.parser.current_token
        ䷌ FELLOWSHIP R0, R1
        ䷔ BITE R1, @TOKEN_LOCUS
        ䷆ BRANCH R_ne, @parse_locus_fail
        
        ䷀ CREA R1, @evoc.parser.advance
        ䷌ FELLOWSHIP R0, R1
        ䷀ CREA R1, @evoc.parser.skip_newlines
        ䷌ FELLOWSHIP R0, R1
        
        ䷀ CREA R2, @evoc.parser.parse_locus_name
        ䷌ FELLOWSHIP R0, R2
        ䷆ BRANCH R_zero, @parse_locus_fail
        
        ䷀ CREA R1, @evoc.parser.skip_newlines
        ䷌ FELLOWSHIP R0, R1
        
        ䷀ CREA R3, @evoc.parser.expect
        ䷌ FELLOWSHIP R0, R3
        ䷍ ABUNDANCE R3, @TOKEN_LBRACE
        ䷆ BRANCH R_zero, @parse_locus_fail
        
        ䷀ CREA R1, @evoc.parser.skip_newlines
        ䷌ FELLOWSHIP R0, R1
        
        @parse_locus_body:
        ䷀ CREA R4, @evoc.parser.current_token
        ䷌ FELLOWSHIP R0, R4
        ䷔ BITE R4, @TOKEN_RBRACE
        ䷆ BRANCH R_eq, @parse_locus_body_done
        
        ䷀ CREA R5, @evoc.parser.parse_mut_rate
        ䷌ FELLOWSHIP R0, R5
        ䷆ BRANCH R5, @parse_locus_body
        
        ䷀ CREA R5, @evoc.parser.parse_fitness
        ䷌ FELLOWSHIP R0, R5
        ䷆ BRANCH R5, @parse_locus_body
        
        ䷀ CREA R5, @evoc.parser.parse_env_target
        ䷌ FELLOWSHIP R0, R5
        ䷆ BRANCH R5, @parse_locus_body
        
        ䷀ CREA R5, @evoc.parser.parse_max_generations
        ䷌ FELLOWSHIP R0, R5
        ䷆ BRANCH R5, @parse_locus_body
        
        ䷀ CREA R5, @evoc.parser.parse_cross_pool
        ䷌ FELLOWSHIP R0, R5
        ䷆ BRANCH R5, @parse_locus_body
        
        ䷀ CREA R5, @evoc.parser.parse_gua_xu
        ䷌ FELLOWSHIP R0, R5
        ䷆ BRANCH R5, @parse_locus_body
        
        ䷀ CREA R4, @evoc.parser.advance
        ䷌ FELLOWSHIP R0, R4
        ䷆ BRANCH R_always, @parse_locus_body
        
        @parse_locus_body_done:
        ䷀ CREA R4, @evoc.parser.advance
        ䷌ FELLOWSHIP R0, R4
        ䷂ ALLOC R5, 0x04
        ䷍ ABUNDANCE R5, 1
        ䷆ BRANCH R_always, @parse_locus_done
        
        @parse_locus_fail:
        ䷂ ALLOC R5, 0x04
        ䷍ ABUNDANCE R5, 0
        
        @parse_locus_done:
        ䷾ SYNC
    }
}

