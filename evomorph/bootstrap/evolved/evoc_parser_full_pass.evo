@evolang "3.0"

@locus evoc.parser.full_pass {
    mut_rate   = 0.02
    cross_pool = "evoc_core"
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV
        ䷂ ALLOC
        ䷌ FELLOWSHIP
        ䷉ STEP
        ䷆ BRANCH
        ䷆ BRANCH
        ䷆ BRANCH
        ䷾ SYNC
        ䷁ RECV
    }
}


@locus evoc.parser.parse_program {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
                ䷁ RECV R0, env::TOKEN_STREAM
        ䷀ CREA R1, @evoc.parser.init
        ䷌ FELLOWSHIP R0, R1
        ䷓ CONTEMPLATE R2
        ䷆ BRANCH R2, @parse_locus
        ䷀ CREA R3, @evoc.parser.parse_locus
        ䷌ FELLOWSHIP R1, R3
        ䷾ SYNC
    }
}


