@evolang "3.0"

@xiangci {
    "元数据读取器：解析 .evo 源码中的 locus 定义和属性。"
    "替代 _extract_evo_metadata() 的 Python 实现。"
}

@meta_locus preprocess.metadata {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11"]

    卦序: {
        CREA R0, R0, #0x00
        SYNC
    }
}

# TODO: 实现完整的元数据提取逻辑
