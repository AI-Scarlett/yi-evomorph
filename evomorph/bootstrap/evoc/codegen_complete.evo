@evolang "3.0"

@xiangci {
    "完整代码生成器实现：抽象之树化为字节之流，如卦辞之定而万物生。"
    "道枢自举之三——编译器用自身之语言书写自身之代码生成。"
    "此实现涵盖：头部生成、操作码编码、操作数编码、指令发射、基因座发射、标签链接、完整编译流程。"
}

@locus evoc.codegen.init {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷂ ALLOC R0, 0x04
        ䷂ ALLOC R1, 0x04
        ䷂ ALLOC R2, 0x04
        ䷀ CREA R3, R0
        ䷌ FELLOWSHIP R0, R1
        ䷾ SYNC
    }
}

@locus evoc.codegen.emit_header {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_size + min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷂ ALLOC R0, 0x08
        ䷍ ABUNDANCE R0, 0x45564F42
        ䷍ ABUNDANCE R0, 0x0003
        ䷾ SYNC
    }
}

@locus evoc.codegen.encode_opcode {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::OPCODE
        ䷁ RECV R1, env::MODIFIER
        ䷂ ALLOC R2, 0x02
        ䷩ INCREASE R0, R1
        ䷍ ABUNDANCE R2, R0
        ䷾ SYNC
    }
}

@locus evoc.codegen.encode_operand {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::OPERAND
        ䷓ CONTEMPLATE R0
        ䷆ BRANCH R_check_register_operand
        ䷆ BRANCH R_check_immediate_operand
        ䷆ BRANCH R_check_label_operand
        ䷂ ALLOC R1, 0x04
        ䷍ ABUNDANCE R1, R0
        ䷾ SYNC
    }
}

@locus evoc.codegen.encode_register_operand {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::REGISTER_NAME
        ䷓ CONTEMPLATE R0
        ䷔ BITE R0, 0x52
        ䷆ BRANCH R_starts_with_R
        ䷂ ALLOC R1, 0x04
        ䷍ ABUNDANCE R1, R0
        ䷾ SYNC
    }
}

@locus evoc.codegen.encode_immediate_operand {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::IMMEDIATE_VALUE
        ䷂ ALLOC R1, 0x04
        ䷍ ABUNDANCE R1, R0
        ䷾ SYNC
    }
}

@locus evoc.codegen.encode_label_operand {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::LABEL_NAME
        ䷂ ALLOC R1, 0x08
        ䷍ ABUNDANCE R1, R0
        ䷁ RECV R2, env::RELOC_TABLE
        ䷍ ABUNDANCE R2, R1
        ䷾ SYNC
    }
}

@locus evoc.codegen.emit_instruction {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = max_throughput + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::OPCODE
        ䷁ RECV R1, env::MODIFIER
        ䷁ RECV R2, env::OPERANDS
        ䷂ ALLOC R3, 0x10
        ䷩ INCREASE R0, R1
        ䷍ ABUNDANCE R3, R0
        ䷌ FELLOWSHIP R2, R3
        ䷾ SYNC
    }
}

@locus evoc.codegen.emit_locus {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = max_throughput + min_energy
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::LOCUS_NAME
        ䷁ RECV R1, env::INSTRUCTIONS
        ䷂ ALLOC R2, 0x10000
        ䷌ FELLOWSHIP R0, R2
        ䷉ STEP R1
        ䷓ CONTEMPLATE R1
        ䷍ ABUNDANCE R2, R1
        ䷾ SYNC
    }
}

@locus evoc.codegen.link_labels {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::LABEL_TABLE
        ䷁ RECV R1, env::RELOC_TABLE
        ䷌ FELLOWSHIP R0, R1
        ䷓ CONTEMPLATE R1
        ䷰ REPLACE R0, R1
        ䷾ SYNC
    }
}

@locus evoc.codegen.generate_evb_header {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_size + min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷂ ALLOC R0, 0x10
        ䷍ ABUNDANCE R0, 0x45564F42
        ䷍ ABUNDANCE R0, 0x0003
        ䷁ RECV R1, env::LOCUS_COUNT
        ䷍ ABUNDANCE R0, R1
        ䷾ SYNC
    }
}

@locus evoc.codegen.generate_locus_offset_table {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::LOCUS_OFFSETS
        ䷂ ALLOC R1, 0x100
        ䷌ FELLOWSHIP R0, R1
        ䷉ STEP R1
        ䷓ CONTEMPLATE R1
        ䷾ SYNC
    }
}

@locus evoc.codegen.generate_json {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = max_throughput + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::AST
        ䷂ ALLOC R1, 0x10000
        ䷌ FELLOWSHIP R0, R1
        ䷓ CONTEMPLATE R1
        ䷕ ADORN R0, R1
        ䷾ SYNC
    }
}

@locus evoc.codegen.serialize_fitness {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::FITNESS_EXPR
        ䷂ ALLOC R1, 0x100
        ䷌ FELLOWSHIP R0, R1
        ䷓ CONTEMPLATE R1
        ䷾ SYNC
    }
}

@locus evoc.codegen.serialize_fitness_term {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::KEYWORD
        ䷁ RECV R1, env::WEIGHT
        ䷂ ALLOC R2, 0x40
        ䷍ ABUNDANCE R2, R0
        ䷍ ABUNDANCE R2, R1
        ䷾ SYNC
    }
}

@locus evoc.codegen.build_symbol_table {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = max_throughput + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::LOCUS_LIST
        ䷂ ALLOC R1, 0x1000
        ䷌ FELLOWSHIP R0, R1
        ䷉ STEP R0
        ䷓ CONTEMPLATE R0
        ䷍ ABUNDANCE R1, R0
        ䷾ SYNC
    }
}

@locus evoc.codegen.calculate_locus_offsets {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = max_throughput + min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::LOCUS_LIST
        ䷂ ALLOC R1, 0x100
        ䷂ ALLOC R2, 0x04
        ䷌ FELLOWSHIP R0, R1
        ䷉ STEP R0
        ䷩ INCREASE R2, R0
        ䷍ ABUNDANCE R1, R2
        ䷾ SYNC
    }
}

@locus evoc.codegen.full_pass {
    mut_rate   = 0.02
    cross_pool = "evoc_core"
    fitness    = max_throughput + min_energy + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::AST
        ䷂ ALLOC R1, 0x100000
        ䷌ FELLOWSHIP R0, R1
        ䷉ STEP R1
        ䷆ BRANCH R_emit_locus
        ䷆ BRANCH R_emit_instruction
        ䷆ BRANCH R_link_labels
        ䷾ SYNC
        ䷁ RECV R2, R_bytecode
    }
}

@locus evoc.codegen.export_evb {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = max_throughput + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::PROGRAM_AST
        ䷂ ALLOC R1, 0x100000
        ䷌ FELLOWSHIP R0, R1
        ䷆ BRANCH R_generate_evb_header
        ䷆ BRANCH R_generate_locus_table
        ䷆ BRANCH R_emit_all_instructions
        ䷾ SYNC
    }
}

@meta_locus 代码生成器.变异策略 {
    mut_rate = 0.005
    fitness  = max_throughput + min_size

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷑ MUT R0, 0x03
        ䷫ MATE R0, R1
        ䷾ SYNC
    }
}

@meta_locus 代码生成器.选择策略 {
    mut_rate = 0.003
    fitness  = max_throughput

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷏ SPECULATE R1
        ䷾ SYNC
        ䷗ RETURN
    }
}
