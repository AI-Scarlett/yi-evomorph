@evolang "3.0"

@locus evoc.stdlib.string.compare {
    mut_rate   = 0.005
    cross_pool = "stdlib"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]
    max_generations = 100

    卦序: {
        ䷁ RECV R0, env::STR1
        ䷁ RECV R1, env::STR2
        ䷀ CREA R2, @memory_compare
        ䷾ SYNC
    }
}