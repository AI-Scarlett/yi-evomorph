@evolang "3.0"

@locus evoc.lexer.is_whitespace {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]
    max_generations = 100

    卦序: {
        ䷁ RECV R0, env::CHAR
        ䷔ BITE R0, 0x0020
        ䷆ BRANCH R_is_space
        ䷔ BITE R0, R9
        ䷆ BRANCH R_is_tab
        ䷔ BITE R0, R13
        ䷆ BRANCH R_is_cr
        ䷍ ABUNDANCE R1, R0
        ䷗ RETURN
        ䷍ ABUNDANCE R1, R1
        ䷾ SYNC
    }
}