@evolang "3.0"

@locus evoc.vm.execute_crea {
    mut_rate   = 0.005
    cross_pool = "vm_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]
    max_generations = 100

    卦序: {
        ䷁ RECV R0, env::DST_REG
        ䷁ RECV R1, env::THREAD_COUNTER
        ䷉ STEP R1
        ䷍ ABUNDANCE R0, R1
        ䷾ SYNC
    }
}