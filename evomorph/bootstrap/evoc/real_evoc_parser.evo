@locus evoc.parser.parse_gua_xu {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R1, env::STATE
        ䷀ CREA R0
        ䷂ ALLOC R2, 0x1000
        
        ䷀ CREA R3, @evoc.parser.expect
        ䷌ FELLOWSHIP R1, R3
        
        ䷀ CREA R3, @evoc.parser.expect
        ䷌ FELLOWSHIP R1, R3
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @parse_instruction_loop
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @check_instruction
        
        ䷀ CREA R3, @evoc.parser.parse_instruction
        ䷌ FELLOWSHIP R1, R3
        
        ䷆ BRANCH R0, @parse_instruction_loop
        
        ䷀ CREA R3, @evoc.parser.expect
        ䷌ FELLOWSHIP R1, R3
        
        ䷾ SYNC
        ䷗ RETURN R2
    }
}

@locus evoc.parser.parse_instruction {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R1, env::STATE
        ䷀ CREA R0
        ䷂ ALLOC R2, 0x200
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @check_hexagram_symbol
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @check_mnemonic
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @check_modifier
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @parse_operands
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @check_comma
        
        ䷉ STEP R1
        ䷆ BRANCH R0, @parse_operands
        
        ䷾ SYNC
        ䷗ RETURN R2
    }
}

