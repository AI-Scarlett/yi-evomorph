@evolang "3.0"

@xiangci {
    "易衍自举编译器 - 语法分析器
    通过系统调用机制执行语法分析
    支持完整的AST构建：程序、基因座、元基因座、象辞、指令等"
}

@locus evoc.parser.main {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::TOKENS
        ䷀ CREA R1
        ䷂ ALLOC R2, 0x2000
        
        ䷁ RECV R0, env::INPUT
        ䷀ CREA R1, @evoc.parser.init
        ䷌ FELLOWSHIP R0, R1
        
        ䷆ BRANCH R0, @parser_loop
        ䷀ CREA R3, @evoc.parser.parse
        ䷌ FELLOWSHIP R0, R3
        
        ䷁ RECV R0, env::OUTPUT
        ䷗ RETURN R0
    }
}

@locus evoc.parser.parse {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R1, env::TOKENS_PTR
        ䷀ CREA R0
        ䷂ ALLOC R2, 0x4000
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @check_evolang
        
        ䷀ CREA R3, @evoc.parser.parse_evolang
        ䷌ FELLOWSHIP R1, R3
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @parse_loop
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @check_locus
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @check_meta_locus
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @check_xiangci
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @check_newline
        
        ䷉ STEP R1
        ䷆ BRANCH R0, @parse_loop
        
        ䷾ SYNC
        ䷗ RETURN R2
    }
}

@locus evoc.parser.init {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R1, env::TOKENS
        ䷀ CREA R0
        ䷂ ALLOC R2, 0x100
        
        ䷍ ABUNDANCE R2, 0
        ䷍ ABUNDANCE R2, R1
        
        ䷾ SYNC
        ䷗ RETURN R2
    }
}

@locus evoc.parser.advance {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R1, env::STATE
        ䷀ CREA R0
        ䷉ STEP R1
        ䷾ SYNC
        ䷗ RETURN R1
    }
}

@locus evoc.parser.peek {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R1, env::STATE
        ䷁ RECV R2, env::OFFSET
        ䷀ CREA R0
        ䷓ CONTEMPLATE R1
        ䷗ RETURN R0
    }
}

@locus evoc.parser.current {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R1, env::STATE
        ䷀ CREA R0
        ䷓ CONTEMPLATE R1
        ䷗ RETURN R0
    }
}

@locus evoc.parser.expect {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R1, env::STATE
        ䷁ RECV R2, env::EXPECTED
        ䷀ CREA R0
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @check_match
        
        ䷉ STEP R1
        ䷆ BRANCH R0, @expect_ok
        
        ䷾ SYNC
        ䷗ RETURN R1
    }
}

@locus evoc.parser.match {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R1, env::STATE
        ䷁ RECV R2, env::EXPECTED
        ䷀ CREA R0
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @check_current
        
        ䷆ BRANCH R0, @match_true
        ䷆ BRANCH R0, @match_false
        
        ䷾ SYNC
        ䷗ RETURN R0
    }
}

@locus evoc.parser.skip_newlines {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R1, env::STATE
        ䷀ CREA R0
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @check_newline_token
        
        ䷉ STEP R1
        ䷆ BRANCH R0, @newline_loop
        
        ䷾ SYNC
        ䷗ RETURN R1
    }
}

@locus evoc.parser.parse_evolang {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R1, env::STATE
        ䷀ CREA R0
        ䷂ ALLOC R2, 0x100
        
        ䷀ CREA R3, @evoc.parser.expect
        ䷌ FELLOWSHIP R1, R3
        
        ䷀ CREA R3, @evoc.parser.expect
        ䷌ FELLOWSHIP R1, R3
        
        ䷍ ABUNDANCE R2, R1
        
        ䷾ SYNC
        ䷗ RETURN R2
    }
}

@locus evoc.parser.parse_locus {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R1, env::STATE
        ䷀ CREA R0
        ䷂ ALLOC R2, 0x800
        
        ䷀ CREA R3, @evoc.parser.expect
        ䷌ FELLOWSHIP R1, R3
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @parse_locus_name
        
        ䷀ CREA R3, @evoc.parser.expect
        ䷌ FELLOWSHIP R1, R3
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @parse_locus_body
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @check_mut_rate
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @check_cross_pool
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @check_fitness
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @check_env_target
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @check_max_generations
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @check_gua_xu
        
        ䷀ CREA R3, @evoc.parser.expect
        ䷌ FELLOWSHIP R1, R3
        
        ䷾ SYNC
        ䷗ RETURN R2
    }
}

