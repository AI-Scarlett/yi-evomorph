        ䷌ FELLOWSHIP R1, R3
        
        ䷀ CREA R3, @evoc.parser.expect
        ䷌ FELLOWSHIP R1, R3
        
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R0, @parse_xiangci_content
        
        ䷀ CREA R3, @evoc.parser.expect
