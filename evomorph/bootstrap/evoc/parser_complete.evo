@evolang "3.0"

@xiangci {
    "完整语法分析器实现：令牌之流化为抽象之树，如卦象之有序成辞。"
    "道枢自举之二——编译器用自身之语言书写自身之语法。"
    "此实现涵盖：令牌读取、期望校验、基因座解析、卦序解析、指令解析、象辞解析、适应度解析。"
}

@locus evoc.parser.init {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷂ ALLOC R0, 0x04
        ䷂ ALLOC R1, 0x04
        ䷂ ALLOC R2, 0x04
        ䷀ CREA R3, R0
        ䷌ FELLOWSHIP R0, R1
        ䷾ SYNC
    }
}

@locus evoc.parser.read_token {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::TOKEN_STREAM
        ䷈ PREFETCH R0
        ䷂ ALLOC R1, 0x08
        ䷍ ABUNDANCE R1, R0
        ䷉ STEP R0
        ䷾ SYNC
        ䷁ RECV R2, R1
    }
}

@locus evoc.parser.peek_token {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::TOKEN_STREAM
        ䷈ PREFETCH R0
        ䷂ ALLOC R1, 0x08
        ䷍ ABUNDANCE R1, R0
        ䷾ SYNC
        ䷁ RECV R2, R1
    }
}

@locus evoc.parser.expect {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::EXPECTED_TYPE
        ䷁ RECV R1, env::ACTUAL_TYPE
        ䷔ BITE R0, R1
        ䷆ BRANCH R_match
        ䷛ OVERLOAD R_error
        ䷾ SYNC
    }
}

@locus evoc.parser.match {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::EXPECTED_TYPE
        ䷁ RECV R1, env::ACTUAL_TYPE
        ䷔ BITE R0, R1
        ䷆ BRANCH R_no_match
        ䷉ STEP R1
        ䷗ RETURN
        ䷾ SYNC
    }
}

@locus evoc.parser.skip_newlines {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CURRENT_TOKEN
        ䷔ BITE R0, 0x0A
        ䷆ BRANCH R_is_newline
        ䷗ RETURN
        ䷉ STEP R0
        ䷆ BRANCH R_check_next
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_evolang {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::EXPECT_EVOLANG
        ䷂ ALLOC R1, 0x08
        ䷍ ABUNDANCE R1, R0
        ䷁ RECV R2, env::VERSION_STRING
        ䷂ ALLOC R3, 0x10
        ䷍ ABUNDANCE R3, R2
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_locus {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = max_throughput + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::LOCUS_KW
        ䷁ RECV R1, env::LOCUS_NAME
        ䷂ ALLOC R2, 0x100
        ䷌ FELLOWSHIP R0, R2
        ䷓ CONTEMPLATE R2
        ䷆ BRANCH R_parse_locus_body
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_locus_name {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CURRENT_TOKEN
        ䷂ ALLOC R1, 0x40
        ䷌ FELLOWSHIP R0, R1
        ䷓ CONTEMPLATE R1
        ䷉ STEP R1
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_mut_rate {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::MUT_RATE_KW
        ䷁ RECV R1, env::ASSIGN_OP
        ䷁ RECV R2, env::FLOAT_VALUE
        ䷂ ALLOC R3, 0x08
        ䷍ ABUNDANCE R3, R2
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_cross_pool {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CROSS_POOL_KW
        ䷁ RECV R1, env::ASSIGN_OP
        ䷁ RECV R2, env::STRING_VALUE
        ䷂ ALLOC R3, 0x20
        ䷍ ABUNDANCE R3, R2
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_fitness {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::FITNESS_KW
        ䷁ RECV R1, env::ASSIGN_OP
        ䷂ ALLOC R2, 0x100
        ䷌ FELLOWSHIP R0, R2
        ䷓ CONTEMPLATE R2
        ䷆ BRANCH R_parse_fitness_terms
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_fitness_term {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::CURRENT_TOKEN
        ䷔ BITE R0, 0x2B
        ䷆ BRANCH R_is_plus
        ䷔ BITE R0, 0x2D
        ䷆ BRANCH R_is_minus
        ䷔ BITE R0, 0x2A
        ䷆ BRANCH R_is_star
        ䷂ ALLOC R1, 0x10
        ䷍ ABUNDANCE R1, R0
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_env_target {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::ENV_TARGET_KW
        ䷁ RECV R1, env::ASSIGN_OP
        ䷁ RECV R2, env::LBRACKET
        ䷂ ALLOC R3, 0x40
        ䷌ FELLOWSHIP R2, R3
        ䷓ CONTEMPLATE R3
        ䷆ BRANCH R_parse_platform_list
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_max_generations {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::MAX_GEN_KW
        ䷁ RECV R1, env::ASSIGN_OP
        ䷁ RECV R2, env::NUMBER_VALUE
        ䷂ ALLOC R3, 0x08
        ䷍ ABUNDANCE R3, R2
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_gua_xu {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = max_throughput + min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::GUA_XU_KW
        ䷂ ALLOC R1, 0x1000
        ䷌ FELLOWSHIP R0, R1
        ䷉ STEP R1
        ䷓ CONTEMPLATE R1
        ䷆ BRANCH R_parse_instructions
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_instruction {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = max_throughput + min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::HEXAGRAM_OR_MNEMONIC
        ䷓ CONTEMPLATE R0
        ䷂ ALLOC R1, 0x08
        ䷍ ABUNDANCE R1, R0
        ䷁ RECV R2, env::OPERANDS
        ䷌ FELLOWSHIP R1, R2
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_hexagram {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::HEXAGRAM_SYMBOL
        ䷂ ALLOC R1, 0x04
        ䷕ ADORN R0, R1
        ䷍ ABUNDANCE R2, R1
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_mnemonic {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = max_throughput + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::MNEMONIC_TOKEN
        ䷂ ALLOC R1, 0x10
        ䷌ FELLOWSHIP R0, R1
        ䷓ CONTEMPLATE R1
        ䷍ ABUNDANCE R2, R1
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_modifier {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::MODIFIER_TOKEN
        ䷂ ALLOC R1, 0x08
        ䷍ ABUNDANCE R1, R0
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_operand {
    mut_rate   = 0.005
    cross_pool = "evoc_core"
    fitness    = min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::OPERAND_TOKEN
        ䷓ CONTEMPLATE R0
        ䷆ BRANCH R_check_register
        ䷆ BRANCH R_check_immediate
        ䷆ BRANCH R_check_label
        ䷆ BRANCH R_check_env_ref
        ䷂ ALLOC R1, 0x08
        ䷍ ABUNDANCE R1, R0
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_xiangci {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = min_size + min_latency
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::XIANGCI_KW
        ䷂ ALLOC R1, 0x1000
        ䷌ FELLOWSHIP R0, R1
        ䷕ ADORN R0, R1
        ䷾ SYNC
    }
}

@locus evoc.parser.parse_meta_locus {
    mut_rate   = 0.01
    cross_pool = "evoc_core"
    fitness    = max_throughput + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::META_LOCUS_KW
        ䷁ RECV R1, env::META_LOCUS_NAME
        ䷂ ALLOC R2, 0x100
        ䷌ FELLOWSHIP R0, R2
        ䷓ CONTEMPLATE R2
        ䷆ BRANCH R_parse_meta_body
        ䷾ SYNC
    }
}

@locus evoc.parser.full_pass {
    mut_rate   = 0.02
    cross_pool = "evoc_core"
    fitness    = max_throughput + min_energy + min_size
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]

    卦序: {
        ䷁ RECV R0, env::TOKEN_STREAM
        ䷂ ALLOC R1, 0x10000
        ䷌ FELLOWSHIP R0, R1
        ䷉ STEP R1
        ䷆ BRANCH R_parse_locus
        ䷆ BRANCH R_parse_xiangci
        ䷆ BRANCH R_parse_guaxu
        ䷾ SYNC
        ䷁ RECV R2, R_ast
    }
}

@meta_locus 语法分析器.变异策略 {
    mut_rate = 0.005
    fitness  = max_throughput + min_size

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷑ MUT R0, 0x03
        ䷫ MATE R0, R1
        ䷾ SYNC
    }
}

@meta_locus 语法分析器.选择策略 {
    mut_rate = 0.003
    fitness  = max_throughput

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷏ SPECULATE R1
        ䷾ SYNC
        ䷗ RETURN
    }
}
