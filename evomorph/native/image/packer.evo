@evolang "3.0"

@xiangci {
    "EVOI 映像打包器 — EVB-native 实现"
    "EVOI 格式: 4B magic(EVOI) + 2B version + 4B manifest_len + manifest_json + 4B evb_len + evb_data"
    "manifest: JSON 格式 {entry_locus, platform, locus_count, loci, version}"
}

@locus evoi_validate_magic {
    mut_rate = 0.0
    cross_pool = "stdlib"
    fitness = correctness
    env_target = ["evomorph-vm"]

    卦序: {
        // evoi_validate_magic(*data, len) -> valid_flag
        // 输入: R0 = heap 中 data 起始偏移, R1 = len
        // 输出: R0 = 1 如果 magic == 'EVOI', 否则 0
        // 'E'=69 'V'=86 'O'=79 'I'=73
        CMPI.0 R1, #4
        BRANCH.2 @invalid           // len < 4 → invalid

        LOAD.0 R2, R0
        AND.1 R2, R2, #255
        CMPI.0 R2, #69
        BRANCH.2 @invalid

        ADD.1 R0, R0, #1
        LOAD.0 R2, R0
        AND.1 R2, R2, #255
        CMPI.0 R2, #86
        BRANCH.2 @invalid

        ADD.1 R0, R0, #1
        LOAD.0 R2, R0
        AND.1 R2, R2, #255
        CMPI.0 R2, #79
        BRANCH.2 @invalid

        ADD.1 R0, R0, #1
        LOAD.0 R2, R0
        AND.1 R2, R2, #255
        CMPI.0 R2, #73
        BRANCH.2 @invalid

        LOAD.1 R0, #1
        RETURN.1 R0, R0

    invalid:
        LOAD.1 R0, #0
        RETURN.1 R0, R0
    }
}

@locus evoi_parse_manifest {
    mut_rate = 0.0
    cross_pool = "stdlib"
    fitness = correctness
    env_target = ["evomorph-vm"]

    卦序: {
        // evoi_parse_manifest(*data) -> manifest_len, entry_locus_offset
        // 输入: R0 = heap 中 data 起始偏移 (magic 已校验)
        // 输出: R0 = manifest_json 字节长度 (big-endian uint32 from bytes 6-9)
        // manifest 从 byte 10 开始

        // 读取 manifest_len (bytes 6-9, big-endian uint32)
        ADD.1 R1, R0, #6

        LOAD.0 R2, R1
        AND.1 R2, R2, #255
        SHL.0 R2, R2, #24

        ADD.1 R1, R1, #1
        LOAD.0 R3, R1
        AND.1 R3, R3, #255
        SHL.0 R3, R3, #16
        OR.0 R2, R2, R3

        ADD.1 R1, R1, #1
        LOAD.0 R3, R1
        AND.1 R3, R3, #255
        SHL.0 R3, R3, #8
        OR.0 R2, R2, R3

        ADD.1 R1, R1, #1
        LOAD.0 R3, R1
        AND.1 R3, R3, #255
        OR.0 R0, R2, R3              // R0 = manifest_len

        RETURN.1 R0, R0
    }
}

@locus evoi_parse_evb_offset {
    mut_rate = 0.0
    cross_pool = "stdlib"
    fitness = correctness
    env_target = ["evomorph-vm"]

    卦序: {
        // evoi_parse_evb_offset(*data, manifest_len) -> evb_data_offset, evb_data_len
        // 输入: R0 = heap 中 data 起始偏移, R1 = manifest_len
        // 输出: R0 = evb_data 起始偏移, R1 = evb_data 长度
        // EVB data 从 byte 10 + manifest_len + 4 开始
        // 前 4 字节是 evb_data_len

        ADD.1 R2, R0, #10           // manifest 起始
        ADD.0 R2, R2, R1            // manifest 结束 = evb_len 位置

        // 读取 evb_data_len (big-endian uint32)
        LOAD.0 R3, R2
        AND.1 R3, R3, #255
        SHL.0 R3, R3, #24

        ADD.1 R4, R2, #1
        LOAD.0 R5, R4
        AND.1 R5, R5, #255
        SHL.0 R5, R5, #16
        OR.0 R3, R3, R5

        ADD.1 R4, R2, #2
        LOAD.0 R5, R4
        AND.1 R5, R5, #255
        SHL.0 R5, R5, #8
        OR.0 R3, R3, R5

        ADD.1 R4, R2, #3
        LOAD.0 R5, R4
        AND.1 R5, R5, #255
        OR.0 R1, R3, R5              // R1 = evb_data_len

        ADD.1 R0, R2, #4            // R0 = evb_data 起始偏移
        RETURN.1 R0, R0
    }
}
