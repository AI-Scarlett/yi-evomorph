@evolang "3.0"

@xiangci {
    "字节码之工：编码指令为 EVB 字节码、基因座到字节码转换。EVB-native: bytecode_utils.evoasm"
}

@locus bytecode_utils.encode {
    mut_rate   = 0.005
    cross_pool = "native"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x"]

    卦序: {
        ䷁ RECV R0, 8
        ䷾ SYNC
        ䷋ HALT
    }
}

@locus bytecode_utils.locus_to_bytecode {
    mut_rate   = 0.005
    cross_pool = "native"
    fitness    = max_throughput
    env_target = ["linux-6.x"]

    卦序: {
        ䷁ RECV R0, 64
        ䷂ ALLOC R0, 0x200
        ䷾ SYNC
        ䷋ HALT
    }
}
