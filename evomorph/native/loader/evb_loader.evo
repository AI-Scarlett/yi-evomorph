@evolang "3.0"

@xiangci {
    "EVB 加载之基：magic 校验、版本识别、段提取。EVB-native: evb_header.evo"
}

@locus evb_loader.parse_header {
    mut_rate   = 0.005
    cross_pool = "loader"
    fitness    = min_latency + min_size
    env_target = ["linux-6.x"]

    卦序: {
        ䷁ RECV R0, 64
        ䷾ SYNC
        ䷋ HALT
    }
}

@locus evb_loader.extract_segments {
    mut_rate   = 0.005
    cross_pool = "loader"
    fitness    = max_throughput
    env_target = ["linux-6.x"]

    卦序: {
        ䷁ RECV R0, 128
        ䷂ ALLOC R0, 0x400
        ䷾ SYNC
        ䷋ HALT
    }
}
