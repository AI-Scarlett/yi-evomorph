@evolang "3.0"

@xiangci {
    "VM 之基：IChing 虚拟机基类、VMState 状态机、寄存器定义。C 原生后端替代执行。"
}

@locus vm.core.init {
    mut_rate   = 0.001
    cross_pool = "vm_core"
    fitness    = min_latency + max_throughput
    env_target = ["linux-6.x", "android-14", "ios-18"]

    卦序: {
        ䷂ ALLOC R0, 0x1000
        ䷾ SYNC
        ䷋ HALT
    }
}
