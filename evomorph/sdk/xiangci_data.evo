@evolang "3.0"

@xiangci {
    易衍象辞模板数据 — 从 Python xiangci.py 提取
    包含: 系统提示词 + 三种编译模板 (并行/IO/计算)
    供 IChing 编译器在象辞→基因座翻译阶段使用
}

@locus xiangci_system_prompt {
    mut_rate = 0.0
    cross_pool = "stdlib"
    fitness = correctness
    env_target = ["evomorph-vm"]

    GUAXU: {
        // 系统提示词已内嵌在编译器中
        // 运行时从 heap 的 SYSTEM_PROMPT_OFFSET 位置加载
        RETURN.1 R0, R0
    }
}

@locus parallel_template {
    mut_rate = 0.0
    cross_pool = "stdlib"
    fitness = correctness
    env_target = ["evomorph-vm"]

    GUAXU: {
        // 并行计算模板: CREA → FELLOWSHIP → SYNC → RECV
        CREA.1 R0, R0, #63        // opcode=63 CREA
        CREA.1 R1, R1, #61        // opcode=61 FELLOWSHIP
        CREA.1 R2, R2, #21        // opcode=21 SYNC
        CREA.1 R3, R3, #0         // opcode=0  RECV
        // fitness: min_latency + max_throughput
        RETURN.1 R0, R0
    }
}

@locus io_template {
    mut_rate = 0.0
    cross_pool = "stdlib"
    fitness = correctness
    env_target = ["evomorph-vm"]

    GUAXU: {
        // IO密集模板: RECV → ALLOC → ABUNDANCE
        CREA.1 R0, R0, #0         // opcode=0  RECV
        CREA.1 R1, R1, #17        // opcode=17 ALLOC
        CREA.1 R2, R2, #47        // opcode=47 ABUNDANCE
        // fitness: min_energy + min_latency
        RETURN.1 R0, R0
    }
}

@locus compute_template {
    mut_rate = 0.0
    cross_pool = "stdlib"
    fitness = correctness
    env_target = ["evomorph-vm"]

    GUAXU: {
        // 计算密集模板: CREA → STEP → RETURN
        CREA.1 R0, R0, #63        // opcode=63 CREA
        CREA.1 R1, R1, #59        // opcode=59 STEP
        CREA.1 R2, R2, #1         // opcode=1  RETURN
        // fitness: max_throughput
        RETURN.1 R0, R0
    }
}
