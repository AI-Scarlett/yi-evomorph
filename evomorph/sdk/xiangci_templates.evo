@evolang "3.0"

@meta_locus xiangci_template_library {
    description = "易衍·Evomorph 象辞编程模板库 — 24个预定义编程模式"
    purpose = "AI模型选择模板+填参数即可生成代码，3B/4B小模型友好"
    version = "0.0.6"
    template_count = 24
}

@xiangci {
    小模型友好设计理念:
    - AI模型(3B/4B)上下文有限，不宜从零生成代码
    - 24个预定义模板覆盖常见编程场景
    - 模型只需: 意图匹配→选择模板→填充参数→编译执行

    模板分类:
    [并发原语] parallel, mutex_guard, atomic_op, barrier_sync, fork_join
    [数据处理] map_reduce, pipeline, batch_process, data_transform, stream_filter
    [IO操作]   io_bound, cache_access, log_writer, disperse_write
    [容错恢复] retry_loop, degrade_fallback, trap_handler
    [安全]     crypto_ops, throttle_limit, trust_verify
    [内存]     mem_pool, context_switch
    [生命周期] event_loop, hot_reload
}

@locus parallel {
    mut_rate = 0.0; cross_pool = "xiangci"; fitness = correctness; env_target = ["evomorph-vm"]
    GUAXU: {
        // 并行计算: CREA → FELLOWSHIP → SYNC → RECV
        CREA.1 R0, R0, #63; CREA.1 R1, R1, #61
        CREA.1 R2, R2, #21; CREA.1 R3, R3, #0
        RETURN.1 R0, R0
    }
}

@locus mutex_guard {
    mut_rate = 0.0; cross_pool = "xiangci"; fitness = correctness; env_target = ["evomorph-vm"]
    GUAXU: {
        // 互斥锁保护: LOCK → ALLOC → UNLOCK → RETURN
        CREA.1 R0, R0, #58; CREA.1 R1, R1, #17
        CREA.1 R2, R2, #10; CREA.1 R3, R3, #1
        RETURN.1 R0, R0
    }
}

