    卦序: {
        ䷁ RECV R0, 0x0700
        ䷁ RECV R1, 0x0701
        ䷓ CONTEMPLATE R0
        ䷆ BRANCH R2, R1
        ䷓ CONTEMPLATE R3
        ䷬ GATHER R4, R3
        ䷨ REDUCE R5, R4
        ䷩ INCREASE R6, R5
        ䷏ SPECULATE R7, R6
        ䷌ FELLOWSHIP R8, R7
        ䷫ MATE R9, R10
        ䷑ MUT R11, 0x04
        ䷍ ABUNDANCE R12, R11
        ䷆ BRANCH R13, R12
        ䷾ SYNC
        ䷗ RETURN R13
    }
}

