@locus evolution.generation.evolve_one {
    mut_rate   = 0.005
    cross_pool = "evolution_core"
    fitness    = max_throughput + min_energy
    env_target = ["linux-6.x", "android-14", "ios-18", "win-11", "harmony-5"]
    max_generations = 50

    卦序: {
        ䷓ CONTEMPLATE R0
        ䷬ GATHER R1, R0
        ䷨ REDUCE R2, R1
        ䷩ INCREASE R3, R2
        ䷏ SPECULATE R4, R3
        ䷌ FELLOWSHIP R5, R4
        ䷫ MATE R6, R7
        ䷑ MUT R8, 0x04
        ䷆ BRANCH R9, R8
        ䷍ ABUNDANCE R10, R9
        ䷾ SYNC
        ䷗ RETURN R10
    }
}

@locus evolution.generation.evolve_loop {
    mut_rate   = 0.005
    cross_pool = "evolution_core"
